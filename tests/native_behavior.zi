GetEnvironment :: (name: *u8) -> *u8 #foreign libc "getenv";
FixtureEnvironment :: (name: string) -> string {
    key: [64]u8
    if !CopyCString(name, key[:]) { return "" }
    return TextFromCString(GetEnvironment(*key[0]))
}

stored: string = "legacy saved value";
node_stored: string;
effect_calls: s32;
