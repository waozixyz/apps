AllowImage :: (path: string) -> bool {
    return path == "" || AppHostAsset(AppHostActiveRuntime(ui_host).node, path).found
}

ResolveImage :: (path: string) -> string {
    return ifx path == "assets/preview.png" then "fixture/verified-parent/preview.png" else ""
}

Widgets :: (context: *void, node: *AppNode, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(function) == "ButtonHostedHost" && count == 2 && WidgetValidButtonProps(arguments[1]) {
        props := WidgetDecodeButtonProps(arguments[1], *button_codec)
        if props.icon_shape == "S3rr:M12 5H12.01M12 12H12.01M12 19H12.01" {
            menu_triggers += 1
            scale := AppHostActiveRuntime(ui_host).app.scale
            if !props.icon_only || props.bounds.width != 36.0 * scale || props.bounds.height != 36.0 * scale { invalid_trigger += 1 }
        }
    }
    return WidgetHostCall(context, module, function, arguments, count, result)
}

State :: (context: *void, account: string, identity: *AppIdentity, state: *AppState) -> bool {
    state.* = AppState.{.installed = true, .bytes = 12345, .actions_known = true,
        .actions = cast(u64)4092, .update_available = true, .history_count = 1}
    unused CopyCString("1.0", state.current_version[:])
    unused CopyCString("2.0", state.available_version[:])
    unused CopyCString("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", state.available_sha256[:])
    unused CopyCString("0.9", state.history[0].version[:])
    unused CopyCString("cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", state.history[0].sha256[:])
    return true
}

// Inspect actual opaque card fills; ellipsis buttons are Ghost and have no
// fill, so their precise props are checked in Widgets before native drawing.
CardPaintGeometry :: (scale: float32) -> bool {
    fills: s32
    for index: cast(s32)0..PendingPaintCount(ui_session) - 1 {
        paint := PendingPaintAt(ui_session, index)
        if paint.kind != PaintKindRoundedFill { continue }
        node := TreeSubmittedNodeAt(ui_session, paint.node)
        if node.kind == WidgetKindDropdown { return false }
        if node.kind != WidgetKindBox { continue }
        // The update dot on a card's options is not a card.
        if node.bounds.width == 8.0 * scale && node.bounds.height == 8.0 * scale { continue }
        if paint.color.a != cast(u8)255 || node.bounds.height != 232.0 * scale { return false }
        if fills == 0 { first_card_fill = paint.color }
        fills += 1
    }
    return fills > 0 && menu_triggers == fills && invalid_trigger == 0
}

Draw :: (host: *AppHost, width: s32, height: s32, require_preview: bool = true,
    dark: bool = false, scale: float32 = 1.0) -> bool {
    ui_host = host
    if ui_session.epoch == cast(u64)0 { ui_session = SessionOpen() }
    ui_frame += cast(u64)1
    bounds := Rectangle.{0.0, 0.0, cast(float32)width, cast(float32)height}
    BeginFrame(ui_session, cast(u64)1, bounds)
    runtime := AppHostActiveRuntime(host)
    runtime.app.session = ui_session
    runtime.app.bounds = bounds
    runtime.app.font = 18
    runtime.app.scale = scale
    runtime.app.dark = dark
    runtime.legacy.frame.session = ui_session
    runtime.legacy.frame.width = width
    runtime.legacy.frame.height = height
    // Host chrome and guest Back both use key 2; the runtime mount keeps
    // them in separate tree scopes.
    unused TreeSubmitCurrent(ui_session, cast(u64)2, 0, bounds)
    menu_triggers = 0; invalid_trigger = 0
    WidgetHostBegin(ui_session, AllowImage, ResolveImage)
    ran := AppHostRun(host, APP_FRAME)
    WidgetHostEnd()
    image: bool
    images: s32 = 0
    for index: cast(s32)0..PendingPaintCount(ui_session) - 1 {
        paint := PendingPaintAt(ui_session, index)
        if paint.asset_path == "fixture/verified-parent/preview.png" {
            image = true
            if images == 0 { preview_first = paint.bounds }
            if images == 1 { preview_second = paint.bounds }
            images += 1
        }
    }
    geometry := !require_preview || CardPaintGeometry(scale)
    ended := EndFrame(ui_session) == cast(FrameStatus)FrameOk
    AppHostCollect(host)
    return ran && ended && geometry && (image || !require_preview)
}

Allows :: (context: *void, node: *AppNode, function: string) -> bool {
    return function == "DocumentReadHost" || function == "DocumentWriteHost" ||
    function == "AppRecordHost" || function == "SaveAppRecordHost" ||
    (function == "AppSoundHost" && sound_enabled) || TextUntilNul(node.identity.id[:]) == "inbe.chess"
}

Call :: (context: *void, node: *AppNode, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    name := TextFromCString(function)
    if TextUntilNul(node.identity.id[:]) == "fixture.node" {
        if name == "AppRecordHost" && count == 1 {
            result.* = AppHostText(node_stored)
            return 1
        }
        // Sounds come only from the calling app's own verified assets.
        if name == "AppSoundHost" && count == 1 && AppHostAsset(node, AppArgumentText(arguments[0])).found {
            sound_calls += 1
            result.* = HostScalar("bool", 1)
            return 1
        }
        if name == "SaveAppRecordHost" && count == 2 && AppArgumentText(arguments[1]) == "node saved" {
            node_stored = "node saved"
            result.* = HostScalar("bool", 1)
            return 1
        }
        return 0
    }
    if TextUntilNul(node.identity.id[:]) != "fixture.counter" { return 0 }
    if name == "DocumentReadHost" && count == 1 {
        result.* = AppHostText(stored)
        return 1
    }
    if name == "DocumentWriteHost" && count == 2 {
        if AppArgumentText(arguments[0]) != "position" || AppArgumentText(arguments[1]) != "after" { return 0 }
        stored = "after"
        result.* = HostScalar("bool", 1)
        return 1
    }
    return 0
}

Save :: (context: *void, node: *AppNode) -> bool { return !flush_failed }
Effect :: (context: *void, account: string, locator: *AppLocator, operation: s32, reply: *AppsReply) -> bool {
    effect_calls += 1
    reply.status = APPS_APPLIED
    return account == "account-a"
}

HostVersionEffect :: (context: *void, account: string, locator: *AppLocator, request: *AppsRequest, reply: *AppsReply) -> bool {
    if ui_host.tree.busy || !ui_host.tree.draining || account != "account-a" ||
    TextUntilNul(locator.identity.id[:]) != "fixture.middle" || request.operation != APPS_UPDATE ||
    TextUntilNul(request.sha256[:]) != "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" { return false }
    host_version_calls += 1
    reply.status = APPS_APPLIED
    return true
}

// Every guest OPEN reaches here after its caller saved and the declared child
// verified; no guest VM is running and the caller is still the active page.
HostOpenEffect :: (context: *void, account: string, locator: *AppLocator, request: *AppsRequest, reply: *AppsReply) -> s32 {
    host_open_calls += 1
    active := AppHostActiveRuntime(ui_host)
    if ui_host.tree.busy || !ui_host.tree.draining || active == null || active.busy ||
    (active.frontend != null && active.frontend.busy) || account != "account-a" || request.operation != APPS_OPEN ||
    TextUntilNul(locator.identity.id[:]) != TextUntilNul(request.id[:]) || locator.chain.count < 2 ||
    TextUntilNul(locator.chain[0].sha256[:]) != FixtureEnvironment("APPS_FIXTURE_ROOT_SHA256") { host_open_bad = true }
    host_open_chain = locator.chain.count
    unused CopyCString(TextUntilNul(locator.chain[locator.chain.count - 1].sha256[:]), host_open_leaf[:])
    unused CopyCString("native-leaf", reply.receipt[:])
    return open_decision
}

native_controller: AppController;
native_catalog: string;
native_request: AppsRequest;
native_queued: s32;
native_applied: s32;
native_tiles: s32;
native_actions: s32;
native_dots: s32;
native_icons: s32;
native_bad: bool;
box_codec: WidgetBoxPropsCodec;
native_icon_mode: bool = true;
native_label_bounds: Rectangle;

NativeService :: (context: *void, text: string) -> string {
    request: AppsRequest
    if !AppsReadRequest(text, *request) { return "{}" }
    if request.operation == APPS_CATALOG { return native_catalog }
    if request.operation == APPS_STATUS { return "{\"v\":1,\"status\":\"applied\",\"request\":1}" }
    // The app's own icon comes first; reading choices changes nothing.
    if request.operation == APPS_ICONS {
        if TextUntilNul(request.id[:]) != "native.breathing" { native_bad = true }
        native_icons += 1
        return "{\"v\":1,\"icons\":[{\"id\":\"\",\"shape\":\"S2rr:M4 12H20\"},{\"id\":\"leaf\",\"shape\":\"S2rr:M12 3V21\"}]}"
    }
    // This is a native root catalog; it has no AppNode, slot, or fake tree.
    // Reentrant runs and disposal cannot invalidate the in-flight VM.
    if AppControllerRun(*native_controller, APP_FRAME) || AppControllerClose(*native_controller) { native_bad = true }
    native_request = request
    native_queued += 1
    return "{\"v\":1,\"status\":\"queued\",\"request\":1}"
}

NativeWidgets :: (context: *void, module: *u8, function: *u8, arguments: *HostValue,
    count: s32, result: *HostValue) -> s32 {
    if TextFromCString(function) == "ButtonHostedHost" && count == 2 && WidgetValidButtonProps(arguments[1]) {
        props := WidgetDecodeButtonProps(arguments[1], *button_codec)
        // The card itself; its own icon in Properties shares its title.
        if props.key == AppCardKey("native.breathing") {
            native_tiles += 1
            if native_icon_mode && (props.bounds.height != 88.0 || props.class_name != 501 || !props.selected ||
                cast(s32)props.tone != 1 || cast(s32)props.emphasis != 0 || cast(s32)props.icon_placement != 2 ||
                props.image.asset_path != "assets/preview.png") { native_bad = true }
        }
        if props.label == "App options" {
            native_actions += 1
            if props.bounds.height != 36.0 || !props.icon_only || props.class_name != 502 ||
            cast(s32)props.emphasis != 3 || props.icon_shape != "S3rr:M12 5H12.01M12 12H12.01M12 19H12.01" { native_bad = true }
        }
    }
    // An update not yet installed or seen is a small dot on the options.
    if TextFromCString(function) == "BoxHostedHost" && count == 2 && WidgetValidBoxProps(arguments[1]) {
        box := WidgetDecodeBoxProps(arguments[1], *box_codec)
        if box.bounds.width == 8.0 && box.bounds.height == 8.0 { native_dots += 1 }
    }
    return WidgetHostCall(context, module, function, arguments, count, result)
}

NativeImage :: (path: string) -> bool { return path == "" || path == "assets/preview.png" }

NativeLoadCatalog :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/%-catalog.json", FixtureEnvironment("APPS_FIXTURE_NATIVE_CATALOG_ROOT"), name)
    text, found := ReadEntireFile(TextView(VecSlice(path, 0, path.count)))
    VecFree(path)
    if !found { return false }
    AppFileFree(native_catalog)
    native_catalog = text
    return true
}

NativeDraw :: () -> bool {
    native_tiles = 0; native_actions = 0; native_dots = 0
    BeginFrame(ui_session, cast(u64)6, Rectangle.{0.0, 0.0, 480.0, 600.0})
    native_controller.app.session = ui_session
    native_controller.app.bounds = Rectangle.{0.0, 0.0, 480.0, 600.0}
    outer: bool
    if native_icon_mode {
        group := Scroll(ui_session, ScrollProps.{.key = cast(u64)99, .bounds = Rectangle.{0.0, 0.0, 480.0, 88.0}, .content_height = 200})
        if !group.opened { return false }
        outer = true
        native_controller.app.bounds = Rectangle.{group.content.x, group.content.y, group.content.width, 88.0}
    }
    native_controller.app.scale = 1.0
    native_controller.app.font = 18
    WidgetHostBegin(ui_session, NativeImage)
    ran := AppControllerRun(*native_controller, APP_FRAME)
    WidgetHostEnd()
    if outer { End(ui_session) }
    if EndFrame(ui_session) != cast(FrameStatus)FrameOk || native_bad { return false }
    return ran && native_tiles == 1 && native_actions == 2
}

NativeLabel :: (label: string, kind: s32 = -1) -> s32 {
    for index: cast(s32)0..TreeCount(ui_session) - 1 {
        node := TreeNodeAt(ui_session, index)
        if node.semantic_label == label && (kind < 0 || node.kind == kind) {
            native_label_bounds = node.bounds
            return index
        }
    }
    return -1
}

// An icon choice in Properties: a round button inside the dialog.
NativeIconButton :: (label: string) -> s32 {
    for index: cast(s32)0..TreeCount(ui_session) - 1 {
        node := TreeNodeAt(ui_session, index)
        if node.kind == WidgetKindButton && node.semantic_label == label && node.bounds.width == 40.0 { return index }
    }
    return -1
}

// The first menu entry in tree order.
NativeFirstSelectable :: () -> string {
    for index: cast(s32)0..TreeCount(ui_session) - 1 {
        node := TreeNodeAt(ui_session, index)
        if node.kind == WidgetKindSelectable { return node.semantic_label }
    }
    return ""
}

// The last menu entry in tree order.
NativeLastSelectable :: () -> string {
    last := ""
    for index: cast(s32)0..TreeCount(ui_session) - 1 {
        node := TreeNodeAt(ui_session, index)
        if node.kind == WidgetKindSelectable { last = node.semantic_label }
    }
    return last
}

NativeClick :: (label: string, kind: s32 = -1) -> bool {
    target := NativeLabel(label, kind)
    if target < 0 { return false }
    // Hit testing proves the real overlay/menu target receives the click.
    hit := TreeHitAt(ui_session, native_label_bounds.x + native_label_bounds.width * 0.5,
        native_label_bounds.y + native_label_bounds.height * 0.5)
    return hit == target && TreeActivateAt(ui_session, hit)
}

NativeControllerCheck :: () -> s32 {
    bytes, found := ReadEntireFile(FixtureEnvironment("APPS_FIXTURE_UI_BUNDLE"))
    if !found { return 50 }
    platform := AppControllerPlatform.{.service = NativeService, .widgets = NativeWidgets}
    if !NativeLoadCatalog("native") || !AppControllerOpen(*native_controller, bytes,
        FixtureEnvironment("APPS_FIXTURE_HARNESS_SHA256"), platform) { return 51 }
    // The options carry the update's dot instead of a separate update symbol.
    if !NativeDraw() || native_dots != 1 || native_queued != 0 || NativeLabel("Update available") >= 0 ||
    NativeLabel("Native apps") >= 0 || NativeLabel("12.3 kB") < 0 { return 52 }
    // Opening them shows Update first and marks exactly that offer as seen.
    if !NativeClick("App options") || !NativeDraw() || native_queued != 1 || native_request.operation != APPS_SEEN ||
    TextUntilNul(native_request.version[:]) != "2.0" ||
    TextUntilNul(native_request.sha256[:]) != "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ||
    NativeFirstSelectable() != "Update" { return 53 }
    // Once seen, the dot goes; Update stays in the menu until it is installed.
    if !NativeLoadCatalog("seen") || !NativeDraw() || native_dots != 0 || NativeLabel("Update", WidgetKindSelectable) < 0 { return 74 }
    if !NativeClick("Update", WidgetKindSelectable) || !NativeDraw() || native_queued != 1 ||
    NativeLabel("Update", WidgetKindButton) < 0 { return 75 }
    // A verified target changing while the confirmation is open disables its
    // old target; the modal cannot silently submit the newly offered bytes.
    if !NativeLoadCatalog("changed-update") || !NativeDraw() { return 54 }
    if NativeClick("Update", WidgetKindButton) { return 55 }
    if !NativeClick("Cancel", WidgetKindButton) || !NativeDraw() || native_queued != 1 { return 56 }
    if !NativeLoadCatalog("native") || !NativeDraw() || !NativeClick("App options") || !NativeDraw() ||
    !NativeClick("Update", WidgetKindSelectable) || !NativeDraw() ||
    !NativeClick("Update", WidgetKindButton) || !NativeDraw() || native_queued != 3 || native_applied != 0 ||
    native_request.operation != 10 || TextUntilNul(native_request.version[:]) != "2.0" ||
    TextUntilNul(native_request.sha256[:]) != "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" { return 57 }
    // Native account storage mutates only after Run returns.
    native_applied += 1
    if !NativeLoadCatalog("no-update") || !NativeDraw() || native_dots != 0 || NativeLabel("Updated") >= 0 { return 58 }
    if !NativeClick("App options") || !NativeDraw() || NativeLabel("Rollback", WidgetKindSelectable) < 0 ||
    NativeLastSelectable() != "Properties" || native_queued != 3 { return 59 }
    if !NativeClick("Rollback", WidgetKindSelectable) || !NativeDraw() || native_queued != 3 { return 60 }
    if !NativeClick("0.9", WidgetKindButton) || !NativeDraw() || !NativeDraw() || native_queued != 3 { return 61 }
    if !NativeClick("Rollback", WidgetKindButton) { return 620 }
    if !NativeDraw() { return 621 }
    if native_queued != 4 { return 622 }
    if native_request.operation != 11 { return 623 }
    if TextUntilNul(native_request.version[:]) != "0.9" { return 624 }
    if TextUntilNul(native_request.sha256[:]) != "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" { return 625 }
    // Properties renames the app and chooses one of the offered icons.
    if !NativeDraw() || !NativeClick("App options") || !NativeDraw() || !NativeClick("Properties", WidgetKindSelectable) ||
    !NativeDraw() || native_icons != 1 || native_queued != 4 || NativeLabel("Name", WidgetKindTextField) < 0 ||
    NativeIconButton("Breathing") < 0 || NativeIconButton("leaf") < 0 { return 76 }
    leaf := NativeIconButton("leaf")
    if leaf < 0 || !TreeActivateAt(ui_session, leaf) || !NativeDraw() { return 77 }
    field := NativeLabel("Name", WidgetKindTextField)
    if field < 0 || !TreeFocusAt(ui_session, field) || !NativeDraw() || !NativeDraw() { return 78 }
    native_controller.app.input = TextFieldInput.{.select_all = true}
    if !NativeDraw() { return 79 }
    native_controller.app.input = TextFieldInput.{.text = "Calm"}
    if !NativeDraw() { return 80 }
    native_controller.app.input = TextFieldInput.{}
    if !NativeDraw() || !NativeClick("Save", WidgetKindButton) || !NativeDraw() || native_queued != 5 ||
    native_request.operation != APPS_PROPERTIES || TextUntilNul(native_request.id[:]) != "native.breathing" ||
    TextUntilNul(native_request.title[:]) != "Calm" || TextUntilNul(native_request.icon[:]) != "leaf" ||
    !NativeDraw() || NativeLabel("Save", WidgetKindButton) >= 0 { return 81 }
    // Cancel keeps the app's properties; its own title and icon save as empty.
    if !NativeClick("App options") || !NativeDraw() || !NativeClick("Properties", WidgetKindSelectable) || !NativeDraw() ||
    !NativeClick("Cancel", WidgetKindButton) || !NativeDraw() || !NativeDraw() || native_queued != 5 ||
    NativeLabel("Save", WidgetKindButton) >= 0 { return 82 }
    if !NativeClick("App options") || !NativeDraw() || !NativeClick("Properties", WidgetKindSelectable) || !NativeDraw() ||
    !NativeClick("Save", WidgetKindButton) || !NativeDraw() || native_queued != 6 ||
    native_request.operation != APPS_PROPERTIES || TextUntilNul(native_request.title[:]) != "" ||
    TextUntilNul(native_request.icon[:]) != "" { return 83 }
    if !NativeDraw() || !NativeClick("Breathing", WidgetKindButton) || !NativeDraw() || native_request.operation != APPS_OPEN { return 63 }
    native_icon_mode = false
    if !NativeLoadCatalog("preview") || !NativeDraw() || NativeLabel("Native apps") < 0 { return 64 }
    if !AppControllerClose(*native_controller) { return 65 }
    AppFileFree(bytes); AppFileFree(native_catalog); native_catalog = ""
    return 0
}

Command :: (host: *AppHost, command: string) -> bool {
    node := AppTreeNode(*host.tree, host.tree.active)
    runtime := cast(*AppRuntime)node.runtime
    runtime.app.command = command
    return AppHostRun(host, APP_COMMAND)
}

#program_export
Check :: () -> s32 {
    bytes, found := ReadEntireFile(FixtureEnvironment("APPS_FIXTURE_ROOT_BUNDLE"))
    digest := FixtureEnvironment("APPS_FIXTURE_ROOT_SHA256")
    harness_digest := FixtureEnvironment("APPS_FIXTURE_HARNESS_SHA256")
    if !found { return 1 }
    host: AppHost
    platform := AppPlatform.{.allows = Allows, .call = Call, .widgets = Widgets, .save = Save, .effect = Effect, .state = State, .version_effect = HostVersionEffect,
        .open_effect = HostOpenEffect}
    if !AppHostStart(*host, bytes, "fixture.test", "fixture.root", "collection", digest, "account-a", platform, harness_digest) { return 2 }
    root := AppTreeNode(*host.tree, host.tree.active)
    runtime := cast(*AppRuntime)root.runtime
    if runtime.controller || runtime.frontend == null || !runtime.frontend.controller { return 15 }
    if !Draw(*host, 800, 600) || !Draw(*host, 360, 640) { return 28 }
    languages: [12]string = .["cs", "de", "en", "es", "fr", "id", "it", "ja", "ko", "pt", "ru", "zh"]
    for language: languages {
        unused CopyCString(language, host.locale[:])
        if !Draw(*host, 360, 640) { return 29 }
    }
    unused CopyCString("en", host.locale[:])
    catalog_reply := AppHostCatalog(runtime.frontend)
    catalog_text := AppArgumentText(catalog_reply)
    children := FieldAt(catalog_text, 0, "children")
    first := Space(catalog_text, children + 1)
    if !MatchLiteral(catalog_text, Space(catalog_text, FieldAt(catalog_text, first, "update_available")), "true") ||
    ReadNumber(catalog_text, FieldAt(catalog_text, first, "bytes")).value != 12345.0 { return 66 }
    active_root := host.tree.active
    if !Command(*host, "{\"v\":1,\"op\":\"update\",\"id\":\"fixture.middle\",\"version\":\"2.0\",\"sha256\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}") ||
    host_version_calls != 1 || !AppHandleEqual(host.tree.active, active_root) { return 67 }
    AppHostCollect(*host)

    if !Command(*host, "{\"v\":1,\"op\":\"open\",\"id\":\"fixture.middle\"}") || host.tree.nodes.count != 2 { return 3 }
    middle := AppTreeNode(*host.tree, host.tree.active)
    if TextUntilNul(middle.identity.id[:]) != "fixture.middle" { return 4 }
    runtime = cast(*AppRuntime)middle.runtime
    if !Draw(*host, 480, 600) || preview_second.x <= preview_first.x || preview_second.y != preview_first.y { return 30 }
    light := first_card_fill
    if !Draw(*host, 480, 600, true, true) { return 36 }
    dark := first_card_fill
    if cast(s32)dark.r + cast(s32)dark.g + cast(s32)dark.b >=
    cast(s32)light.r + cast(s32)light.g + cast(s32)light.b { return 37 }
    if !Draw(*host, 720, 900, true, false, 1.5) { return 38 }
    if !Draw(*host, 360, 640) || preview_second.y <= preview_first.y { return 35 }
    limit := host.tree.byte_limit
    resource := AppHostAsset(middle, "assets/node.zib")
    host.tree.byte_limit = host.tree.bytes + resource.data.count + 65536 + cast(s64)size_of(AppNode)
    if !Command(*host, "{\"v\":1,\"op\":\"install\",\"id\":\"fixture.node\"}") || effect_calls != 1 || host.retired_bytes <= 0 { return 32 }
    if !Command(*host, "{\"v\":1,\"op\":\"install\",\"id\":\"fixture.node\"}") || effect_calls != 1 { return 33 }
    host.tree.byte_limit = limit
    AppHostCollect(*host)
    if host.retired_bytes != 0 { return 34 }
    node_entry := AppCatalogAt(*middle.catalog, AppCatalogFind(*middle.catalog, "fixture.node")).*
    unused CopyCString("other", node_entry.expected_id[:])
    rejected := AppTreeOpenChild(*host.tree, host.tree.active, *node_entry)
    if AppTreeNode(*host.tree, rejected) != null || AppHostActiveRuntime(*host) != runtime { return 31 }
    // Native OPEN boundary over real bundles: the counter's exact verified
    // chain reaches the provider; HANDLED and REJECTED keep the middle page
    // and retire only the temporary counter VM.
    counter_entry := AppCatalogAt(*middle.catalog, AppCatalogFind(*middle.catalog, "fixture.counter"))
    outcomes: [2]s32 = .[APP_OPEN_HANDLED, APP_OPEN_REJECTED]
    for outcome: outcomes {
        open_decision = outcome
        calls := host_open_calls
        if !Command(*host, "{\"v\":1,\"op\":\"open\",\"id\":\"fixture.counter\"}") || host.tree.nodes.count != 2 ||
        AppHostActiveRuntime(*host) != runtime || host.retired_bytes <= 0 || host_open_calls != calls + 1 ||
        host_open_bad || host_open_chain != 3 || TextUntilNul(host_open_leaf[:]) != TextUntilNul(counter_entry.sha256[:]) { return 68 }
        status := AppTreeQueue(*host.tree, host.tree.active, AppsRequest.{.operation = APPS_STATUS, .request = host.tree.sequence})
        expected := ifx outcome == APP_OPEN_HANDLED then APPS_QUEUED else APPS_REJECTED
        if status.status != expected || (outcome == APP_OPEN_HANDLED && TextUntilNul(status.receipt[:]) != "native-leaf") { return 69 }
        AppHostCollect(*host)
        if host.retired_bytes != 0 || !Draw(*host, 480, 600) { return 70 }
    }
    // A failed save or a declared digest mismatch never reaches the provider
    // and opens no temporary child.
    open_decision = APP_OPEN_HANDLED
    calls := host_open_calls
    flush_failed = true
    unused Command(*host, "{\"v\":1,\"op\":\"open\",\"id\":\"fixture.counter\"}")
    flush_failed = false
    if host_open_calls != calls || host.tree.nodes.count != 2 || host.retired_bytes != 0 || AppHostActiveRuntime(*host) != runtime { return 71 }
    digest_first := counter_entry.sha256[0]
    counter_entry.sha256[0] = ifx digest_first == #char "0" then #char "1" else #char "0"
    unused Command(*host, "{\"v\":1,\"op\":\"open\",\"id\":\"fixture.counter\"}")
    counter_entry.sha256[0] = digest_first
    if host_open_calls != calls || host.tree.nodes.count != 2 || host.retired_bytes != 0 || AppHostActiveRuntime(*host) != runtime { return 72 }
    // DECLARED, the default, opens the verified counter exactly as before.
    open_decision = APP_OPEN_DECLARED
    if !Command(*host, "{\"v\":1,\"op\":\"open\",\"id\":\"fixture.counter\"}") || host.tree.nodes.count != 3 ||
    host_open_calls != calls + 1 || host_open_bad { return 5 }
    child := host.tree.active
    if !Command(*host, "read") || host.last_reply != "legacy saved value" { return 6 }
    if !Command(*host, "write") || stored != "after" { return 7 }
    locator: AppLocator
    if !AppTreeLocate(*host.tree, host.tree.active, *locator) || locator.chain.count != 3 { return 8 }
    flush_failed = true
    unused AppTreeQueue(*host.tree, host.tree.active, AppsRequest.{.operation = APPS_BACK}); unused AppTreeDrain(*host.tree)
    if !AppHandleEqual(host.tree.active, child) { return 9 }
    flush_failed = false
    unused AppTreeQueue(*host.tree, host.tree.active, AppsRequest.{.operation = APPS_BACK}); unused AppTreeDrain(*host.tree)
    returned := AppTreeNode(*host.tree, host.tree.active)
    if TextUntilNul(returned.identity.id[:]) != "fixture.middle" { return 10 }
    // A direct favorite reopens the same verified leaf bytes and save owner.
    if !AppTreeOpenLocator(*host.tree, *locator) || !Command(*host, "read") ||
    host.last_reply != "after" { return 11 }
    // Corrupt revision and wrong expected handshake leave the working leaf.
    active := host.tree.active
    locator.chain[2].sha256[0] = ifx locator.chain[2].sha256[0] == #char "0" then #char "1" else #char "0"
    if AppTreeOpenLocator(*host.tree, *locator) || !AppHandleEqual(host.tree.active, active) { return 12 }
    AppLocatorClear(*locator)
    if AppHostBack(*host) != 1 { return 16 }
    if !Command(*host, "{\"v\":1,\"op\":\"open\",\"id\":\"fixture.node\"}") { return 17 }
    runtime = AppHostActiveRuntime(*host)
    if runtime.protocol != APPS_NODE_PROTOCOL { return 18 }
    runtime.legacy.frame.width = 1
    runtime.app.key = 42
    if !Draw(*host, 1, 600, false) || node_stored != "node saved" ||
    runtime.legacy.message.name != "node" || runtime.legacy.message.account != "" { return 19 }
    if sound_calls != 1 { return 73 }
    sound_enabled = false
    runtime.legacy.frame.width = 2
    if !Draw(*host, 2, 600, false) || sound_calls != 1 { return 20 }
    active = host.tree.active
    runtime.legacy.message.screen = 42
    if AppHostBack(*host) != 1 || !AppHandleEqual(host.tree.active, active) { return 21 }
    runtime.legacy.message.screen = 0
    flush_failed = true
    if AppHostBack(*host) != -1 || !AppHandleEqual(host.tree.active, active) { return 22 }
    flush_failed = false
    if AppHostBack(*host) != 1 || AppHandleEqual(host.tree.active, active) { return 23 }
    chess_digest := FixtureEnvironment("APPS_FIXTURE_CHESS_SHA256")
    if chess_digest != "" {
        if !Command(*host, "{\"v\":1,\"op\":\"open\",\"id\":\"inbe.chess\"}") { return 24 }
        runtime = AppHostActiveRuntime(*host)
        if runtime.protocol != APPS_NODE_PROTOCOL || TextUntilNul(runtime.node.entry.sha256[:]) != chess_digest { return 25 }
        if !AppHostRoute(*host) { return 26 }
        if AppHostBack(*host) != 1 { return 27 }
    }
    AppHostCollect(*host)
    if !AppHostStop(*host) { return 13 }
    if AppHostStart(*host, bytes, "fixture.test", "fixture.root", "wrong", digest, "account-a", platform, harness_digest) { return 14 }
    return NativeControllerCheck()
}
