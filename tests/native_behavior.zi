#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    return cast(s32)value.count * font / 2
}
#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 { return font }
#program_export
ImageWidth :: (path: string) -> s32 { return 1 }
#program_export
ImageHeight :: (path: string) -> s32 { return 1 }
#program_export
SystemClipboardOpenHost :: () -> s32 { return -1 }
#program_export
SystemClipboardByteHost :: (index: s32) -> s32 { return -1 }
#program_export
SystemClipboardWriteHost :: (text: string) -> bool { return false }

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32, segments: s32, color: Color) {}
#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32, segments: s32, width: float32, color: Color) {}
