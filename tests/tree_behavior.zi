#import "std/vec"
#import "std/c_string"
#import "std/text_buffer"
#import, file "../src/protocol.zi";
#import, file "../src/catalog.zi";
#import, file "../src/tree.zi";

DIGEST :: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
ROOT_DIGEST :: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
fail_save: bool;
fail_open: bool;
fail_effect: bool;
installed: bool;
pinned: bool;
records: s32 = 41;
closed: s32;
depth: s32;
version_calls: s32;
version_seen: AppsRequest;
saves: s32;
open_tree: *AppTree;
open_decision: s32 = APP_OPEN_DECLARED;
open_calls: s32;
open_saves: s32;
open_reentered: bool;
open_seen: AppsRequest;
open_copy: AppLocator;

MakeCatalog :: (node: *AppNode, id: string, child: string, protocol: string = "app/1") -> bool {
    bytes: Vec(u8)
    BuilderPrint(*bytes, "{\"schema\":1,\"id\":\"%\",\"title\":\"Collection\",\"harness\":\"assets/apps/apps.zib\",\"children\":[", id)
    if child != "" {
        BuilderPrint(*bytes, "{\"id\":\"%\",\"title\":\"Child\",\"bundle\":\"assets/child.zib\",\"preview\":\"assets/previews/child.png\",\"protocol\":\"%\",\"expected_id\":\"child\",\"version\":\"1\",\"sha256\":\"%\"}", child, protocol, DIGEST)
    }
    BuilderPrint(*bytes, "]}")
    result := AppCatalogRead(TextView(VecSlice(bytes, 0, bytes.count)), id, *node.catalog)
    VecFree(bytes)
    node.collection = true
    return result
}

Open :: (context: *void, parent: *AppNode, entry: *AppEntry, candidate: *AppNode) -> bool {
    if fail_open { return false }
    candidate.identity.authority = parent.identity.authority
    candidate.identity.id = entry.id
    candidate.entry = entry.*
    candidate.runtime = cast(*void)1
    candidate.bytes = 1024
    if entry.protocol == APPS_COLLECTION_PROTOCOL {
        bytes: Vec(u8)
        depth += 1
        BuilderPrint(*bytes, "collection.%", depth + 1)
        result := MakeCatalog(candidate, TextUntilNul(entry.id[:]), TextView(VecSlice(bytes, 0, bytes.count)), "collection/1")
        VecFree(bytes)
        return result
    }
    return true
}

Save :: (context: *void, node: *AppNode) -> bool {
    if fail_save { return false }
    saves += 1
    return true
}
Close :: (context: *void, node: *AppNode) { closed += 1; node.runtime = null }

Effect :: (context: *void, account: string, locator: *AppLocator, operation: s32, reply: *AppsReply) -> bool {
    if fail_effect || account != "account-a" || TextUntilNul(locator.identity.authority[:]) != "example.test" { return false }
    if operation == APPS_INSTALL { installed = true }
    if operation == APPS_UNINSTALL { installed = false }
    if operation == APPS_PIN { pinned = true }
    if operation == APPS_UNPIN { pinned = false }
    reply.status = APPS_APPLIED
    if operation == APPS_INSTALL_TO_LAUNCHER {
        reply.status = APPS_QUEUED
        unused CopyCString("android-prompt-1", reply.receipt[:])
    }
    return true
}

VersionEffect :: (context: *void, account: string, locator: *AppLocator, request: *AppsRequest, reply: *AppsReply) -> bool {
    version_calls += 1
    version_seen = request.*
    if account != "account-a" || TextUntilNul(locator.identity.id[:]) != "inbe.chess" ||
    TextUntilNul(locator.identity.authority[:]) != "example.test" ||
    TextUntilNul(request.version[:]) != "2.0" || TextUntilNul(request.sha256[:]) != DIGEST { return false }
    reply.status = APPS_APPLIED
    return true
}

// A native consumer copies the verified target; it stages its own root only
// after the drain, so neither a guest run nor a locator open may reenter.
OpenEffect :: (context: *void, account: string, locator: *AppLocator, request: *AppsRequest, reply: *AppsReply) -> s32 {
    open_calls += 1
    open_saves = saves
    open_seen = request.*
    if !open_tree.draining || open_tree.busy || AppTreeBegin(open_tree, open_tree.active) ||
    AppTreeOpenLocator(open_tree, locator) || account != "account-a" ||
    reply.status != APPS_QUEUED || reply.request < 1 { open_reentered = true }
    AppLocatorClear(*open_copy)
    open_copy.identity = locator.identity
    for index: cast(s64)0..locator.chain.count - 1 { unused VecPush(open_copy.chain, locator.chain[index]) }
    unused CopyCString("leaf-stage-1", reply.receipt[:])
    // The tree, not the provider, decides the reply status for each decision.
    reply.status = APPS_APPLIED
    return open_decision
}

OpenEffectCheck :: (provider: AppProvider) -> s32 {
    tree: AppTree
    open_tree = *tree
    provider.open_effect = OpenEffect
    if !AppTreeStart(*tree, Root(), "account-a", provider) { return 50 }
    original := tree.active
    // Default: after exactly the caller's save, the verified child opens.
    saves = 0
    unused AppTreeQueue(*tree, original, Request(APPS_OPEN, "inbe.chess")); unused AppTreeDrain(*tree)
    if open_calls != 1 || open_saves != 1 || open_reentered || AppHandleEqual(tree.active, original) ||
    tree.nodes.count != 2 || open_seen.operation != APPS_OPEN || TextUntilNul(open_seen.id[:]) != "inbe.chess" { return 51 }
    if open_copy.chain.count != 2 || TextUntilNul(open_copy.identity.id[:]) != "inbe.chess" ||
    TextUntilNul(open_copy.identity.authority[:]) != "example.test" ||
    TextUntilNul(open_copy.chain[0].id[:]) != "arcade" || TextUntilNul(open_copy.chain[0].sha256[:]) != ROOT_DIGEST ||
    TextUntilNul(open_copy.chain[1].id[:]) != "inbe.chess" || TextUntilNul(open_copy.chain[1].sha256[:]) != DIGEST { return 52 }
    unused AppTreeQueue(*tree, tree.active, Request(APPS_BACK)); unused AppTreeDrain(*tree)
    if !AppHandleEqual(tree.active, original) || tree.nodes.count != 1 { return 53 }
    // Handled: the parent stays active, only the temporary child closes, and
    // the copied target outlives the drain for native staging.
    open_decision = APP_OPEN_HANDLED
    closed_before := closed
    reply := AppTreeQueue(*tree, original, Request(APPS_OPEN, "inbe.chess")); unused AppTreeDrain(*tree)
    status := AppTreeQueue(*tree, original, AppsRequest.{.operation = APPS_STATUS, .request = reply.request})
    if open_calls != 2 || open_reentered || !AppHandleEqual(tree.active, original) || tree.nodes.count != 1 ||
    closed != closed_before + 1 || AppTreeNode(*tree, original).runtime == null ||
    status.status != APPS_QUEUED || TextUntilNul(status.receipt[:]) != "leaf-stage-1" ||
    open_copy.chain.count != 2 || TextUntilNul(open_copy.chain[1].sha256[:]) != DIGEST { return 54 }
    decisions: [2]s32 = .[APP_OPEN_REJECTED, 7]
    for decision: decisions {
        open_decision = decision
        closed_before = closed
        calls := open_calls
        reply = AppTreeQueue(*tree, original, Request(APPS_OPEN, "inbe.chess")); unused AppTreeDrain(*tree)
        status = AppTreeQueue(*tree, original, AppsRequest.{.operation = APPS_STATUS, .request = reply.request})
        if open_calls != calls + 1 || !AppHandleEqual(tree.active, original) || tree.nodes.count != 1 ||
        closed != closed_before + 1 || status.status != APPS_REJECTED || TextUntilNul(status.receipt[:]) != "" { return 55 }
    }
    // A failed caller save, failed child verification or stale account never
    // reaches the provider, and the working page stays active.
    open_decision = APP_OPEN_HANDLED
    calls := open_calls
    fail_save = true
    reply = AppTreeQueue(*tree, original, Request(APPS_OPEN, "inbe.chess")); unused AppTreeDrain(*tree)
    fail_save = false
    status = AppTreeQueue(*tree, original, AppsRequest.{.operation = APPS_STATUS, .request = reply.request})
    if open_calls != calls || status.status != APPS_REJECTED || !AppHandleEqual(tree.active, original) || tree.nodes.count != 1 { return 56 }
    fail_open = true
    reply = AppTreeQueue(*tree, original, Request(APPS_OPEN, "inbe.chess")); unused AppTreeDrain(*tree)
    fail_open = false
    status = AppTreeQueue(*tree, original, AppsRequest.{.operation = APPS_STATUS, .request = reply.request})
    if open_calls != calls || status.status != APPS_REJECTED || !AppHandleEqual(tree.active, original) || tree.nodes.count != 1 { return 57 }
    unused AppTreeQueue(*tree, original, Request(APPS_OPEN, "inbe.chess"))
    tree.account_epoch += 1
    unused AppTreeDrain(*tree)
    if open_calls != calls || tree.pending[tree.pending.count - 1].reply.status != APPS_REJECTED ||
    !AppHandleEqual(tree.active, original) || tree.nodes.count != 1 { return 58 }
    AppLocatorClear(*open_copy)
    if !AppTreeClose(*tree) { return 59 }
    return 0
}

Root :: (child: string = "inbe.chess", protocol: string = "app/1") -> *AppNode {
    node := New(AppNode)
    if node == null { return null }
    unused CopyCString("example.test", node.identity.authority[:])
    unused CopyCString("arcade", node.identity.id[:])
    unused CopyCString(ROOT_DIGEST, node.entry.sha256[:])
    node.runtime = cast(*void)1
    node.bytes = 1024
    if !MakeCatalog(node, "arcade", child, protocol) { free(node); return null }
    return node
}

Request :: (operation: s32, id: string = "") -> AppsRequest {
    request := AppsRequest.{.operation = operation}
    unused CopyCString(id, request.id[:])
    return request
}

#program_export
Check :: () -> s32 {
    request: AppsRequest
    if !AppsReadRequest("{\"v\":1,\"op\":\"open\",\"id\":\"inbe.chess\"}", *request) || request.operation != APPS_OPEN { return 1 }
    if AppsReadRequest("{\"v\":1,\"op\":\"open\",\"id\":\"inbe.chess\",\"owner\":\"other\"}", *request) ||
    AppsReadRequest("{\"v\":1,\"v\":2,\"op\":\"back\"}", *request) ||
    AppsReadRequest("{\"v\":2,\"op\":\"back\"}", *request) ||
    AppsReadRequest("{\"v\":1,\"op\":\"open\",\"id\":\"../other\"}", *request) { return 2 }
    // A catalog request may name the revision the app already holds; no other request may.
    if !AppsReadRequest("{\"v\":1,\"op\":\"catalog\",\"revision\":7}", *request) ||
    request.operation != APPS_CATALOG || request.revision != 7 { return 32 }
    if !AppsReadRequest("{\"v\":1,\"op\":\"catalog\"}", *request) || request.revision != 0 { return 33 }
    if AppsReadRequest("{\"v\":1,\"op\":\"catalog\",\"revision\":0}", *request) ||
    AppsReadRequest("{\"v\":1,\"op\":\"catalog\",\"revision\":1.5}", *request) ||
    AppsReadRequest("{\"v\":1,\"op\":\"catalog\",\"revision\":\"7\"}", *request) ||
    AppsReadRequest("{\"v\":1,\"op\":\"open\",\"id\":\"inbe.chess\",\"revision\":7}", *request) { return 34 }
    if !AppBundlePathValid("assets/games/chess.zib") || AppBundlePathValid("assets/../other.zib") ||
    AppBundlePathValid("/assets/child.zib") || AppBundlePathValid("assets/%2e%2e/child.zib") ||
    AppBundlePathValid("assets//child.zib") { return 3 }
    if !AppPreviewPathValid("assets/previews/chess.png") || !AppPreviewPathValid("assets/card.webp") ||
    AppPreviewPathValid("https://example.test/chess.png") || AppPreviewPathValid("assets/../chess.png") ||
    AppPreviewPathValid("assets/%2e%2e/chess.jpg") || AppPreviewPathValid("assets//chess.jpeg") ||
    AppPreviewPathValid("assets/chess.zib") || AppAssetPathValid("assets/..") { return 30 }
    if !AppsReadRequest("{\"v\":1,\"op\":\"update\",\"id\":\"inbe.chess\",\"version\":\"2.0\",\"sha256\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}", *request) || request.operation != 10 { return 40 }
    if AppsReadRequest("{\"v\":1,\"op\":\"rollback\",\"id\":\"inbe.chess\",\"version\":\"2.0\"}", *request) ||
    AppsReadRequest("{\"v\":1,\"op\":\"open\",\"id\":\"inbe.chess\",\"version\":\"2.0\"}", *request) ||
    AppsReadRequest("{\"v\":1,\"op\":\"update\",\"id\":\"inbe.chess\",\"version\":\"2.0\",\"sha256\":\"bad\"}", *request) { return 41 }
    provider := AppProvider.{.open = Open, .save = Save, .close = Close, .effect = Effect}
    tree: AppTree
    root := Root()
    first := AppCatalogAt(*root.catalog, 0)
    if TextUntilNul(first.preview[:]) != "assets/previews/child.png" { return 31 }
    if !AppTreeStart(*tree, root, "account-a", provider) { return 4 }
    original := tree.active
    update := Request(APPS_UPDATE, "inbe.chess")
    unused CopyCString("2.0", update.version[:]); unused CopyCString(DIGEST, update.sha256[:])
    if AppTreeQueue(*tree, original, update).status != APPS_REJECTED { return 42 }
    tree.provider.version_effect = VersionEffect
    if !AppTreeBegin(*tree, original) { return 43 }
    version_reply := AppTreeQueue(*tree, original, update)
    update.version[0] = #char "9"
    if version_reply.status != APPS_QUEUED || AppTreeDrain(*tree) || version_calls != 0 { return 44 }
    if !AppTreeEnd(*tree, original) || !AppTreeDrain(*tree) || version_calls != 1 ||
    TextUntilNul(version_seen.version[:]) != "2.0" || !AppHandleEqual(tree.active, original) || tree.nodes.count != 1 { return 45 }
    checked := AppTreeQueue(*tree, original, AppsRequest.{.operation = APPS_STATUS, .request = version_reply.request})
    if checked.status != APPS_APPLIED { return 46 }
    update = version_seen; update.operation = APPS_ROLLBACK
    fail_save = true
    unused AppTreeQueue(*tree, original, update); unused AppTreeDrain(*tree)
    if version_calls != 1 || !AppHandleEqual(tree.active, original) { return 47 }
    fail_save = false
    update.sha256[0] = #char "0"
    version_reply = AppTreeQueue(*tree, original, update); unused AppTreeDrain(*tree)
    checked = AppTreeQueue(*tree, original, AppsRequest.{.operation = APPS_STATUS, .request = version_reply.request})
    if checked.status != APPS_REJECTED || version_calls != 2 || !AppHandleEqual(tree.active, original) { return 48 }
    update = version_seen; unused CopyCString(DIGEST, update.sha256[:])
    version_reply = AppTreeQueue(*tree, original, update)
    tree.account_epoch += 1
    unused AppTreeDrain(*tree)
    if version_calls != 2 { return 49 }

    if AppTreeQueue(*tree, original, Request(APPS_OPEN, "missing")).status != APPS_REJECTED { return 5 }
    if !AppTreeBegin(*tree, original) || AppTreeBegin(*tree, original) { return 6 }
    reply := AppTreeQueue(*tree, original, Request(APPS_OPEN, "inbe.chess"))
    if reply.status != APPS_QUEUED || AppTreeDrain(*tree) || !AppHandleEqual(tree.active, original) { return 7 }
    if !AppTreeEnd(*tree, original) || !AppTreeDrain(*tree) { return 8 }
    child := tree.active
    if AppHandleEqual(child, original) || tree.nodes.count != 2 { return 9 }
    locator: AppLocator
    if !AppTreeLocate(*tree, child, *locator) || locator.chain.count != 2 || TextUntilNul(locator.identity.id[:]) != "inbe.chess" { return 10 }
    fail_save = true
    unused AppTreeQueue(*tree, child, Request(APPS_BACK)); unused AppTreeDrain(*tree)
    if !AppHandleEqual(tree.active, child) { return 11 }
    fail_save = false
    unused AppTreeQueue(*tree, child, Request(APPS_BACK)); unused AppTreeDrain(*tree)
    if !AppHandleEqual(tree.active, original) || AppTreeNode(*tree, child) != null { return 12 }
    fail_open = true
    unused AppTreeQueue(*tree, original, Request(APPS_OPEN, "inbe.chess")); unused AppTreeDrain(*tree)
    if !AppHandleEqual(tree.active, original) || tree.nodes.count != 1 { return 13 }
    fail_open = false
    // Both installed records and favorites survive failed writes. Uninstall
    // and reinstall preserve the provider's saved Chess record value.
    unused AppTreeQueue(*tree, original, Request(APPS_INSTALL, "inbe.chess")); unused AppTreeDrain(*tree)
    unused AppTreeQueue(*tree, original, Request(APPS_PIN, "inbe.chess")); unused AppTreeDrain(*tree)
    if !installed || !pinned || tree.nodes.count != 1 { return 14 }
    fail_effect = true
    unused AppTreeQueue(*tree, original, Request(APPS_UNINSTALL, "inbe.chess")); unused AppTreeDrain(*tree)
    if !installed || !pinned { return 15 }
    fail_effect = false
    unused AppTreeQueue(*tree, original, Request(APPS_UNPIN, "inbe.chess")); unused AppTreeDrain(*tree)
    unused AppTreeQueue(*tree, original, Request(APPS_UNINSTALL, "inbe.chess")); unused AppTreeDrain(*tree)
    unused AppTreeQueue(*tree, original, Request(APPS_INSTALL, "inbe.chess")); unused AppTreeDrain(*tree)
    if !installed || pinned || records != 41 { return 16 }
    reply = AppTreeQueue(*tree, original, Request(APPS_INSTALL_TO_LAUNCHER, "inbe.chess")); unused AppTreeDrain(*tree)
    status := AppTreeQueue(*tree, original, AppsRequest.{.operation = APPS_STATUS, .request = reply.request})
    if status.status != APPS_QUEUED || TextUntilNul(status.receipt[:]) != "android-prompt-1" { return 17 }
    if !AppTreeOpenLocator(*tree, *locator) || AppTreeNode(*tree, child) != null { return 18 }
    active := tree.active
    locator.chain[1].sha256[0] = #char "0"
    if AppTreeOpenLocator(*tree, *locator) || !AppHandleEqual(tree.active, active) { return 19 }
    AppLocatorClear(*locator)
    // Status history is bounded and reusable, not a lifetime click limit.
    unused AppTreeQueue(*tree, tree.active, Request(APPS_BACK)); unused AppTreeDrain(*tree)
    for index: cast(s32)0..299 {
        unused AppTreeQueue(*tree, tree.active, Request(APPS_PIN, "inbe.chess")); unused AppTreeDrain(*tree)
    }
    if tree.pending.count > tree.pending_limit || tree.nodes.count != 1 { return 20 }
    if !AppTreeClose(*tree) { return 21 }
    // Dynamic routes go beyond both the widget scope and Session capacities.
    root = Root("collection.1", "collection/1")
    if !AppTreeStart(*tree, root, "account-a", provider) { return 22 }
    for index: cast(s32)1..80 {
        node := AppTreeNode(*tree, tree.active)
        entry := AppCatalogAt(*node.catalog, 0).*
        unused AppTreeQueue(*tree, tree.active, Request(APPS_OPEN, TextUntilNul(entry.id[:])))
        unused AppTreeDrain(*tree)
        if tree.nodes.count != index + 1 { return 23 }
    }
    if !AppTreeLocate(*tree, tree.active, *locator) || locator.chain.count != 81 { return 24 }
    AppLocatorClear(*locator)
    for index: cast(s32)1..80 {
        unused AppTreeQueue(*tree, tree.active, Request(APPS_BACK)); unused AppTreeDrain(*tree)
    }
    if tree.nodes.count != 1 || !AppHandleEqual(tree.active, AppHandle.{0, 1}) { return 25 }
    // A descendant's declared root identity is rejected as an ancestor cycle.
    root = AppTreeNode(*tree, tree.active)
    if !MakeCatalog(root, "arcade", "collection.1", "collection/1") { return 26 }
    unused AppTreeQueue(*tree, tree.active, Request(APPS_OPEN, "collection.1")); unused AppTreeDrain(*tree)
    node := AppTreeNode(*tree, tree.active)
    if !MakeCatalog(node, "collection.1", "arcade", "collection/1") { return 27 }
    before := tree.active
    unused AppTreeQueue(*tree, before, Request(APPS_OPEN, "arcade")); unused AppTreeDrain(*tree)
    if !AppHandleEqual(tree.active, before) || tree.nodes.count != 2 { return 28 }
    if !AppTreeClose(*tree) { return 29 }
    return OpenEffectCheck(provider)
}
