// Recording test provider. Native Apps still uses Kryon's actual typed codec.
#import "notification"
expected_tag: string;
daily: s32;
dated: s32;
queued: s32;
cancelled: s32;
opened: s32;
failures: s32;
DailyNotificationsSupported :: () -> bool { return true }
ScheduleDailyNotification :: (props: NotificationProps, hour: s32, minute: s32 = 0,
    suppress_on_open: bool = false, not_before_unix_ms: s64 = 0, weekdays: u32 = 127,
    skip_local_date: s32 = 0) -> bool {
    if props.tag != expected_tag || props.id != 1 || props.title != "Chest" || props.body != "Ready" ||
        hour != 19 || minute != 0 || !suppress_on_open || not_before_unix_ms != 1793700000000 ||
        weekdays != 127 || skip_local_date != 20261102 { failures += 1 }
    daily += 1
    return true
}
ScheduleNotificationAt :: (props: NotificationProps, year: s32, month: s32, day: s32,
    hour: s32, minute: s32 = 0) -> bool {
    if props.tag != expected_tag || props.id != 1 || year != 2028 || month != 2 || day != 29 ||
        hour != 19 || minute != 0 { failures += 1 }
    dated += 1
    return true
}
ScheduleNotificationDates :: (props: NotificationProps, dates: []s32, hour: s32, minute: s32 = 0) -> bool {
    if props.tag != expected_tag || props.id != 1 || dates.count != 2 || hour != 19 || minute != 0 { failures += 1 }
    else if dates[0] != 20280229 || dates[1] != 20300101 { failures += 1 }
    queued += 1
    return true
}
CancelDailyNotification :: (tag: string, id: s32) -> bool {
    if tag != expected_tag || id != 1 { failures += 1 }
    cancelled += 1
    return true
}
NotificationAppOpened :: (tag: string, id: s32) -> bool {
    if tag != expected_tag || id != 1 { failures += 1 }
    opened += 1
    return true
}
