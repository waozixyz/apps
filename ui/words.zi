    if key == "allow_content_description" { return "The app library, previews and the apps you’ve downloaded stay up to date automatically." }
    if key == "allow_content" { return "Allow" }
    if key == "stay_offline" { return "Stay offline" }
    if key == "loading_library" { return "Loading the library…" }
    if key == "library_unavailable" { return "Couldn’t refresh the library." }
    if key == "saved_library" { return "Showing your saved library." }
    if key == "offline_library" { return "You’re offline. Downloaded apps are still available." }
    if key == "refresh_library" { return "Refresh library" }
    return key
}
