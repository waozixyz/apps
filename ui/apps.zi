// One shared collection screen at every navigation level. App/account policy
// stays in the host; this portable UI only presents its verified catalog.
#import "std/json_scan"
#import "std/c_string"
#import "std/vec"
#import "std/text_buffer"
#import "kryon/app_context"
#import "kryon/app_protocol"
#import "kryon/text_widget"
#import "kryon/text_props"
#import "kryon/image_widget"
#import "kryon/image_props"
#import "kryon/button_widget"
#import "kryon/button_props"
#import "kryon/box_widget"
#import "kryon/box_props"
#import "kryon/scroll_widget"
#import "kryon/scroll_props"
#import "kryon/title_bar_widget"
#import "kryon/title_bar_props"
#import "kryon/dropdown_props"
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/tree"
#import, file "words.zi";

using ImageFit;
using TextWrap;

AppCard :: struct {
    id: [128]u8
    title: [256]u8
    preview: [512]u8
    installed: bool
    favorite: bool
    launcher: s32
}

cards: Vec(AppCard);
title: [256]u8;
locale: [16]u8;
can_back: bool;
scroll_offset: s32;
request: s64;
status: [32]u8;
action_taken: bool;

AppsBool :: (text: string, at: s32) -> bool {
    return at >= 0 && MatchLiteral(text, Space(text, at), "true")
}

AppsNumber :: (text: string, at: s32) -> float64 {
    parsed := ReadNumber(text, at)
    return ifx parsed.valid then parsed.value else 0.0
}

AppsReadCatalog :: () -> bool {
    text := AppService("apps", "{\"v\":1,\"op\":\"catalog\"}")
    version := ReadNumber(text, FieldAt(text, 0, "v"))
    if !version.valid || version.value != 1.0 || ReadStringText(text, FieldAt(text, 0, "title"), title[:]) < 0 ||
    ReadStringText(text, FieldAt(text, 0, "locale"), locale[:]) < 0 { return false }
    can_back = AppsBool(text, FieldAt(text, 0, "can_back"))
    children := FieldAt(text, 0, "children")
    count := ArrayCount(text, children)
    if count < 0 || count > 4096 { return false }
    VecClear(cards)
    at := Space(text, children + 1)
    for index: cast(s32)0..count - 1 {
        card: AppCard
        if ReadStringText(text, FieldAt(text, at, "id"), card.id[:]) < 0 ||
        ReadStringText(text, FieldAt(text, at, "title"), card.title[:]) < 0 ||
        ReadStringText(text, FieldAt(text, at, "preview"), card.preview[:]) < 0 { return false }
        card.installed = AppsBool(text, FieldAt(text, at, "installed"))
        card.favorite = AppsBool(text, FieldAt(text, at, "favorite"))
        card.launcher = cast(s32)AppsNumber(text, FieldAt(text, at, "launcher"))
        if !VecPush(cards, card) { return false }
        at = Space(text, ValueEnd(text, at, 0))
        if index + 1 < count { at = Space(text, at + 1) }
    }
    return true
}

AppsResponse :: (text: string) {
    unused ReadStringText(text, FieldAt(text, 0, "status"), status[:])
    request = cast(s64)AppsNumber(text, FieldAt(text, 0, "request"))
}

AppsAct :: (operation: string, target: [128]u8) {
    if action_taken { return }
    action_taken = true
    bytes: Vec(u8)
    id := TextUntilNul(target[:])
    // IDs and operations come from the validated service catalog and UI.
    if id == "" { BuilderPrint(*bytes, "{\"v\":1,\"op\":\"%\"}", operation) }
    else { BuilderPrint(*bytes, "{\"v\":1,\"op\":\"%\",\"id\":\"%\"}", operation, id) }
    AppsResponse(AppService("apps", TextView(VecSlice(bytes, 0, bytes.count))))
    VecFree(bytes)
}

AppsText :: (session: Session, key: u64, bounds: Rectangle, text: string, font: s32) {
    Text(session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = font, .wrap = cast(TextWrap)TextWrapEllipsis})
}

AppsControl :: (session: Session, key: u64, bounds: Rectangle, label: string, disabled: bool = false) -> bool {
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key, .bounds = bounds,
            .label = label, .disabled = disabled, .fit_content = true}) != 0
}

AppsFrame :: () -> bool {
    action_taken = false
    session := AppSession()
    bounds := AppBounds()
    font := AppFont()
    scale := AppScale()
    if scale <= 0.0 { scale = 1.0 }
    if !AppsReadCatalog() {
        AppsText(session, cast(u64)1, bounds, AppsLabel("en", "unavailable"), font)
        return true
    }
    language := TextUntilNul(locale[:])
    if request > 0 && TextUntilNul(status[:]) == "queued" {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "{\"v\":1,\"op\":\"status\",\"request\":%}", request)
        AppsResponse(AppService("apps", TextView(VecSlice(bytes, 0, bytes.count))))
        VecFree(bytes)
    }
    gap := 12.0 * scale
    head := 44.0 * scale
    operation: string
    target: [128]u8
    if can_back && AppsControl(session, cast(u64)2, Rectangle.{bounds.x + gap, bounds.y + gap, 84.0 * scale, head}, AppsLabel(language, "back")) {
        operation = "back"
    }
    title_x := bounds.x + gap + ifx can_back then 96.0 * scale else 0.0
    AppsText(session, cast(u64)3, Rectangle.{title_x, bounds.y + gap, bounds.x + bounds.width - gap - title_x, head}, TextUntilNul(title[:]), font + 4)
    {
        state := TextUntilNul(status[:])
        if state != "" { AppsText(session, cast(u64)4, Rectangle.{bounds.x + gap, bounds.y + head + gap, bounds.width - gap * 2.0, 26.0 * scale}, AppsLabel(language, state), font) }
    }
    top := bounds.y + head + gap * 2.0 + 26.0 * scale
    area := Rectangle.{bounds.x + gap, top, bounds.width - gap * 2.0, bounds.y + bounds.height - top - gap}
    columns: s32 = ifx area.width >= 440.0 * scale then 2 else 1
    card_width := (area.width - gap * cast(float32)(columns - 1)) / cast(float32)columns
    card_height := 232.0 * scale
    rows := (cast(s32)cards.count + columns - 1) / columns
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)5, .bounds = area, .scale = scale,
            .content_height = rows * cast(s32)(card_height + gap), .scroll_offset = scroll_offset})
    scroll_offset = scroll.scroll_offset
    if !scroll.opened { return true }
    if cards.count == 0 { AppsText(session, cast(u64)6, scroll.content, AppsLabel(language, "empty"), font) }
    for index: cast(s32)0..cast(s32)cards.count - 1 {
        card := cards[index]
        x := scroll.content.x + cast(float32)(index % columns) * (card_width + gap)
        y := scroll.content.y + cast(float32)(index / columns) * (card_height + gap)
        key := cast(u64)(100 + index * 16)
        unused Box(session, BoxProps.{.key = key, .bounds = Rectangle.{x, y, card_width, card_height}, .radius = 12.0 * scale})
        preview := TextUntilNul(card.preview[:])
        if preview != "" {
            Image(session, ImageProps.{.key = key + cast(u64)1, .asset_path = preview, .alt_text = TextUntilNul(card.title[:]),
                    .bounds = Rectangle.{x + gap, y + gap, card_width - gap * 2.0, 130.0 * scale}, .fit = cast(ImageFit)ImageFitContain, .smooth = true})
        }
        AppsText(session, key + cast(u64)2, Rectangle.{x + gap, y + 148.0 * scale, card_width - gap * 2.0, 32.0 * scale}, TextUntilNul(card.title[:]), font + 2)
        if Button(session, ButtonProps.{.key = key + cast(u64)3, .id = cast(s32)key + 3, .label = TextUntilNul(card.title[:]),
                .detail = AppsLabel(language, "open"), .bounds = Rectangle.{x + gap, y + gap, card_width - gap * 2.0, 168.0 * scale}, .invisible = true}) != 0 && operation == "" {
            operation = "open"
            target = card.id
        }
        launcher_label := ifx card.launcher == 1 then "prompt_pending" else ifx card.launcher == 2 then "launcher_installed" else "install_to_launcher"
        options: [3]DropdownOption = .[
        DropdownOption.{.label = AppsLabel(language, ifx card.installed then "uninstall" else "install")},
        DropdownOption.{.label = AppsLabel(language, ifx card.favorite then "unpin" else "pin"), .disabled = !card.installed},
        DropdownOption.{.label = AppsLabel(language, launcher_label), .disabled = !card.installed || card.launcher != 0}]
        menu := TitleBar(session, TitleBarProps.{.key = key + cast(u64)4, .id = cast(s32)key + 4,
                .bounds = Rectangle.{x + gap, y + 188.0 * scale, card_width - gap * 2.0, 36.0 * scale},
                .height = cast(s32)(36.0 * scale), .scale = scale, .has_dropdown = true,
                .dropdown_min_width = cast(s32)(220.0 * scale), .dropdown_height = cast(s32)(144.0 * scale),
                .dropdown = DropdownProps.{.placeholder = AppsLabel(language, "actions"), .selected_index = -1}}, options[:])
        if menu.dropdown.changed && operation == "" {
            if menu.dropdown.selected_index == 0 { operation = ifx card.installed then "uninstall" else "install" }
            if menu.dropdown.selected_index == 1 { operation = ifx card.favorite then "unpin" else "pin" }
            if menu.dropdown.selected_index == 2 { operation = "install_to_launcher" }
            target = card.id
        }
    }
    End(session)
    if operation != "" { AppsAct(operation, target) }
    return true
}

#program_export
Main :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        AppIdentity("apps")
        AppDescribe("Apps", "")
        return APP_PROTOCOL
    }
    if mode == APP_FRAME { return ifx AppsFrame() then 0 else 1 }
    if mode == APP_COMMAND { AppReply(AppService("apps", AppCommand())) }
    return 0
}
