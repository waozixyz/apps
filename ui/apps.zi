AppsCardPresent :: (card: *AppCard) -> bool {
    return card != null
}

// Native permission masks keep their u32 width in typed UI composition.
AppsPermissionFlag :: (index: u32) -> u32 {
    return cast(u32)1 << index
}
AppsPermissionGranted :: (permissions: u32, flag: u32) -> bool {
    return (permissions & flag) != cast(u32)0
}

// Indexed borrowed model access keeps native Vec element types in their module.
AppsCardAt :: (index: s64) -> *AppCard {
    return *cards[index]
}
AppsIconAt :: (index: s64) -> *AppIconChoice {
    return *icon_choices[index]
}
