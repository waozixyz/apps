Rules :: #import "protocol";
#import, file "words.zi";

using ImageFit;
using TextWrap;
using TextAlign;
using ButtonTone;
using ButtonEmphasis;
using IconPlacement;
using ContentAlignment;

APP_ELLIPSIS :: "S3rr:M12 5H12.01M12 12H12.01M12 19H12.01"
APP_REORDER :: "S2rr:M8 5H8.01M16 5H16.01M8 12H8.01M16 12H16.01M8 19H8.01M16 19H16.01"
APP_DOWNLOAD :: "S1.6rr:M12 3V15M7 10L12 15L17 10M5 20H19"

// What a host lets an app reach, named by its catalog's "permissions".
APP_PERMISSION_ACCOUNT :: 1
APP_PERMISSION_FRIENDS :: 2
APP_PERMISSION_AUDIO :: 4
APP_PERMISSION_MEDIA :: 8

AppDownloadItem :: struct {
    title: [256]u8
    bytes: s64
    dependency: bool
    next: *AppDownloadItem
}

AppCard :: struct {
    id: [128]u8
    title: [256]u8
    cover: Rules.AppCover
    // Present while the person's own title replaces the app's title.
    original_title: [256]u8
    // The offered icon the person chose; empty shows the app's own icon.
    icon_choice: [64]u8
    preview: [512]u8
    icon: [512]u8
    icon_shape: [16384]u8
    installed: bool
    // Whether the app's package is on this device; one that is not shows
    // the download symbol instead of its options, and says so while it
    // downloads.
    on_device: bool
    downloading: bool
    // How much of the download has arrived in percent, or -1 while unknown.
    progress: s32
    download_failed: bool
    // APP_PERMISSION_* bits for what the app may reach once it is here.
    permissions: u32
    favorite: bool
    reorderable: bool
    launcher: s32
    selected: bool
    disabled: bool
    bytes: s64
    downloads: *AppDownloadItem
    download_count: s32
    actions: u64
    current_version: [64]u8
    available: Rules.AppVersion
    update_available: bool
    update_seen: bool
    history: [3]Rules.AppVersion
    history_count: s32
}

cards: Vec(AppCard);
empty_target: [128]u8;
title: [256]u8;
locale: [16]u8;
can_back: bool;
icon_mode: bool;
cover_mode: bool;
cover_grid: bool;
cover_state: CarouselState;
// The launcher transition advances with rendered frames; no game clock or
// optional host time capability is required by icon/list-only controllers.
cover_time: float64;
list_mode: bool;
hide_sizes: bool;
has_reorder_handles: bool;
section_break: s32;
has_section_break: bool;
presentation_columns: s32;
tile_class: s32;
action_class: s32;
muted_class: s32;
image_class: s32;
// The host's revision of the catalog parsed into these cards, or 0. Parsing
// the whole catalog every frame cost a phone most of each frame.
catalog_revision: s64;
scroll_offset: s32;
request: s64;
status: [32]u8;
action_taken: bool;
menu_id: [128]u8;
menu_x: float32;
menu_y: float32;
dialog_id: [128]u8;
// 1 update confirmation, 2 retained version chooser, 3 rollback confirmation,
// 4 the app's properties, 5 downloading an app not on this device.
dialog: s32;
// Whether Download was pressed in the open download dialog; frames drawn
// since, for the bar of a download whose size is not known.
download_started: bool;
download_frames: s32;
last_download_request: s64;
dialog_target: Rules.AppVersion;
dialog_message: [2048]u8;

AppIconChoice :: struct {
    id: [64]u8
    shape: [16384]u8
    image: [512]u8
}

// The properties being edited, kept until Save or Cancel.
properties_title: [256]u8;
properties_icon: [64]u8;
properties_cursor: s32;
properties_anchor: s32;
properties_scroll_x: s32;
properties_focused: bool;
icon_choices: Vec(AppIconChoice);
icon_scroll: s32;

AppsBool :: (text: string, at: s32) -> bool {
    return at >= 0 && MatchLiteral(text, Space(text, at), "true")
}

AppsNumber :: (text: string, at: s32) -> float64 {
    parsed := ReadNumber(text, at)
    return ifx parsed.valid then parsed.value else 0.0
}

AppsArrayAt :: (text: string, array: s32, index: s32) -> s32 {
    at := Space(text, array + 1)
    for previous: cast(s32)0..index - 1 { at = Space(text, ValueEnd(text, at, 0) + 1) }
    return at
}

AppsOptionalText :: (text: string, at: s32, key: string, output: []u8) -> bool {
    return FieldAt(text, at, key) < 0 || Rules.AppsReadText(text, at, key, output)
}

AppsVersionRead :: (text: string, at: s32, version: *Rules.AppVersion) -> bool {
    return Rules.AppsReadText(text, at, "version", version.version[:]) &&
    Rules.AppVersionValid(TextUntilNul(version.version[:])) &&
    Rules.AppsReadText(text, at, "sha256", version.sha256[:]) &&
    Rules.AppDigestValid(TextUntilNul(version.sha256[:]))
}

AppsVersionEqual :: (left: *Rules.AppVersion, right: *Rules.AppVersion) -> bool {
    return TextUntilNul(left.version[:]) == TextUntilNul(right.version[:]) &&
    TextUntilNul(left.sha256[:]) == TextUntilNul(right.sha256[:])
}

AppsSupported :: (card: *AppCard, operation: s32) -> bool {
    return (card.actions & (cast(u64)1 << cast(u64)operation)) != cast(u64)0
}

AppsReadCatalog :: () -> bool {
    text: string
    if catalog_revision > 0 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "{\"v\":1,\"op\":\"catalog\",\"revision\":%}", catalog_revision)
        text = AppService("apps", TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
        // The cards already hold this revision.
        if AppsBool(text, FieldAt(text, 0, "unchanged")) { return true }
    } else {
        text = AppService("apps", "{\"v\":1,\"op\":\"catalog\"}")
    }
    catalog_revision = 0
    version := ReadNumber(text, FieldAt(text, 0, "v"))
    if !version.valid || version.value != 1.0 || !Rules.AppsReadText(text, 0, "title", title[:]) ||
    !Rules.AppsReadText(text, 0, "locale", locale[:]) { return false }
    can_back = AppsBool(text, FieldAt(text, 0, "can_back"))
    presentation := FieldAt(text, 0, "presentation")
    mode: [16]u8
    if !AppsOptionalText(text, presentation, "mode", mode[:]) { return false }
    list_mode = TextUntilNul(mode[:]) == "list"
    icon_mode = list_mode || TextUntilNul(mode[:]) == "icon"
    cover_grid = TextUntilNul(mode[:]) == "covers"
    hide_sizes = AppsBool(text, FieldAt(text, presentation, "hide_sizes"))
    requested_download: [128]u8
    if !AppsOptionalText(text, presentation, "download_id", requested_download[:]) { return false }
    download_request := cast(s64)AppsNumber(text, FieldAt(text, presentation, "download_request"))
    has_section_break = FieldAt(text, presentation, "section_break") >= 0
    section_break = cast(s32)AppsNumber(text, FieldAt(text, presentation, "section_break"))
    presentation_columns = cast(s32)AppsNumber(text, FieldAt(text, presentation, "columns"))
    tile_class = cast(s32)AppsNumber(text, FieldAt(text, presentation, "tile_class"))
    action_class = cast(s32)AppsNumber(text, FieldAt(text, presentation, "action_class"))
    muted_class = cast(s32)AppsNumber(text, FieldAt(text, presentation, "muted_class"))
    image_class = cast(s32)AppsNumber(text, FieldAt(text, presentation, "image_class"))
    children := FieldAt(text, 0, "children")
    count := ArrayCount(text, children)
    if count < 0 || count > 4096 { return false }
    for index: cast(s64)0..cards.count - 1 { AppsDownloadItemsClear(*cards[index]) }
    VecClear(cards)
    has_reorder_handles = false
    cover_mode = false
    at := Space(text, children + 1)
    for index: cast(s32)0..count - 1 {
        card: AppCard
        if !Rules.AppsReadText(text, at, "id", card.id[:]) || !Rules.AppIdValid(TextUntilNul(card.id[:])) ||
        !Rules.AppsReadText(text, at, "title", card.title[:]) ||
        !AppsOptionalText(text, at, "preview", card.preview[:]) ||
        !AppsOptionalText(text, at, "icon", card.icon[:]) ||
        !AppsOptionalText(text, at, "icon_shape", card.icon_shape[:]) ||
        !AppsOptionalText(text, at, "original_title", card.original_title[:]) ||
        !AppsOptionalText(text, at, "icon_choice", card.icon_choice[:]) ||
        !AppsOptionalText(text, at, "current_version", card.current_version[:]) { return false }
        cover := FieldAt(text, at, "cover")
        if cover >= 0 {
            if !Rules.AppsReadText(text, cover, "portrait", card.cover.portrait[:]) ||
            !AppsOptionalText(text, cover, "landscape", card.cover.landscape[:]) ||
            !AppsOptionalText(text, cover, "logo", card.cover.logo[:]) ||
            !AppsOptionalText(text, cover, "caption", card.cover.caption[:]) ||
            !AppsOptionalText(text, cover, "action", card.cover.action[:]) { return false }
            cover_mode = true
        }
        if TextUntilNul(card.preview[:]) != "" && !Rules.AppPreviewPathValid(TextUntilNul(card.preview[:])) { return false }
        if TextUntilNul(card.icon[:]) != "" && !Rules.AppPreviewPathValid(TextUntilNul(card.icon[:])) { return false }
        if TextUntilNul(card.current_version[:]) == "" { unused AppsOptionalText(text, at, "version", card.current_version[:]) }
        card.installed = AppsBool(text, FieldAt(text, at, "installed"))
        // Hosts from before these fields only list apps on the device.
        card.on_device = FieldAt(text, at, "on_device") < 0 || AppsBool(text, FieldAt(text, at, "on_device"))
        card.downloading = !card.on_device && AppsBool(text, FieldAt(text, at, "downloading"))
        card.progress = -1
        progress := FieldAt(text, at, "progress")
        if card.downloading && progress >= 0 {
            value := AppsNumber(text, progress)
            if value >= 0.0 && value <= 100.0 { card.progress = cast(s32)value }
        }
        card.download_failed = !card.on_device && !card.downloading && AppsBool(text, FieldAt(text, at, "download_failed"))
        // Names a newer host adds and this screen does not know are left out.
        permissions := FieldAt(text, at, "permissions")
        permission_count := ifx permissions < 0 then 0 else ArrayCount(text, permissions)
        if permission_count < 0 || permission_count > 16 { return false }
        for entry: cast(s32)0..permission_count - 1 {
            name: [32]u8
            if ReadStringText(text, AppsArrayAt(text, permissions, entry), name[:]) < 0 { return false }
            card.permissions = card.permissions | AppsPermission(TextUntilNul(name[:]))
        }
        card.favorite = AppsBool(text, FieldAt(text, at, "favorite"))
        card.reorderable = AppsBool(text, FieldAt(text, at, "reorderable"))
        if card.reorderable { has_reorder_handles = true }
        card.launcher = cast(s32)AppsNumber(text, FieldAt(text, at, "launcher"))
        card.selected = AppsBool(text, FieldAt(text, at, "selected"))
        card.disabled = AppsBool(text, FieldAt(text, at, "disabled"))
        card.bytes = cast(s64)AppsNumber(text, FieldAt(text, at, "bytes"))
        actions := FieldAt(text, at, "actions")
        if actions < 0 {
            for operation: cast(s32)2..8 { card.actions = card.actions | (cast(u64)1 << cast(u64)operation) }
        } else {
            action_count := ArrayCount(text, actions)
            if action_count < 0 || action_count > 14 { return false }
            for action: cast(s32)0..action_count - 1 {
                name: [32]u8
                if ReadStringText(text, AppsArrayAt(text, actions, action), name[:]) < 0 { return false }
                operation := Rules.AppsOperation(TextUntilNul(name[:]))
                if operation > 0 { card.actions = card.actions | (cast(u64)1 << cast(u64)operation) }
            }
        }
        if AppsBool(text, FieldAt(text, at, "update_available")) &&
        AppsOptionalText(text, at, "available_version", card.available.version[:]) &&
        AppsOptionalText(text, at, "available_sha256", card.available.sha256[:]) &&
        Rules.AppVersionValid(TextUntilNul(card.available.version[:])) && Rules.AppDigestValid(TextUntilNul(card.available.sha256[:])) {
            card.update_available = AppsSupported(*card, Rules.APPS_UPDATE)
            card.update_seen = AppsBool(text, FieldAt(text, at, "update_seen"))
        }
        history := FieldAt(text, at, "version_history")
        history_count := ifx history < 0 then 0 else ArrayCount(text, history)
        if history_count < 0 || history_count > 3 { return false }
        for entry: cast(s32)0..history_count - 1 {
            retained: Rules.AppVersion
            if !AppsVersionRead(text, AppsArrayAt(text, history, entry), *retained) { return false }
            duplicate: bool
            for previous: cast(s32)0..card.history_count - 1 {
                if AppsVersionEqual(*retained, *card.history[previous]) { duplicate = true }
            }
            if !duplicate { card.history[card.history_count] = retained; card.history_count += 1 }
        }
        for previous: cast(s64)0..cards.count - 1 {
            if TextUntilNul(cards[previous].id[:]) == TextUntilNul(card.id[:]) { return false }
        }
        downloads := FieldAt(text, at, "downloads")
        if downloads >= 0 {
            download_count := ArrayCount(text, downloads)
            if download_count < 0 || download_count > 32 { return false }
            last: *AppDownloadItem
            for index: cast(s32)0..download_count - 1 {
                row := ElementAt(text, downloads, index)
                item := New(AppDownloadItem)
                if item == null { AppsDownloadItemsClear(*card); return false }
                if last == null { card.downloads = item }
                else { last.next = item }
                last = item
                if !Rules.AppsReadText(text, row, "title", item.title[:]) { AppsDownloadItemsClear(*card); return false }
                item.bytes = cast(s64)AppsNumber(text, FieldAt(text, row, "bytes"))
                item.dependency = AppsBool(text, FieldAt(text, row, "dependency"))

            }
            card.download_count = cast(s32)download_count
        }
        if !VecPush(cards, card) { AppsDownloadItemsClear(*card); return false }
        at = Space(text, ValueEnd(text, at, 0))
        if index + 1 < count { at = Space(text, at + 1) }
    }
    // A native navigation shortcut can ask for this same download dialog.
    // Consume each request once so Cancel and Hide keep working.
    if download_request > last_download_request && requested_download[0] != 0 {
        target := AppsFind(requested_download)
        if target != null && !target.on_device && AppsSupported(target, Rules.APPS_INSTALL) {
            AppsDownloadOpen(target)
            last_download_request = download_request
        }
    }
    // Hosts without revisions are asked for the whole catalog every frame.
    revision := ReadNumber(text, FieldAt(text, 0, "revision"))
    if revision.valid && revision.value >= 1.0 && revision.value <= 2147483647.0 &&
    cast(float64)cast(s64)revision.value == revision.value {
        catalog_revision = cast(s64)revision.value
    }
    return true
}

AppsResponse :: (text: string) {
    unused ReadStringText(text, FieldAt(text, 0, "status"), status[:])
    request = cast(s64)AppsNumber(text, FieldAt(text, 0, "request"))
}

AppsAct :: (operation: string, target: [128]u8, version: Rules.AppVersion = Rules.AppVersion.{},
    properties: bool = false) {
    if action_taken { return }
    action_taken = true
    bytes: Vec(u8)
    BuilderPrint(*bytes, "{\"v\":1,\"op\":")
    Rules.AppsWriteQuoted(*bytes, operation)
    if TextUntilNul(target[:]) != "" {
        BuilderPrint(*bytes, ",\"id\":")
        Rules.AppsWriteQuoted(*bytes, TextUntilNul(target[:]))
    }
    if Rules.AppsVersionOperation(Rules.AppsOperation(operation)) {
        BuilderPrint(*bytes, ",\"version\":")
        Rules.AppsWriteQuoted(*bytes, TextUntilNul(version.version[:]))
        BuilderPrint(*bytes, ",\"sha256\":")
        Rules.AppsWriteQuoted(*bytes, TextUntilNul(version.sha256[:]))
    }
    if properties {
        BuilderPrint(*bytes, ",\"title\":")
        Rules.AppsWriteQuoted(*bytes, TextUntilNul(properties_title[:]))
        BuilderPrint(*bytes, ",\"icon\":")
        Rules.AppsWriteQuoted(*bytes, TextUntilNul(properties_icon[:]))
    }
    BuilderPrint(*bytes, "}")
    AppsResponse(AppService("apps", TextView(VecSlice(bytes, 0, bytes.count))))
    VecFree(bytes)
}

AppsText :: (session: Session, key: u64, bounds: Rectangle, text: string, font: s32) {
    Text(session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = font, .wrap = cast(TextWrap)TextWrapEllipsis})
}

AppsFind :: (id: [128]u8) -> *AppCard {
    for index: cast(s64)0..cards.count - 1 {
        if TextUntilNul(cards[index].id[:]) == TextUntilNul(id[:]) { return *cards[index] }
    }
    return null
}

AppsMenuItem :: (items: []ContextMenuItem, count: *s32, card: *AppCard, operation: s32,
    language: string, label: string, disabled: bool = false) {
    if !AppsSupported(card, operation) { return }
    items[count.*] = ContextMenuItem.{.id = operation, .label = AppsLabel(language, label), .disabled = disabled}
    count.* += 1
}

AppsMenu :: (session: Session, scale: float32, language: string) {
    card := AppsFind(menu_id)
    if card == null || card.disabled { menu_id[0] = cast(u8)0; return }
    items: [7]ContextMenuItem
    count: s32
    // The options' dot leads here, so an update not yet installed comes first.
    if card.update_available { AppsMenuItem(items[:], *count, card, Rules.APPS_UPDATE, language, "update") }
    AppsMenuItem(items[:], *count, card, Rules.APPS_OPEN, language, "open")
    AppsMenuItem(items[:], *count, card, ifx card.installed then Rules.APPS_UNINSTALL else Rules.APPS_INSTALL,
        language, ifx card.installed then "uninstall" else "install")
    AppsMenuItem(items[:], *count, card, ifx card.favorite then Rules.APPS_UNPIN else Rules.APPS_PIN,
        language, ifx card.favorite then "unpin" else "pin", !card.installed)
    AppsMenuItem(items[:], *count, card, Rules.APPS_INSTALL_TO_LAUNCHER, language,
        ifx card.launcher == 1 then "prompt_pending" else ifx card.launcher == 2 then "launcher_installed" else "install_to_launcher",
        !card.installed || card.launcher != 0)
    if card.history_count > 0 { AppsMenuItem(items[:], *count, card, Rules.APPS_ROLLBACK, language, "rollback") }
    AppsMenuItem(items[:], *count, card, Rules.APPS_PROPERTIES, language, "properties")
    if count == 0 { menu_id[0] = cast(u8)0; return }
    menu := ContextMenu(session, ContextMenuProps.{.key = cast(u64)7, .open = true, .x = menu_x, .y = menu_y,
            .scale = scale, .escape = AppKey() == 256 || AppKey() == 27}, items[:count])
    if menu.activated_id == Rules.APPS_UPDATE { dialog_id = card.id; dialog = 1; dialog_target = card.available }
    else if menu.activated_id == Rules.APPS_ROLLBACK { dialog_id = card.id; dialog = 2 }
    else if menu.activated_id == Rules.APPS_PROPERTIES { AppsPropertiesOpen(card) }
    else if menu.activated_id > 0 {
        operation := ifx menu.activated_id == Rules.APPS_OPEN then "open" else ifx menu.activated_id == Rules.APPS_INSTALL then "install" else ifx menu.activated_id == Rules.APPS_UNINSTALL then "uninstall" else ifx menu.activated_id == Rules.APPS_PIN then "pin" else ifx menu.activated_id == Rules.APPS_UNPIN then "unpin" else "install_to_launcher"
        AppsAct(operation, card.id)
    }
    if !menu.open { menu_id[0] = cast(u8)0 }
}

// The icons the host offers for this app: its own first, then the rest.
AppsIconsRead :: (id: [128]u8) {
    VecClear(icon_choices)
    bytes: Vec(u8)
    BuilderPrint(*bytes, "{\"v\":1,\"op\":\"icons\",\"id\":")
    Rules.AppsWriteQuoted(*bytes, TextUntilNul(id[:]))
    BuilderPrint(*bytes, "}")
    text := AppService("apps", TextView(VecSlice(bytes, 0, bytes.count)))
    VecFree(bytes)
    icons := FieldAt(text, 0, "icons")
    count := ArrayCount(text, icons)
    if count <= 0 || count > 64 { return }
    for index: cast(s32)0..count - 1 {
        at := AppsArrayAt(text, icons, index)
        choice: AppIconChoice
        if !Rules.AppsReadText(text, at, "id", choice.id[:]) || !Rules.AppIconChoiceValid(TextUntilNul(choice.id[:])) ||
        !AppsOptionalText(text, at, "shape", choice.shape[:]) || !AppsOptionalText(text, at, "image", choice.image[:]) ||
        (TextUntilNul(choice.image[:]) != "" && !Rules.AppPreviewPathValid(TextUntilNul(choice.image[:]))) ||
        (TextUntilNul(choice.shape[:]) == "" && TextUntilNul(choice.image[:]) == "") || !VecPush(icon_choices, choice) {
            VecClear(icon_choices)
            return
        }
    }
}

AppsPropertiesOpen :: (card: *AppCard) {
    AppsIconsRead(card.id)
    properties_title = card.title
    properties_icon = card.icon_choice
    properties_cursor = cast(s32)TextUntilNul(properties_title[:]).count
    properties_anchor = properties_cursor
    properties_scroll_x = 0
    properties_focused = false
    icon_scroll = 0
    dialog_id = card.id
    dialog = 4
}

AppsPropertiesClose :: () {
    dialog = 0
    properties_focused = false
    VecClear(icon_choices)
}

// Replace bytes start..end of a zero-terminated buffer, as a text field edits.
AppsReplaceText :: (buffer: []u8, start: s32, end: s32, replacement: string) {
    length := cast(s32)TextUntilNul(buffer).count
    new_length := length - (end - start) + cast(s32)replacement.count
    if start < 0 || end < start || end > length || new_length >= cast(s32)buffer.count { return }
    tail := length - end
    if new_length > length {
        for offset: cast(s32)0..tail { buffer[new_length - offset] = buffer[length - offset] }
    } else {
        for offset: cast(s32)0..tail { buffer[start + cast(s32)replacement.count + offset] = buffer[end + offset] }
    }
    for offset: cast(s64)0..replacement.count - 1 { buffer[cast(s64)start + offset] = replacement[offset] }
    buffer[new_length] = cast(u8)0
}

// The title without surrounding spaces; the app's own title saves as empty.
AppsPropertiesSavedTitle :: (card: *AppCard) -> [256]u8 {
    title := TextUntilNul(properties_title[:])
    first: s64 = 0
    last := title.count
    while first < last && title[first] == #char " " { first += 1 }
    while last > first && title[last - 1] == #char " " { last -= 1 }
    original := TextUntilNul(card.original_title[:])
    if original == "" { original = TextUntilNul(card.title[:]) }
    saved: [256]u8
    if title[first:last] != original { unused CopyCString(title[first:last], saved[:]) }
    return saved
}

AppsPropertiesSave :: (card: *AppCard) {
    properties_title = AppsPropertiesSavedTitle(card)
    AppsAct("properties", card.id, Rules.AppVersion.{}, true)
}

AppsProperties :: (session: Session, card: *AppCard, scale: float32, language: string, font: s32) {
    gap := 12.0 * scale
    line := 20.0 * scale
    control := 44.0 * scale
    cell_width := 48.0 * scale
    cell_height := 44.0 * scale
    count := cast(s32)icon_choices.count
    // About eight icons fit a row of the requested width; the grid scrolls
    // when the window is shorter than the dialog.
    content_height := line + 4.0 * scale + control + gap + control
    if count > 0 { content_height += line + 4.0 * scale + cast(float32)((count + 7) / 8) * cell_height + 8.0 * scale + gap }
    frame := ModalFrame(session, ModalFrameProps.{.key = cast(u64)12, .title = AppsLabel(language, "properties"),
            .width = cast(s32)(440.0 * scale), .height = cast(s32)(content_height + 74.0 * scale), .scale = scale})
    if frame.dismissed { AppsPropertiesClose(); return }
    if !frame.opened { return }
    area := frame.layout.content
    x := area.x
    y := area.y
    width := area.width
    bottom := area.y + area.height
    AppsText(session, cast(u64)13, Rectangle.{x, y, width, line}, AppsLabel(language, "name"), font)
    y += line + 4.0 * scale
    placeholder := TextUntilNul(card.original_title[:])
    if placeholder == "" { placeholder = TextUntilNul(card.title[:]) }
    // The field reads a snapshot, so its edit can change the title itself.
    snapshot: [256]u8
    for byte: cast(s64)0..snapshot.count - 1 { snapshot[byte] = properties_title[byte] }
    field := TextFieldProps.{.key = cast(u64)14, .bounds = Rectangle.{x, y, width, control},
        .value = TextUntilNul(snapshot[:]), .label = AppsLabel(language, "name"), .placeholder = placeholder,
        .cursor = properties_cursor, .anchor = properties_anchor, .scroll_x = properties_scroll_x,
        .focused = properties_focused, .scale = scale, .max_bytes = cast(s32)properties_title.count - 1}
    if properties_focused { field.input = AppFieldInput() }
    edited := TextField(session, field)
    if edited.edit.changed {
        AppsReplaceText(properties_title[:], edited.edit.start, edited.edit.end, edited.edit.replacement)
    }
    properties_cursor = edited.cursor
    properties_anchor = edited.anchor
    properties_scroll_x = edited.scroll_x
    properties_focused = edited.focused && !edited.escaped
    AppKeyboard(properties_focused)
    y += control + gap
    if count > 0 {
        AppsText(session, cast(u64)15, Rectangle.{x, y, width, line}, AppsLabel(language, "icon"), font)
        y += line + 4.0 * scale
        columns := cast(s32)(width / cell_width)
        if columns < 1 { columns = 1 }
        rows := (count + columns - 1) / columns
        visible := bottom - control - gap - y
        if visible < cell_height { visible = cell_height }
        grid := Scroll(session, ScrollProps.{.key = cast(u64)16, .bounds = Rectangle.{x, y, width, visible}, .scale = scale,
                .content_height = cast(s32)(cast(float32)rows * cell_height + 8.0 * scale), .scroll_offset = icon_scroll})
        icon_scroll = grid.scroll_offset
        if grid.opened {
            for index: cast(s32)0..count - 1 {
                choice := *icon_choices[index]
                chosen := TextUntilNul(choice.id[:]) == TextUntilNul(properties_icon[:])
                label := TextUntilNul(choice.id[:])
                if label == "" { label = placeholder }
                icon := ButtonProps.{.key = cast(u64)(100 + index), .label = label, .icon_only = true, .circle = true,
                    .icon_shape = TextUntilNul(choice.shape[:]), .selected = chosen,
                    .image = ImageProps.{.asset_path = TextUntilNul(choice.image[:]), .alt_text = label},
                    .bounds = Rectangle.{grid.content.x + cast(float32)(index % columns) * cell_width + 4.0 * scale,
                        grid.content.y + cast(float32)(index / columns) * cell_height + 4.0 * scale, 40.0 * scale, 40.0 * scale},
                    .tone = cast(ButtonTone)(ifx chosen then ButtonToneAccent else ButtonToneNeutral),
                    .emphasis = cast(ButtonEmphasis)(ifx chosen then ButtonEmphasisFilled else ButtonEmphasisSoft)}
                if Button(session, icon) != 0 { properties_icon = choice.id }
            }
            End(session)
        }
    }
    button_width := (width - gap) * 0.5
    if button_width > 160.0 * scale { button_width = 160.0 * scale }
    save := Button(session, ButtonProps.{.key = cast(u64)17, .label = AppsLabel(language, "save"),
            .bounds = Rectangle.{x + width - button_width, bottom - control, button_width, control},
            .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}) != 0
    cancel := Button(session, ButtonProps.{.key = cast(u64)18, .label = AppsLabel(language, "cancel"),
            .bounds = Rectangle.{x + width - button_width * 2.0 - gap, bottom - control, button_width, control},
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0
    End(session)
    if cancel { AppsPropertiesClose() }
    else if save || edited.committed {
        AppsPropertiesSave(card)
        AppsPropertiesClose()
    }
}

AppsPermission :: (name: string) -> u32 {
    if name == "account" { return cast(u32)APP_PERMISSION_ACCOUNT }
    if name == "friends" { return cast(u32)APP_PERMISSION_FRIENDS }
    if name == "audio" { return cast(u32)APP_PERMISSION_AUDIO }
    if name == "media" { return cast(u32)APP_PERMISSION_MEDIA }
    return cast(u32)0
}

AppsPermissionLabel :: (bit: u32) -> string {
    if bit == cast(u32)APP_PERMISSION_ACCOUNT { return "permission_account" }
    if bit == cast(u32)APP_PERMISSION_FRIENDS { return "permission_friends" }
    if bit == cast(u32)APP_PERMISSION_AUDIO { return "permission_audio" }
    return "permission_media"
}

AppsDownloadOpen :: (card: *AppCard) {
    dialog_id = card.id
    dialog = 5
    download_started = card.downloading
    download_frames = 0
}

// Before anything downloads the dialog says how big the app is and what it
// may reach, and Download is the consent; then it shows the progress and
// ends with Open, or Try again when the download failed.
AppsDownload :: (session: Session, card: *AppCard, scale: float32, language: string, font: s32) {
    if !download_started && (card.on_device || !AppsSupported(card, Rules.APPS_INSTALL)) { AppsPropertiesClose(); return }
    if download_started && card.on_device {
        AppsAct("open", card.id)
        AppsPropertiesClose()
        return
    }
    gap := 12.0 * scale
    line := 24.0 * scale
    control := 44.0 * scale
    icon_size := 48.0 * scale
    bar := 10.0 * scale
    download_frames += 1
    asking := !download_started && !card.downloading && !card.download_failed
    size_text: [32]u8
    has_size := AppsSize(card.bytes, size_text[:])
    permission_count: s32
    for bit: cast(u32)0..3 {
        if (card.permissions & (cast(u32)1 << bit)) != cast(u32)0 { permission_count += 1 }
    }
    content_height := icon_size + gap + control
    if card.download_count > 1 { content_height += cast(float32)card.download_count * line + gap }
    if asking && permission_count > 0 { content_height += line + cast(float32)permission_count * line + gap }
    if card.downloading || (download_started && !card.on_device && !card.download_failed) { content_height += bar + gap }
    frame := ModalFrame(session, ModalFrameProps.{.key = cast(u64)19, .title = TextUntilNul(card.title[:]),
            .width = cast(s32)(440.0 * scale), .height = cast(s32)(content_height + 74.0 * scale), .scale = scale})
    if frame.dismissed { AppsPropertiesClose(); return }
    if !frame.opened { return }
    area := frame.layout.content
    x := area.x
    y := area.y
    width := area.width
    bottom := area.y + area.height
    // The card's own picture or symbol, as its tile shows it.
    unused Button(session, ButtonProps.{.key = cast(u64)20, .label = TextUntilNul(card.title[:]), .icon_only = true,
            .icon_shape = TextUntilNul(card.icon_shape[:]),
            .image = ImageProps.{.asset_path = TextUntilNul(card.icon[:]), .alt_text = TextUntilNul(card.title[:])},
            .bounds = Rectangle.{x, y, icon_size, icon_size}, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft})
    // One line beside the icon says where the download stands.
    state: Vec(u8)
    if card.on_device { BuilderPrint(*state, "%", AppsLabel(language, "ready")) }
    else if card.download_failed { BuilderPrint(*state, "%", AppsLabel(language, "download_failed")) }
    else if card.downloading && card.progress >= 0 { BuilderPrint(*state, "% %", AppsLabel(language, "downloading"), card.progress); BuilderPrint(*state, "%", "%") }
    else if card.downloading { BuilderPrint(*state, "%", AppsLabel(language, "downloading")) }
    else if download_started { BuilderPrint(*state, "%", AppsLabel(language, "download_waiting")) }
    else if has_size { BuilderPrint(*state, "%: %", AppsLabel(language, "download_size"), TextUntilNul(size_text[:])) }
    else { BuilderPrint(*state, "%", AppsLabel(language, "download")) }
    unused CopyCString(TextView(VecSlice(state, 0, state.count)), dialog_message[:])
    VecFree(state)
    Text(session, TextProps.{.key = cast(u64)21, .text = TextUntilNul(dialog_message[:]), .font = font + 2,
            .bounds = Rectangle.{x + icon_size + gap, y, width - icon_size - gap, icon_size},
            .wrap = cast(TextWrap)TextWrapEllipsis, .vertical_align = cast(TextAlign)TextAlignCenter})
    y += icon_size + gap
    if card.download_count > 1 {
        item := card.downloads
        for index: cast(s32)0..card.download_count - 1 {
            size: [32]u8
            label: Vec(u8)
            BuilderPrint(*label, "%", TextUntilNul(item.title[:]))
            if item.dependency { BuilderPrint(*label, " (%)", AppsLabel(language, "download_dependency")) }
            if AppsSize(item.bytes, size[:]) { BuilderPrint(*label, " · %", TextUntilNul(size[:])) }
            text: [512]u8
            unused CopyCString(TextView(VecSlice(label, 0, label.count)), text[:])
            VecFree(label)
            AppsText(session, cast(u64)100 + cast(u64)index, Rectangle.{x, y, width, line}, TextUntilNul(text[:]), font)
            y += line
            item = item.next
        }
        y += gap
    }
    if asking && permission_count > 0 {
        AppsText(session, cast(u64)22, Rectangle.{x, y, width, line}, AppsLabel(language, "app_can"), font)
        y += line
        for bit: cast(u32)0..3 {
            flag := cast(u32)1 << bit
            if (card.permissions & flag) == cast(u32)0 { continue }
            bullet: Vec(u8)
            BuilderPrint(*bullet, "•  %", AppsLabel(language, AppsPermissionLabel(flag)))
            label: [256]u8
            unused CopyCString(TextView(VecSlice(bullet, 0, bullet.count)), label[:])
            VecFree(bullet)
            AppsText(session, cast(u64)23 + cast(u64)bit, Rectangle.{x + 8.0 * scale, y, width - 8.0 * scale, line},
                TextUntilNul(label[:]), font)
            y += line
        }
        y += gap
    }
    if card.downloading || (download_started && !card.on_device && !card.download_failed) {
        track := Rectangle.{x, y, width, bar}
        if card.downloading && card.progress >= 0 {
            unused Box(session, BoxProps.{.key = cast(u64)28, .bounds = track, .radius = bar * 0.5,
                    .fill = ifx AppDark() then Color.{58, 74, 68, 255} else Color.{221, 232, 226, 255}})
            fill := track
            fill.width = width * cast(float32)card.progress / 100.0
            if fill.width >= bar {
                unused Box(session, BoxProps.{.key = cast(u64)29, .bounds = fill, .radius = bar * 0.5,
                        .fill = Color.{46, 125, 74, 255}})
            }
        } else {
            // Until its size is known, Kryon's loading dots, as every app shows.
            LoadingIndicator(session, LoadingIndicatorProps.{.key = cast(u64)29,
                    .bounds = Rectangle.{x, y - bar, width, bar * 3.0}, .now = cast(float64)download_frames / 60.0,
                    .scale = scale})
        }
        y += bar + gap
    }
    button_width := (width - gap) * 0.5
    if button_width > 160.0 * scale { button_width = 160.0 * scale }
    primary := Rectangle.{x + width - button_width, bottom - control, button_width, control}
    secondary := Rectangle.{x + width - button_width * 2.0 - gap, bottom - control, button_width, control}
    if asking || card.download_failed || card.on_device {
        label := ifx card.on_device then "open" else (ifx card.download_failed then "try_again" else "download")
        go := Button(session, ButtonProps.{.key = cast(u64)30, .label = AppsLabel(language, label), .bounds = primary,
                .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled,
                .disabled = !AppsSupported(card, ifx card.on_device then Rules.APPS_OPEN else Rules.APPS_INSTALL)}) != 0
        close := Button(session, ButtonProps.{.key = cast(u64)31, .bounds = secondary,
                .label = AppsLabel(language, ifx asking then "cancel" else "close"),
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0
        End(session)
        if close { AppsPropertiesClose() }
        else if go && card.on_device { AppsAct("open", card.id); AppsPropertiesClose() }
        else if go { AppsAct("install", card.id); download_started = true; download_frames = 0 }
        return
    }
    // The download goes on without the dialog.
    hide := Button(session, ButtonProps.{.key = cast(u64)32, .label = AppsLabel(language, "hide"), .bounds = primary,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0
    End(session)
    if hide { AppsPropertiesClose() }
}

AppsDialog :: (session: Session, scale: float32, language: string, font: s32) {
    if dialog == 0 { return }
    card := AppsFind(dialog_id)
    if card == null || card.disabled || AppKey() == 256 || AppKey() == 27 { AppsPropertiesClose(); return }
    if dialog == 5 {
        AppsDownload(session, card, scale, language, font)
        return
    }
    if dialog == 4 {
        if !AppsSupported(card, Rules.APPS_PROPERTIES) { AppsPropertiesClose(); return }
        AppsProperties(session, card, scale, language, font)
        return
    }
    if (dialog == 1 && !AppsSupported(card, Rules.APPS_UPDATE)) ||
    (dialog >= 2 && !AppsSupported(card, Rules.APPS_ROLLBACK)) { dialog = 0; return }
    message: Vec(u8)
    BuilderPrint(*message, "%\n%: %", TextUntilNul(card.title[:]), AppsLabel(language, "current_version"), TextUntilNul(card.current_version[:]))
    actions: [4]ActionModalAction
    count: s32
    valid: bool
    if dialog == 2 {
        BuilderPrint(*message, "\n%", AppsLabel(language, "choose_version"))
        for index: cast(s32)0..card.history_count - 1 {
            actions[count] = ActionModalAction.{.label = TextUntilNul(card.history[index].version[:]), .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}
            count += 1
        }
    } else {
        label := ifx dialog == 1 then "available_version" else "restore_version"
        BuilderPrint(*message, "\n%: %", AppsLabel(language, label), TextUntilNul(dialog_target.version[:]))
        if dialog == 1 { valid = card.update_available && AppsVersionEqual(*card.available, *dialog_target) }
        else {
            for index: cast(s32)0..card.history_count - 1 {
                if AppsVersionEqual(*card.history[index], *dialog_target) { valid = true }
            }
        }
        actions[count] = ActionModalAction.{.label = AppsLabel(language, ifx dialog == 1 then "update" else "rollback"),
            .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled, .disabled = !valid}
        count += 1
    }
    actions[count] = ActionModalAction.{.label = AppsLabel(language, "cancel"), .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}
    count += 1
    unused CopyCString(TextView(VecSlice(message, 0, message.count)), dialog_message[:])
    VecFree(message)
    result := ActionModal(session, ActionModalProps.{.key = cast(u64)(8 + dialog), .title = AppsLabel(language, ifx dialog == 1 then "update" else "rollback"),
            .message = TextUntilNul(dialog_message[:]), .scale = scale, .max_width = 440}, actions[:count])
    if result.action < 0 || result.action == count { dialog = 0 }
    else if result.action > 0 {
        if dialog == 2 { dialog_target = card.history[result.action - 1]; dialog = 3 }
        else if valid { AppsAct(ifx dialog == 1 then "update" else "rollback", card.id, dialog_target); dialog = 0 }
    }
}

AppsSize :: (bytes: s64, output: []u8) -> bool {
    if bytes <= 0 || bytes > 2147483647 { return false }
    value: Vec(u8)
    if bytes < 1000 { BuilderPrint(*value, "% B", bytes) }
    else {
        unit: s64 = 1000
        suffix := " kB"
        if bytes >= 999950 { unit = 1000000; suffix = " MB" }
        tenths := (bytes * 10 + unit / 2) / unit
        BuilderPrint(*value, "%.%", tenths / 10, tenths % 10)
        BuilderPrint(*value, "%", suffix)
    }
    result := CopyCString(TextView(VecSlice(value, 0, value.count)), output)
    VecFree(value)
    return result
}

AppsFrame :: () -> bool {
    action_taken = false
    session := AppSession()
    bounds := AppBounds()
    font := AppFont()
    scale := AppScale()
    if scale <= 0.0 { scale = 1.0 }
    if !AppsReadCatalog() {
        AppsText(session, cast(u64)1, bounds, AppsLabel("en", "unavailable"), font)
        return true
    }
    language := TextUntilNul(locale[:])
    if cover_grid {
        unused WidgetPaletteUse(session, AppCoversPalette())
        Box(session, BoxProps.{.key = cast(u64)50010, .bounds = bounds,
                .fill = Color.{17, 18, 35, 255}, .fill_bottom = Color.{28, 24, 46, 255}, .has_fill_bottom = true})
    }
    if request > 0 && TextUntilNul(status[:]) == "queued" {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "{\"v\":1,\"op\":\"status\",\"request\":%}", request)
        AppsResponse(AppService("apps", TextView(VecSlice(bytes, 0, bytes.count))))
        VecFree(bytes)
    }
    if cover_mode && !icon_mode && !cover_grid {
        cover_items: [4096]CarouselItem
        for index: cast(s32)0..cast(s32)cards.count - 1 {
            card := *cards[index]
            action := TextUntilNul(card.cover.action[:])
            cover_items[index] = CarouselItem.{.label = TextUntilNul(card.title[:]),
                .portrait = ifx card.cover.portrait[0] != 0 then TextUntilNul(card.cover.portrait[:]) else TextUntilNul(card.preview[:]),
                .landscape = TextUntilNul(card.cover.landscape[:]), .logo = TextUntilNul(card.cover.logo[:]),
                .caption = TextUntilNul(card.cover.caption[:]),
                .action = AppsLabel(language, ifx action != "" then action else "open"),
                .disabled = dialog != 0 || card.disabled ||
                (!AppsSupported(card, Rules.APPS_OPEN) && !(!card.on_device && AppsSupported(card, Rules.APPS_INSTALL)))}
        }
        cover_time += 1.0 / 60.0
        entered := Carousel(session, CarouselProps.{.key = cast(u64)50000, .bounds = bounds,
                .label = TextUntilNul(title[:]), .now = cover_time, .key_pressed = ifx dialog != 0 then 0 else AppKey(), .scale = scale, .dark = AppDark(),
                .previous_label = AppsLabel(language, "previous"), .next_label = AppsLabel(language, "next")},
            cover_items[:cards.count], *cover_state)
        if entered >= 0 {
            card := *cards[entered]
            if !card.on_device && AppsSupported(card, Rules.APPS_INSTALL) {
                AppsDownloadOpen(card)
            } else {
                AppsAct("open", card.id)
            }
        }
        if can_back && Button(session, ButtonProps.{.key = cast(u64)2, .label = AppsLabel(language, "back"),
                .bounds = Rectangle.{bounds.x + 12.0 * scale, bounds.y + 12.0 * scale, 84.0 * scale, 44.0 * scale},
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 { AppsAct("back", empty_target) }
        if TextUntilNul(status[:]) == "rejected" {
            AppsText(session, cast(u64)4, Rectangle.{bounds.x + 20.0 * scale, bounds.y + bounds.height - 64.0 * scale,
                    bounds.width - 40.0 * scale, 44.0 * scale}, AppsLabel(language, "rejected"), font)
        }
        AppsDialog(session, scale, language, font)
        return true
    }
    gap := (ifx cover_grid then 20.0 else 12.0) * scale
    area := bounds
    if !icon_mode {
        if can_back && Button(session, ButtonProps.{.key = cast(u64)2, .label = AppsLabel(language, "back"),
                .bounds = Rectangle.{bounds.x + gap, bounds.y + gap, 84.0 * scale, 44.0 * scale}, .fit_content = true}) != 0 {
            AppsAct("back", empty_target)
        }
        title_x := bounds.x + gap + ifx can_back then 96.0 * scale else 0.0
        AppsText(session, cast(u64)3, Rectangle.{title_x, bounds.y + gap, bounds.x + bounds.width - gap - title_x, 44.0 * scale}, TextUntilNul(title[:]), font + ifx cover_grid then 16 else 4)
        top := bounds.y + (ifx cover_grid then 92.0 else 68.0) * scale
        area = Rectangle.{bounds.x + gap, top, bounds.width - gap * 2.0, bounds.y + bounds.height - top - gap}
        // Successful actions add no persistent label or extra row.
        state_buffer := status
        state := TextUntilNul(state_buffer[:])
        if state == "rejected" {
            AppsText(session, cast(u64)4, Rectangle.{area.x, area.y, area.width, 26.0 * scale}, AppsLabel(language, "rejected"), font)
            area.y += 30.0 * scale; area.height -= 30.0 * scale
        }
    }
    columns: s32 = ifx area.width >= 440.0 * scale then 2 else 1
    card_height := 232.0 * scale
    if icon_mode {
        columns = cast(s32)((area.width + gap) / (140.0 * scale + gap))
        if columns < 1 { columns = 1 }
        if columns > 6 { columns = 6 }
        if presentation_columns >= 1 && presentation_columns <= 6 { columns = presentation_columns }
        card_height = 88.0 * scale
    }
    if list_mode {
        columns = 1
        card_height = 64.0 * scale
        gap = 4.0 * scale
    }
    if cover_grid {
        columns = cast(s32)((area.width + gap) / (200.0 * scale + gap))
        if columns < 1 { columns = 1 }
        if columns > 4 { columns = 4 }
        if cards.count > 0 && columns > cast(s32)cards.count { columns = cast(s32)cards.count }
    }
    card_width := (area.width - gap * cast(float32)(columns - 1)) / cast(float32)columns
    picture_height := 168.0 * scale
    if cover_grid {
        picture_height = card_width * (ifx bounds.height < 480.0 * scale && bounds.width > bounds.height then 2.0 / 3.0 else 1.5)
        if bounds.width > bounds.height && picture_height > area.height - 36.0 * scale {
            picture_height = area.height - 36.0 * scale
            if picture_height < 120.0 * scale { picture_height = 120.0 * scale }
        }
        card_height = picture_height + 36.0 * scale
    }
    rows := (cast(s32)cards.count + columns - 1) / columns
    opened: bool
    if !icon_mode {
        scroll := Scroll(session, ScrollProps.{.key = cast(u64)5, .bounds = area, .scale = scale,
                .content_height = rows * cast(s32)(card_height + gap), .scroll_offset = scroll_offset})
        scroll_offset = scroll.scroll_offset
        if !scroll.opened { return true }
        area = scroll.content
        opened = true
    }
    if cards.count == 0 { AppsText(session, cast(u64)6, area, AppsLabel(language, "empty"), font) }
    for index: cast(s32)0..cast(s32)cards.count - 1 {
        card := *cards[index]
        position := index
        section_y: float32
        if icon_mode && has_section_break && index >= section_break {
            position -= section_break
            section_y = cast(float32)((section_break + columns - 1) / columns) * (card_height + gap) + 36.0 * scale
        }
        x := area.x + cast(float32)(position % columns) * (card_width + gap)
        y := area.y + cast(float32)(position / columns) * (card_height + gap) + section_y
        key := Rules.AppCardKey(TextUntilNul(card.id[:]))
        tile := ButtonProps.{.key = key, .label = TextUntilNul(card.title[:]), .class_name = tile_class,
            .bounds = Rectangle.{x, y, card_width, card_height}, .disabled = card.disabled,
            .selected = card.selected, .fit_content = true, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}
        if card.selected { tile.tone = cast(ButtonTone)ButtonToneAccent; tile.emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled }
        download_first := !card.on_device && AppsSupported(card, Rules.APPS_INSTALL)
        tile.disabled = tile.disabled || (!AppsSupported(card, Rules.APPS_OPEN) && !download_first)
        activated: bool
        if cover_grid { tile.invisible = true; activated = Button(session, tile) != 0 }
        if icon_mode {
            tile.icon_shape = TextUntilNul(card.icon_shape[:])
            tile.image = ImageProps.{.asset_path = TextUntilNul(card.icon[:]), .alt_text = TextUntilNul(card.title[:])}
            tile.icon_placement = cast(IconPlacement)(ifx list_mode then IconPlacementLeading else IconPlacementAbove)
            if list_mode {
                tile.content_alignment = cast(ContentAlignment)ContentAlignmentStart
                tile.bounds.width -= 48.0 * scale
                if has_reorder_handles {
                    tile.bounds.x += 44.0 * scale
                    tile.bounds.width -= 44.0 * scale
                }
            }
        } else {
            fill := ifx AppDark() then Color.{33, 47, 44, 255} else Color.{249, 252, 250, 255}
            if !cover_grid {
                unused Box(session, BoxProps.{.key = key + cast(u64)1, .bounds = tile.bounds, .radius = 12.0 * scale, .fill = fill})
            }
            preview := TextUntilNul(card.preview[:])
            if cover_grid && card.cover.portrait[0] != 0 {
                preview = TextUntilNul(card.cover.portrait[:])
                if bounds.height < 480.0 * scale && bounds.width > bounds.height && card.cover.landscape[0] != 0 {
                    preview = TextUntilNul(card.cover.landscape[:])
                }
            }
            if preview != "" {
                Image(session, ImageProps.{.key = key + cast(u64)2, .asset_path = preview, .alt_text = TextUntilNul(card.title[:]),
                        .class_name = ifx cover_grid then image_class else 0,
                        .bounds = ifx cover_grid then Rectangle.{x, y, card_width, picture_height} else Rectangle.{x + gap, y + gap, card_width - gap * 2.0, picture_height},
                        .radius = ifx cover_grid then 20.0 * scale else 0.0,
                        .fit = ifx cover_grid then ImageFit.ImageFitCover else ImageFit.ImageFitContain, .smooth = true})
            }
            if cover_grid && card.cover.logo[0] != 0 {
                logo_width := card_width - gap * 4.0
                Image(session, ImageProps.{.key = key + cast(u64)8, .asset_path = TextUntilNul(card.cover.logo[:]),
                        .alt_text = TextUntilNul(card.title[:]), .smooth = true, .fit = ImageFit.ImageFitContain,
                        .bounds = Rectangle.{x + gap * 2.0, y + gap * 2.0, logo_width, logo_width * 0.36}})
            }
            title_y := ifx cover_grid then y + picture_height + 10.0 * scale else y + 188.0 * scale
            if !cover_grid {
                AppsText(session, key + cast(u64)3, Rectangle.{x + 4.0 * scale, title_y, card_width - 8.0 * scale, 32.0 * scale}, TextUntilNul(card.title[:]), font + 2)
            }
            if cover_grid && !card.on_device && !hide_sizes {
                size_text: [32]u8
                if AppsSize(card.bytes, size_text[:]) {
                    Text(session, TextProps.{.key = key + cast(u64)9, .text = TextUntilNul(size_text[:]),
                            .font = cast(s32)(14.0 * scale), .class_name = muted_class,
                            .bounds = Rectangle.{x + 4.0 * scale, title_y, card_width - 8.0 * scale, 20.0 * scale},
                            .wrap = cast(TextWrap)TextWrapNone})
                }
            }
            tile.invisible = true
        }
        list_size: [32]u8
        if list_mode {
            if card.downloading { tile.detail = AppsLabel(language, "downloading") }
            else if !card.on_device && !hide_sizes && AppsSize(card.bytes, list_size[:]) { tile.detail = TextUntilNul(list_size[:]) }
        }
        // An app not on this device opens its download dialog instead of a
        // screen that has nothing to show yet.
        if !cover_grid { activated = Button(session, tile) != 0 }
        if activated {
            if download_first { AppsDownloadOpen(card) }
            else { AppsAct("open", card.id) }
        }
        if icon_mode && card.reorderable {
            unused Button(session, ButtonProps.{.key = Rules.AppReorderKey(TextUntilNul(card.id[:])),
                    .label = AppsLabel(language, "move_app"), .icon_shape = APP_REORDER,
                    .icon_only = true, .disabled = card.disabled, .class_name = action_class,
                    .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost,
                    .bounds = Rectangle.{x, y + (ifx list_mode then 10.0 * scale else 0.0), 44.0 * scale, 44.0 * scale}})
        }
        if icon_mode {
            size_text: [32]u8
            if card.downloading {
                unused CopyCString(AppsLabel(language, "downloading"), size_text[:])
            }
            if !list_mode && (card.downloading || (!card.on_device && !hide_sizes && AppsSize(card.bytes, size_text[:]))) {
                Text(session, TextProps.{.key = key + cast(u64)4, .text = TextUntilNul(size_text[:]), .font = cast(s32)(11.0 * scale),
                        .bounds = Rectangle.{x + 8.0 * scale, y + card_height - 16.0 * scale, card_width - 16.0 * scale, 12.0 * scale},
                        .wrap = cast(TextWrap)TextWrapNone, .align = cast(TextAlign)TextAlignCenter, .class_name = muted_class})
            }
        }
        action := ButtonProps.{.key = key + cast(u64)5, .label = AppsLabel(language, "options"), .icon_shape = APP_ELLIPSIS,
            .icon_only = true, .class_name = action_class, .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost,
            .bounds = Rectangle.{x + card_width - 40.0 * scale, y + (ifx list_mode then 14.0 * scale else 4.0 * scale), 36.0 * scale, 36.0 * scale},
            .disabled = card.disabled, .fit_content = true}
        if cover_grid { action.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft; action.circle = true }
        if card.selected { action.tone = cast(ButtonTone)ButtonToneAccent }
        if !card.on_device {
            action.label = AppsLabel(language, "download")
            action.icon_shape = APP_DOWNLOAD
            // While it downloads, the same symbol shows the progress again.
            action.disabled = card.disabled || !AppsSupported(card, Rules.APPS_INSTALL)
            if Button(session, action) != 0 { AppsDownloadOpen(card) }
        } else if Button(session, action) != 0 {
            menu_id = card.id; menu_x = action.bounds.x; menu_y = action.bounds.y + action.bounds.height
            // Opening the menu shows its Update entry, so the dot has been seen.
            if card.update_available && !card.update_seen && AppsSupported(card, Rules.APPS_SEEN) {
                AppsAct("seen", card.id, card.available)
            }
        }
        // An update not yet installed or seen marks the options with a dot.
        if card.update_available && !card.update_seen {
            dot := 8.0 * scale
            unused Box(session, BoxProps.{.key = key + cast(u64)6, .radius = dot * 0.5, .fill = Color.{163, 98, 0, 255},
                    .bounds = Rectangle.{action.bounds.x + action.bounds.width - dot - 6.0 * scale, action.bounds.y + 6.0 * scale, dot, dot}})
        }
    }
    if opened { End(session) }
    AppsMenu(session, scale, language)
    AppsDialog(session, scale, language, font)
    return true
}

#program_export
Main :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY { AppIdentity("apps"); AppDescribe("Apps", ""); return APP_PROTOCOL }
    if mode == APP_FRAME { return ifx AppsFrame() then 0 else 1 }
    if mode == APP_COMMAND { AppReply(AppService("apps", AppCommand())) }
    return 0
}

AppsDownloadItemsClear :: (card: *AppCard) {
    item := card.downloads
    while item != null { next := item.next; free(item); item = next }
    card.downloads = null
    card.download_count = 0
}
