#import "apps/host"
#import "apps/tree"
#import "apps/protocol"
#import "apps/controller"
Launcher :: #import "apps/launcher";
UI :: #import "kryon/Widgets";
#import "std/c_string"
#import "std/bundle_host"
Node :: #import "apps/node_types";
Codec :: #import "apps/node_codec";

State :: (context: *void, account: string, identity: *AppIdentity, state: *AppState) -> bool {
    state.* = AppState.{.installed = true, .favorite = true, .launcher = 1}
    return account == "account-a"
}

Service :: (context: *void, request: string) -> string { return "{}" }
Widgets :: (context: *void, module: *u8, function: *u8, arguments: *HostValue, count: s32, result: *HostValue) -> s32 { return 0 }

VersionEffect :: (context: *void, account: string, locator: *AppLocator, request: *AppsRequest, reply: *AppsReply) -> bool {
    reply.status = APPS_APPLIED
    return account == "account-a" && request.operation == APPS_UPDATE
}

OpenEffect :: (context: *void, account: string, locator: *AppLocator, request: *AppsRequest, reply: *AppsReply) -> s32 {
    return ifx account == "account-a" && request.operation == APPS_OPEN then APP_OPEN_HANDLED else APP_OPEN_REJECTED
}

// Independent public imports must use the same Kryon package identity.
TypedScreen :: (session: UI.Session, bounds: UI.Rectangle, fill: UI.Color) -> bool {
    frame := Node.AppUiFrame.{.session = session}
    state: Launcher.AppLauncherState
    props := Launcher.AppLauncherProps.{.bounds = bounds, .scale = 1.0, .locale = "en"}
    shared_fill: Launcher.Color = fill
    items: [1]Launcher.AppLauncherItem
    unused Launcher.AppLauncherScreen(frame.session, *state, props, items[:])
    return shared_fill.a == 255
}

#program_export
Check :: () -> s32 {
    platform := AppPlatform.{.host_api = 41, .state = State, .version_effect = VersionEffect, .open_effect = OpenEffect,
        .presentation = AppPresentation.{.icon = true, .hide_sizes = true, .tile_class = 501}}
    identity: AppIdentity
    state: AppState
    if !platform.state(null, "account-a", *identity, *state) || !state.installed || !state.favorite || state.launcher != 1 { return 1 }
    request := AppsRequest.{.operation = APPS_UPDATE}
    locator: AppLocator
    reply: AppsReply
    if !platform.version_effect(null, "account-a", *locator, *request, *reply) || reply.status != APPS_APPLIED ||
    !platform.presentation.icon || !platform.presentation.hide_sizes ||
    AppCardKey("native.clock") == AppCardKey("native.breathing") { return 5 }
    open := AppsRequest.{.operation = APPS_OPEN}
    if platform.open_effect(null, "account-a", *locator, *open, *reply) != APP_OPEN_HANDLED ||
    platform.open_effect(null, "account-b", *locator, *open, *reply) != APP_OPEN_REJECTED { return 6 }
    runtime: AppRuntime
    runtime.legacy.message = Node.AppMessage.{.signed_in = true}
    runtime.legacy.frame = Node.AppUiFrame.{.width = 800}
    codec: Codec.WidgetAppPersonCodec
    if runtime.legacy.frame.width != 800 || !runtime.legacy.message.signed_in { return 2 }
    host: AppHost
    if AppHostActiveRuntime(*host) != null || AppHostBack(*host) != -1 { return 3 }
    if AppHostAtLocator(*host, *locator) || AppHostOpenLocator(*host, *locator) != -1 { return 7 }
    AppHostCancelLocator(*host)
    controller: AppController
    controller_platform := AppControllerPlatform.{.service = Service, .widgets = Widgets}
    if AppControllerOpen(*controller, "bad", "bad", controller_platform) || AppControllerRun(*controller, 2) || !AppControllerClose(*controller) { return 4 }
    launcher: Launcher.AppLauncherState
    items: [3]Launcher.AppLauncherItem = .[
    .{.title = "Clock", .search = "time"},
    .{.title = "Écrire", .favorite = true},
    .{.title = "Calculator", .search = "math"}]
    Launcher.AppLauncherFilter(*launcher, items[:])
    if launcher.count != 3 || launcher.favorites != 1 || launcher.visible[0] != 1 ||
    launcher.visible[1] != 0 || launcher.visible[2] != 2 { return 8 }
    unused CopyCString("MATH", launcher.query[:])
    Launcher.AppLauncherFilter(*launcher, items[:])
    if launcher.count != 1 || launcher.visible[0] != 2 || launcher.favorites != 0 { return 9 }
    if !Launcher.AppLauncherMatches("Écrire", "éC") || Launcher.AppLauncherMatches("Clock", "other") { return 10 }
    // Type-check TypedScreen above without linking a graphical test host.
    frame := Node.AppUiFrame.{.session = UI.Session.{.slot = 3, .epoch = cast(u64)7}}
    props := Launcher.AppLauncherProps.{.bounds = UI.Rectangle.{0.0, 0.0, 800.0, 600.0}}
    fill: Launcher.Color = UI.Color.{1, 2, 3, 255}
    if frame.session.slot != 3 || frame.session.epoch != cast(u64)7 ||
    props.bounds.width != 800.0 || fill.a != 255 { return 11 }
    return 0
}
