#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"
#import, file "protocol.zi";

APP_MANIFEST_BYTE_LIMIT :: 1048576
APP_CATALOG_ENTRY_LIMIT :: 4096
APP_DEPENDENCY_LIMIT :: 8
APP_RESOURCE_LINK_LIMIT :: 16

AppResourceLink :: struct {
    dependency: s32
    path: [512]u8
    source: [512]u8
    next: *AppResourceLink
}


AppEntry :: struct {
    id: [128]u8
    title: [256]u8
    bundle: [512]u8
    preview: [512]u8
    icon: [512]u8
    icon_shape: [16384]u8
    expected_id: [128]u8
    version: [64]u8
    sha256: [65]u8
    protocol: s32
    bytes: s64
    cover: AppCover
    dependency_count: s32
    shared_code: bool
    dependencies: [APP_DEPENDENCY_LIMIT][128]u8
    resource_count: s32
    // Catalog owns these links; a routed entry borrows them from its parent.
    resources: *AppResourceLink
}


AppCatalog :: struct {
    id: [128]u8
    title: [256]u8
    harness: [512]u8
    children: *AppCatalogItem
    tail: *AppCatalogItem
    count: s64
    cover_grid: bool
    // The children's cover, preview and icon art, when it travels as one
    // separate ZX the platform downloads like a child instead of in the
    // collection's own bundle.
    art_sha256: [65]u8
    art_bytes: s64
}

AppCatalogItem :: struct { entry: AppEntry; next: *AppCatalogItem }

AppEntryProtocol :: (text: string) -> s32 {
    if text == "app/1" { return APPS_CONTEXT_PROTOCOL }
    if text == "node/2" { return APPS_NODE_PROTOCOL }
    if text == "collection/1" { return APPS_COLLECTION_PROTOCOL }
    return 0
}

AppCatalogFind :: (catalog: *AppCatalog, id: string) -> s64 {
    item := catalog.children
    index: s64 = 0
    while item != null {
        if TextUntilNul(item.entry.id[:]) == id { return index }
        item = item.next
        index += 1
    }
    return -1
}

AppCatalogAt :: (catalog: *AppCatalog, at: s64) -> *AppEntry {
    if at < 0 || at >= catalog.count { return null }
    item := catalog.children
    for index: cast(s64)0..at - 1 { item = item.next }
    return *item.entry
}

AppCatalogAppend :: (catalog: *AppCatalog, entry: AppEntry) -> bool {
    item := New(AppCatalogItem)
    if item == null { return false }
    item.entry = entry
    if catalog.tail != null { catalog.tail.next = item }
    else { catalog.children = item }
    catalog.tail = item
    catalog.count += 1
    return true
}

AppCatalogClear :: (catalog: *AppCatalog) {
    item := catalog.children
    while item != null { next := item.next; AppEntryResourcesClear(*item.entry); free(item); item = next }
    catalog.* = AppCatalog.{}
}

AppReadEntry :: (text: string, at: s32, entry: *AppEntry) -> bool {
    keys: [15]string = .["id", "title", "bundle", "protocol", "expected_id", "version", "sha256", "preview", "icon", "icon_shape", "cover", "bytes", "dependencies", "resources", "shared_code"]
    if !AppsObjectValid(text, at, keys[:]) { return false }
    parsed: AppEntry
    protocol: [32]u8
    if !AppsReadText(text, at, "id", parsed.id[:]) || !AppIdValid(TextUntilNul(parsed.id[:])) ||
    !AppsReadText(text, at, "title", parsed.title[:]) || TextUntilNul(parsed.title[:]) == "" ||
    !AppsReadText(text, at, "bundle", parsed.bundle[:]) || !AppBundlePathValid(TextUntilNul(parsed.bundle[:])) ||
    !AppsReadText(text, at, "expected_id", parsed.expected_id[:]) || !AppIdValid(TextUntilNul(parsed.expected_id[:])) ||
    !AppsReadText(text, at, "version", parsed.version[:]) || TextUntilNul(parsed.version[:]) == "" ||
    !AppsReadText(text, at, "sha256", parsed.sha256[:]) || !AppDigestValid(TextUntilNul(parsed.sha256[:])) ||
    !AppsReadText(text, at, "protocol", protocol[:]) { return false }
    parsed.protocol = AppEntryProtocol(TextUntilNul(protocol[:]))
    if parsed.protocol == 0 { return false }
    if FieldAt(text, at, "bytes") >= 0 {
        size := ReadNumber(text, FieldAt(text, at, "bytes"))
        if !size.valid || size.value < 1.0 || size.value > 67108864.0 { return false }
        parsed.bytes = cast(s64)size.value
        if cast(float64)parsed.bytes != size.value { return false }
    }
    if FieldAt(text, at, "preview") >= 0 {
        if !AppsReadText(text, at, "preview", parsed.preview[:]) { return false }
        preview := TextUntilNul(parsed.preview[:])
        if preview != "" && !AppPreviewPathValid(preview) { return false }
    }
    if FieldAt(text, at, "icon") >= 0 {
        if !AppsReadText(text, at, "icon", parsed.icon[:]) { return false }
        icon := TextUntilNul(parsed.icon[:])
        if icon != "" && !AppPreviewPathValid(icon) { return false }
    }
    if FieldAt(text, at, "icon_shape") >= 0 && !AppsReadText(text, at, "icon_shape", parsed.icon_shape[:]) { return false }
    cover := FieldAt(text, at, "cover")
    if cover >= 0 {
        cover_keys: [5]string = .["portrait", "landscape", "logo", "caption", "action"]
        if !AppsObjectValid(text, cover, cover_keys[:]) ||
        !AppsReadText(text, cover, "portrait", parsed.cover.portrait[:]) ||
        !AppPreviewPathValid(TextUntilNul(parsed.cover.portrait[:])) { return false }
        if FieldAt(text, cover, "landscape") >= 0 &&
        (!AppsReadText(text, cover, "landscape", parsed.cover.landscape[:]) ||
            !AppPreviewPathValid(TextUntilNul(parsed.cover.landscape[:]))) { return false }
        if FieldAt(text, cover, "logo") >= 0 &&
        (!AppsReadText(text, cover, "logo", parsed.cover.logo[:]) ||
            !AppPreviewPathValid(TextUntilNul(parsed.cover.logo[:]))) { return false }
        if FieldAt(text, cover, "caption") >= 0 && !AppsReadText(text, cover, "caption", parsed.cover.caption[:]) { return false }
        if FieldAt(text, cover, "action") >= 0 && !AppsReadText(text, cover, "action", parsed.cover.action[:]) { return false }
    }
    if !AppReadDependencies(text, at, *parsed) { AppEntryResourcesClear(*parsed); return false }
    entry.* = parsed
    return true
}

// Build a candidate first: rejection never replaces the visible collection.
AppCatalogRead :: (text: string, expected_id: string, catalog: *AppCatalog) -> bool {
    if text.count > APP_MANIFEST_BYTE_LIMIT || Space(text, ValueEnd(text, 0, 0)) != text.count { return false }
    keys: [7]string = .["schema", "id", "title", "harness", "children", "presentation", "art"]
    if !AppsObjectValid(text, 0, keys[:]) { return false }
    schema := ReadNumber(text, FieldAt(text, 0, "schema"))
    if !schema.valid || schema.value != 1.0 { return false }
    parsed: AppCatalog
    presentation := FieldAt(text, 0, "presentation")
    if presentation >= 0 {
        fields: [1]string = .["mode"]
        mode: [16]u8
        if !AppsObjectValid(text, presentation, fields[:]) ||
        !AppsReadText(text, presentation, "mode", mode[:]) || TextUntilNul(mode[:]) != "covers" { return false }
        parsed.cover_grid = true
    }
    art := FieldAt(text, 0, "art")
    if art >= 0 {
        fields: [2]string = .["sha256", "bytes"]
        size := ReadNumber(text, FieldAt(text, art, "bytes"))
        if !AppsObjectValid(text, art, fields[:]) || !AppsReadText(text, art, "sha256", parsed.art_sha256[:]) ||
        !AppDigestValid(TextUntilNul(parsed.art_sha256[:])) || !size.valid || size.value < 8.0 ||
        size.value > 67108864.0 || cast(float64)cast(s64)size.value != size.value { return false }
        parsed.art_bytes = cast(s64)size.value
    }
    if !AppsReadText(text, 0, "id", parsed.id[:]) || TextUntilNul(parsed.id[:]) != expected_id ||
    !AppIdValid(expected_id) || !AppsReadText(text, 0, "title", parsed.title[:]) ||
    TextUntilNul(parsed.title[:]) == "" || !AppsReadText(text, 0, "harness", parsed.harness[:]) ||
    !AppBundlePathValid(TextUntilNul(parsed.harness[:])) { return false }
    children := FieldAt(text, 0, "children")
    count := ArrayCount(text, children)
    if count < 0 || count > APP_CATALOG_ENTRY_LIMIT { return false }
    cursor := Space(text, children + 1)
    for index: cast(s32)0..count - 1 {
        entry: AppEntry
        if !AppReadEntry(text, cursor, *entry) {
            AppCatalogClear(*parsed)
            return false
        }
        if AppCatalogFind(*parsed, TextUntilNul(entry.id[:])) >= 0 ||
        TextUntilNul(entry.id[:]) == expected_id || !AppCatalogAppend(*parsed, entry) {
            AppEntryResourcesClear(*entry)
            AppCatalogClear(*parsed)
            return false
        }
        cursor = Space(text, ValueEnd(text, cursor, 0))
        if index + 1 < count { cursor = Space(text, cursor + 1) }
    }
    if !AppCatalogDependenciesValid(*parsed) {
        AppCatalogClear(*parsed)
        return false
    }
    AppCatalogClear(catalog)
    catalog.* = parsed
    return true
}

// Resource links grant read-only access to explicit prefixes of a sibling
// whose exact bundle digest is fixed by the same signed collection.
AppPathPrefix :: (path: string, prefix: string) -> bool {
    return prefix.count > 0 && path.count >= prefix.count && path[:prefix.count] == prefix
}

AppResourcePrefixValid :: (path: string, name: string) -> bool {
    end := 7 + name.count
    if path.count <= end + 1 || path[:7] != "assets/" || path[7:end] != name || path[end] != #char "/" { return false }
    return AppAssetPathValid(ifx path[path.count - 1] == #char "/" then path[:path.count - 1] else path)
}

AppReadDependencies :: (text: string, at: s32, entry: *AppEntry) -> bool {
    dependencies := FieldAt(text, at, "dependencies")
    if dependencies >= 0 {
        count := ArrayCount(text, dependencies)
        if count < 1 || count > APP_DEPENDENCY_LIMIT { return false }
        for index: cast(s32)0..count - 1 {
            if ReadStringText(text, ElementAt(text, dependencies, index), entry.dependencies[index][:]) < 0 { return false }
            id := TextUntilNul(entry.dependencies[index][:])
            if !AppIdValid(id) || id == TextUntilNul(entry.id[:]) { return false }
            for previous: cast(s32)0..index - 1 {
                if TextUntilNul(entry.dependencies[previous][:]) == id { return false }
            }
        }
        entry.dependency_count = cast(s32)count
    }
    code := FieldAt(text, at, "shared_code")
    if code >= 0 {
        value := text[code:ValueEnd(text, code, 0)]
        if value != "true" && value != "false" { return false }
        entry.shared_code = value == "true"
        if entry.shared_code && entry.dependency_count == 0 { return false }
    }
    links := FieldAt(text, at, "resources")
    if links < 0 { return true }
    count := ArrayCount(text, links)
    if count < 1 || count > APP_RESOURCE_LINK_LIMIT || entry.dependency_count == 0 { return false }
    fields: [3]string = .["dependency", "path", "source"]
    for index: cast(s32)0..count - 1 {
        row := ElementAt(text, links, index)
        id: [128]u8
        link: AppResourceLink
        if !AppsObjectValid(text, row, fields[:]) || !AppsReadText(text, row, "dependency", id[:]) ||
        !AppsReadText(text, row, "path", link.path[:]) || !AppsReadText(text, row, "source", link.source[:]) ||
        !AppResourcePrefixValid(TextUntilNul(link.path[:]), TextUntilNul(entry.expected_id[:])) { return false }
        link.dependency = -1
        for dependency: cast(s32)0..entry.dependency_count - 1 {
            if TextUntilNul(entry.dependencies[dependency][:]) == TextUntilNul(id[:]) { link.dependency = dependency }
        }
        if link.dependency < 0 { return false }
        for previous: cast(s32)0..index - 1 {
            previous_link := AppResourceAt(entry, previous)
            before := TextUntilNul(previous_link.path[:])
            path := TextUntilNul(link.path[:])
            if AppPathPrefix(path, before) || AppPathPrefix(before, path) { return false }
        }
        stored := New(AppResourceLink)
        if stored == null { return false }
        stored.* = link
        if entry.resources == null { entry.resources = stored }
        else { tail := AppResourceAt(entry, index - 1); tail.next = stored }
        entry.resource_count += 1
    }
    entry.resource_count = cast(s32)count
    return true
}

AppDependencyVisit :: (catalog: *AppCatalog, index: s64, marks: []u8, depth: s32) -> bool {
    if depth > 32 || marks[index] == 1 { return false }
    if marks[index] == 2 { return true }
    marks[index] = 1
    entry := AppCatalogAt(catalog, index)
    for dependency: cast(s32)0..entry.dependency_count - 1 {
        found := AppCatalogFind(catalog, TextUntilNul(entry.dependencies[dependency][:]))
        if found < 0 || !AppDependencyVisit(catalog, found, marks, depth + 1) { return false }
    }
    for index: cast(s32)0..entry.resource_count - 1 {
        link := AppResourceAt(entry, index)
        dependency := AppCatalogAt(catalog, AppCatalogFind(catalog, TextUntilNul(entry.dependencies[link.dependency][:])))
        if !AppResourcePrefixValid(TextUntilNul(link.source[:]), TextUntilNul(dependency.expected_id[:])) { return false }
    }
    marks[index] = 2
    return true
}

AppCatalogDependenciesValid :: (catalog: *AppCatalog) -> bool {
    marks: [APP_CATALOG_ENTRY_LIMIT]u8
    for index: cast(s64)0..catalog.count - 1 {
        if !AppDependencyVisit(catalog, index, marks[:], 0) { return false }
    }
    return true
}

AppResourceAt :: (entry: *AppEntry, index: s32) -> *AppResourceLink {
    link := entry.resources
    for at: cast(s32)0..index - 1 {
        if link == null { return null }
        link = link.next
    }
    return link
}

AppEntryResourcesClear :: (entry: *AppEntry) {
    link := entry.resources
    while link != null { next := link.next; free(link); link = next }
    entry.resources = null
    entry.resource_count = 0
}
