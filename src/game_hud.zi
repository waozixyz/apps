// Shared game presentation data. The caller owns translations, balance and routes.
#import "kryon/geometry"

AppGameHudProps :: struct {
    bounds: Rectangle
    key: u64
    dew_text: string
    profile_label: string
    dew_label: string
    // Empty paths use the shared assets/hud/ thumbnails.
    profile_image: string
    dew_image: string
}

// Optional host navigation. Standalone games simply do not compose this.
AppGameHomeProps :: struct {
    key: u64
    bounds: Rectangle
    label: string
}
