// Shared painted game actions. The caller owns translations, balance and routes.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/image_widget"
#import "kryon/image_props"
#import "kryon/button_widget"
#import "kryon/button_props"
#import "kryon/text_widget"
#import "kryon/text_props"
#import "kryon/text_align"
#import "kryon/box_widget"
#import "kryon/box_props"
#import "kryon/drawing_props"
#import "kryon/widget_palette"

AppGameHudProps :: struct {
    bounds: Rectangle
    key: u64
    dew_text: string
    profile_label: string
    dew_label: string
    // Empty paths use the shared assets/hud/ thumbnails.
    profile_image: string
    dew_image: string
}

// Reserves key..key+7. Returns 0, 1 (Profile), or 2 (Dew).
// The caller positions the bounds at the top right of its game viewport.
#program_export
AppGameHud :: (session: Session, props: AppGameHudProps) -> s32 {
    area := props.bounds
    if area.width <= 0.0 || area.height <= 0.0 { return 0 }
    unused WidgetPaletteUse(session, WidgetPalette.{.background = 0x111316ff,
        .base = 0x2a2722ff, .text = 0xffeec1ff, .selected = 0xad843eff,
        .selected_text = 0xffeec1ff, .border = 0x66522bff, .danger = 0xdc655bff,
        .warning = 0xdeb56dff, .success = 0x79b18bff})
    defer { unused WidgetPaletteRestore(session) }
    if area.height > 64.0 { area.height = 64.0 }
    pad := area.height * 0.12
    if pad > area.width * 0.04 { pad = area.width * 0.04 }
    size := area.height - pad * 2.0
    if size > area.width * 0.22 { size = area.width * 0.22 }
    bevel := pad * 0.25
    unused Box(session, BoxProps.{.key = props.key + 5, .bounds = area,
        .fill = Color.{222, 188, 109, 255}, .fill_bottom = Color.{84, 57, 26, 255},
        .has_fill_bottom = true, .border = Color.{239, 211, 146, 255}, .radius = area.height * 0.2})
    unused Box(session, BoxProps.{.key = props.key + 6,
        .bounds = Rectangle.{area.x + bevel, area.y + bevel, area.width - bevel * 2.0, area.height - bevel * 2.0},
        .fill = Color.{42, 39, 34, 255}, .fill_bottom = Color.{17, 19, 22, 255},
        .has_fill_bottom = true, .border = Color.{102, 78, 43, 255}, .radius = area.height * 0.18})
    profile := Rectangle.{area.x + area.width - pad - size, area.y + (area.height - size) / 2.0, size, size}
    unused Box(session, BoxProps.{.key = props.key + 7,
        .bounds = Rectangle.{profile.x - bevel, profile.y - bevel, size + bevel * 2.0, size + bevel * 2.0},
        .fill = Color.{173, 132, 62, 255}, .border = Color.{238, 209, 142, 255}, .radius = size / 2.0 + bevel})
    unused Image(session, ImageProps.{.key = props.key + 1, .bounds = profile,
        .asset_path = ifx props.profile_image.count > 0 then props.profile_image else "assets/hud/profile.webp",
        .preview_path = "assets/hud/profile.webp",
        .fit = ImageFit.ImageFitContain, .smooth = true, .radius = size / 2.0})
    profile_action := Button(session, ButtonProps.{.key = props.key, .bounds = profile,
        .label = props.profile_label, .invisible = true, .circle = true})
    jewel := Rectangle.{area.x + pad, profile.y, size, size}
    unused Image(session, ImageProps.{.key = props.key + 3, .bounds = jewel,
        .asset_path = ifx props.dew_image.count > 0 then props.dew_image else "assets/hud/dew.webp",
        .preview_path = "assets/hud/dew.webp",
        .fit = ImageFit.ImageFitContain, .smooth = true})
    text_x := jewel.x + size + pad * 0.5
    unused Text(session, TextProps.{.key = props.key + 4,
        .bounds = Rectangle.{text_x, area.y, profile.x - pad - text_x, area.height},
        .text = props.dew_text, .font = 18,
        .vertical_align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapEllipsis})
    dew_action := Button(session, ButtonProps.{.key = props.key + 2,
        .bounds = Rectangle.{area.x, area.y, profile.x - pad * 0.5 - area.x, area.height},
        .label = props.dew_label, .invisible = true})
    if profile_action != 0 { return 1 }
    if dew_action != 0 { return 2 }
    return 0
}
