// Navigation and effects execute at a host boundary, never from a guest's
// foreign callback. There is no hierarchy-sized native/VM call stack.
#import "std/vec"
#import "std/option"
#import "std/c_string"
#import "std/text_buffer"
#import, file "protocol.zi";
#import, file "catalog.zi";

AppHandle :: struct { slot: s64; generation: s64 }

AppLocation :: struct {
    id: [128]u8
    sha256: [65]u8
}

// Persistent locators contain verified identities/revisions, never slots.
AppLocator :: struct {
    identity: AppIdentity
    chain: Vec(AppLocation)
}

AppNode :: struct {
    identity: AppIdentity
    entry: AppEntry
    catalog: AppCatalog
    runtime: *void
    parent: AppHandle
    generation: s64
    bytes: s64
    collection: bool
    account: [256]u8
    account_epoch: s64
    // Navigation context only. An add-on remains a sibling for identity,
    // verification, dependency resolution and persistent locators.
    return_to: AppHandle
    return_epoch: s64
    return_account: [256]u8
    return_target: [128]u8
    return_digest: [65]u8
}

// Open must read the exact parent-contained asset, verify its SHA-256 and
// provenance, enforce capabilities/protocol, and complete expected_id's
// handshake before publishing this candidate. It owns returned bundle bytes.
AppProviderOpen :: #type (context: *void, parent: *AppNode, entry: *AppEntry, candidate: *AppNode) -> bool;
// Optional preparation before save/open: 0 keeps the request queued, 1 is
// ready, and any other result rejects it. No navigation or effects run while
// preparation is pending. The sequence identifies the exact queued request.
AppProviderPrepare :: #type (context: *void, parent: *AppNode, entry: *AppEntry, sequence: s64) -> s32;
AppProviderSave :: #type (context: *void, node: *AppNode) -> bool;
AppProviderClose :: #type (context: *void, node: *AppNode) -> void;
// Effects are atomic in account storage. Uninstall preserves saved records
// and cached payload. OS shortcut requests may return QUEUED with a receipt.
AppProviderEffect :: #type (context: *void, account: string, locator: *AppLocator,
    operation: s32, reply: *AppsReply) -> bool;

// The provider revalidates the exact version/digest, identity and current
// account at drain. A guest request cannot authorize a downgrade by itself.
AppProviderVersionEffect :: #type (context: *void, account: string, locator: *AppLocator,
    request: *AppsRequest, reply: *AppsReply) -> bool;

// Optional native OPEN decision. Unknown values reject.
APP_OPEN_REJECTED :: 0
APP_OPEN_DECLARED :: 1
APP_OPEN_HANDLED :: 2

// Runs at drain only after the caller saved and the declared child verified.
// locator names that exact verified chain; it and request are borrowed for
// this call, and reply.request is the guest's sequence. DECLARED navigates to
// the child. HANDLED copies the target for native staging after Run returns;
// REJECTED refuses it. Both keep the caller active and dispose only the
// temporary child. A HANDLED reply stays queued with the provider's receipt.
AppProviderOpenEffect :: #type (context: *void, account: string, locator: *AppLocator,
    request: *AppsRequest, reply: *AppsReply) -> s32;

// Install or uninstall of a child that is not on the device, such as a game
// its collection only declares: the provider downloads or removes it without
// opening it. False leaves the request to the verified path below.
AppProviderFetch :: #type (context: *void, account: string, parent: *AppNode,
    entry: *AppEntry, operation: s32, reply: *AppsReply) -> bool;

// Shared host only: detect missing content, then present ordinary collection
// consent after the current game saved. Neither callback downloads or runs a guest.
AppProviderAddonMissing :: #type (context: *void, parent: *AppNode, entry: *AppEntry, sequence: s64) -> bool;

AppProvider :: struct {
    context: *void
    open: AppProviderOpen
    prepare: AppProviderPrepare
    save: AppProviderSave
    close: AppProviderClose
    effect: AppProviderEffect
    version_effect: AppProviderVersionEffect
    open_effect: AppProviderOpenEffect
    fetch: AppProviderFetch
    addon_missing: AppProviderAddonMissing
    addon_present: AppProviderAddonMissing
}

AppPending :: struct {
    caller: AppHandle
    request: AppsRequest
    reply: AppsReply
    account_epoch: s64
    complete: bool
    addon: bool
    consent: bool
    owner: AppHandle
    digest: [65]u8
    account: [256]u8
}

AppSlot :: struct { node: *AppNode }

AppTree :: struct {
    nodes: Vec(AppSlot)
    pending: Vec(AppPending)
    active: AppHandle
    running: AppHandle
    provider: AppProvider
    account: [256]u8
    account_epoch: s64
    sequence: s64
    bytes: s64
    byte_limit: s64
    pending_limit: s64
    generation: s64
    busy: bool
    draining: bool
}

AppHandleEqual :: (left: AppHandle, right: AppHandle) -> bool {
    return left.slot == right.slot && left.generation == right.generation
}

AppTreeNode :: (tree: *AppTree, handle: AppHandle) -> *AppNode {
    if handle.slot < 0 || handle.slot >= tree.nodes.count || handle.generation < 1 { return null }
    node := tree.nodes[handle.slot].node
    if node == null || node.generation != handle.generation { return null }
    return node
}

AppTreeStart :: (tree: *AppTree, root: *AppNode, account: string,
    provider: AppProvider, byte_limit: s64 = 67108864, pending_limit: s64 = 256) -> bool {
    if tree.nodes.count != 0 || root == null || root.runtime == null ||
    account == "" || !CopyCString(account, tree.account[:]) ||
    TextUntilNul(root.identity.authority[:]) == "" || !AppIdValid(TextUntilNul(root.identity.id[:])) ||
    provider.open == null || provider.save == null || provider.close == null || provider.effect == null ||
    root.bytes < 0 || root.bytes > byte_limit || pending_limit < 1 { return false }
    root.parent = AppHandle.{-1, 0}
    root.generation = 1
    root.account = tree.account
    root.account_epoch = 1
    if !VecPush(tree.nodes, AppSlot.{root}) { return false }
    tree.provider = provider
    tree.active = AppHandle.{0, 1}
    tree.account_epoch = 1
    tree.generation = 1
    tree.bytes = root.bytes
    tree.byte_limit = byte_limit
    tree.pending_limit = pending_limit
    return true
}

AppTreeBegin :: (tree: *AppTree, handle: AppHandle) -> bool {
    if tree.busy || tree.draining || !AppHandleEqual(handle, tree.active) || AppTreeNode(tree, handle) == null { return false }
    tree.running = handle
    tree.busy = true
    return true
}

AppTreeEnd :: (tree: *AppTree, handle: AppHandle) -> bool {
    if !tree.busy || !AppHandleEqual(handle, tree.running) { return false }
    tree.busy = false
    tree.running = AppHandle.{}
    return true
}

AppRejected :: (reason: string) -> AppsReply {
    reply := AppsReply.{.status = APPS_REJECTED}
    unused CopyCString(reason, reply.reason[:])
    return reply
}

AppTreeQueueContentUpdate :: (tree: *AppTree, caller: AppHandle, entry: *AppEntry,
    state: *AppState, allowed: bool) -> bool {
    if !allowed || entry == null || state == null || !state.installed || !state.update_available ||
    !AppVersionValid(TextUntilNul(state.available_version[:])) ||
    !AppDigestValid(TextUntilNul(state.available_sha256[:])) ||
    (state.actions_known && (state.actions & (cast(u64)1 << cast(u64)APPS_UPDATE)) == cast(u64)0) {
        return false
    }
    // Catalog reads repeat while an update downloads; queue each target once.
    for index: cast(s64)0..tree.pending.count - 1 {
        pending := tree.pending[index]
        if !pending.complete && pending.request.operation == APPS_UPDATE &&
        TextUntilNul(pending.request.id[:]) == TextUntilNul(entry.id[:]) &&
        TextUntilNul(pending.request.sha256[:]) == TextUntilNul(state.available_sha256[:]) { return false }
    }
    request := AppsRequest.{.operation = APPS_UPDATE, .id = entry.id,
        .version = state.available_version, .sha256 = state.available_sha256}
    return AppTreeQueue(tree, caller, request).status == APPS_QUEUED
}

AppTreeQueue :: (tree: *AppTree, caller: AppHandle, request: AppsRequest) -> AppsReply {
    if tree.draining { return AppRejected("effects are draining") }
    node := AppTreeNode(tree, caller)
    if node == null || !AppHandleEqual(caller, tree.active) { return AppRejected("inactive caller") }
    if request.operation == APPS_STATUS {
        for index: cast(s64)0..tree.pending.count - 1 {
            pending := tree.pending[index]
            if pending.reply.request == request.request && pending.account_epoch == tree.account_epoch &&
            AppHandleEqual(pending.caller, caller) { return pending.reply }
        }
        return AppRejected("unknown request")
    }
    if request.operation < APPS_OPEN || request.operation > APPS_ROLLBACK { return AppRejected("unsupported operation") }
    if AppsVersionOperation(request.operation) && (tree.provider.version_effect == null ||
        !AppVersionValid(TextUntilNul(request.version[:])) || !AppDigestValid(TextUntilNul(request.sha256[:]))) {
        return AppRejected("version target unavailable")
    }
    if request.operation == APPS_BACK {
        if AppTreeNode(tree, node.parent) == null && AppTreeReturn(tree, node) == null { return AppRejected("already at root") }
    } else if !node.collection || AppCatalogFind(*node.catalog, TextUntilNul(request.id[:])) < 0 {
        return AppRejected("undeclared child")
    }
    pending := AppPending.{.caller = caller, .request = request}
    if request.operation != APPS_BACK && request.id[0] != 0 && node.return_epoch > 0 &&
    TextUntilNul(node.return_target[:]) == TextUntilNul(request.id[:]) {
        pending.consent = true
        pending.owner = node.return_to
        pending.digest = node.return_digest
    }
    return AppTreeEnqueue(tree, pending)
}

// A noncollection caller gets only its own explicitly declared internal
// add-on, within its original verified collection and account.
AppTreeAddon :: (tree: *AppTree, caller: AppHandle, id: string, active: bool = true) -> *AppEntry {
    node := AppTreeNode(tree, caller)
    if node == null || node.collection || (active && !AppHandleEqual(caller, tree.active)) ||
    node.account_epoch != tree.account_epoch || TextUntilNul(node.account[:]) != TextUntilNul(tree.account[:]) ||
    TextUntilNul(node.entry.cover.action[:]) == "internal" || !AppIdValid(id) { return null }
    parent := AppTreeNode(tree, node.parent)
    if parent == null || !parent.collection || parent.account_epoch != tree.account_epoch ||
    TextUntilNul(parent.account[:]) != TextUntilNul(tree.account[:]) ||
    TextUntilNul(parent.identity.authority[:]) != TextUntilNul(node.identity.authority[:]) { return null }
    source := AppCatalogAt(*parent.catalog, AppCatalogFind(*parent.catalog, TextUntilNul(node.identity.id[:])))
    target := AppCatalogAt(*parent.catalog, AppCatalogFind(*parent.catalog, id))
    if source == null || target == null || source == target ||
    TextUntilNul(source.sha256[:]) != TextUntilNul(node.entry.sha256[:]) ||
    TextUntilNul(source.expected_id[:]) != TextUntilNul(node.entry.expected_id[:]) || source.protocol != node.entry.protocol ||
    target.protocol == APPS_COLLECTION_PROTOCOL || TextUntilNul(target.cover.action[:]) != "internal" { return null }
    for index: cast(s32)0..target.dependency_count - 1 {
        if TextUntilNul(target.dependencies[index][:]) == TextUntilNul(node.identity.id[:]) { return target }
    }
    return null
}

AppTreeQueueAddon :: (tree: *AppTree, caller: AppHandle, id: string) -> AppsReply {
    if tree.draining { return AppRejected("effects are draining") }
    entry := AppTreeAddon(tree, caller, id)
    if entry == null { return AppRejected("add-on not authorized") }
    for index: cast(s64)0..tree.pending.count - 1 {
        pending := tree.pending[index]
        if !pending.complete && pending.addon && AppHandleEqual(pending.caller, caller) { return AppRejected("add-on already queued") }
    }
    node := AppTreeNode(tree, caller)
    return AppTreeEnqueue(tree, AppPending.{.caller = caller, .owner = node.parent, .addon = true,
        .digest = entry.sha256, .request = AppsRequest.{.operation = APPS_OPEN, .id = entry.id}})
}

AppTreeEnqueue :: (tree: *AppTree, pending: AppPending) -> AppsReply {
    if tree.pending.count >= tree.pending_limit {
        reclaimed := false
        for index: cast(s64)0..tree.pending.count - 1 {
            if !tree.pending[index].complete { continue }
            for next: index..tree.pending.count - 2 { tree.pending[next] = tree.pending[next + 1] }
            unused VecPop(tree.pending)
            reclaimed = true
            break
        }
        if !reclaimed { return AppRejected("request limit") }
    }
    if tree.sequence >= 2147483647 { return AppRejected("request limit") }
    tree.sequence += 1
    pending.account_epoch = tree.account_epoch
    pending.account = tree.account
    pending.reply = AppsReply.{.status = APPS_QUEUED, .request = tree.sequence}
    if !VecPush(tree.pending, pending) { return AppRejected("request allocation failed") }
    return pending.reply
}

AppTreeReturn :: (tree: *AppTree, node: *AppNode) -> *AppNode {
    if node == null || node.return_epoch != tree.account_epoch ||
    TextUntilNul(node.return_account[:]) != TextUntilNul(tree.account[:]) { return null }
    game := AppTreeNode(tree, node.return_to)
    if game == null || game.collection ||
    TextUntilNul(game.identity.authority[:]) != TextUntilNul(node.identity.authority[:]) { return null }
    if node.collection {
        if AppTreeNode(tree, game.parent) != node { return null }
    } else if !AppHandleEqual(game.parent, node.parent) { return null }
    return game
}

AppTreeClearReturn :: (node: *AppNode) {
    node.return_to = AppHandle.{}
    node.return_epoch = 0
    node.return_account[0] = 0
    node.return_target[0] = 0
    node.return_digest[0] = 0
}

AppTreeAddonCurrent :: (tree: *AppTree, pending: *AppPending) -> bool {
    node := AppTreeNode(tree, pending.caller)
    if node == null || pending.account_epoch != tree.account_epoch ||
    TextUntilNul(pending.account[:]) != TextUntilNul(tree.account[:]) ||
    !AppHandleEqual(node.parent, pending.owner) { return false }
    entry := AppTreeAddon(tree, pending.caller, TextUntilNul(pending.request.id[:]))
    return entry != null && TextUntilNul(entry.sha256[:]) == TextUntilNul(pending.digest[:])
}

AppTreeConsentCurrent :: (tree: *AppTree, pending: *AppPending) -> bool {
    node := AppTreeNode(tree, pending.caller)
    if node == null || pending.account_epoch != tree.account_epoch ||
    TextUntilNul(pending.account[:]) != TextUntilNul(tree.account[:]) ||
    AppTreeReturn(tree, node) == null || !AppHandleEqual(node.return_to, pending.owner) ||
    TextUntilNul(node.return_target[:]) != TextUntilNul(pending.request.id[:]) { return false }
    entry := AppTreeAddon(tree, pending.owner, TextUntilNul(pending.request.id[:]), false)
    return entry != null && TextUntilNul(entry.sha256[:]) == TextUntilNul(pending.digest[:]) &&
        TextUntilNul(node.return_digest[:]) == TextUntilNul(pending.digest[:])
}

AppLocatorClear :: (locator: *AppLocator) {
    VecFree(locator.chain)
    locator.identity = AppIdentity.{}
}

AppTreeLocate :: (tree: *AppTree, handle: AppHandle, locator: *AppLocator) -> bool {
    node := AppTreeNode(tree, handle)
    if node == null { return false }
    candidate: AppLocator
    candidate.identity = node.identity
    while node != null {
        location := AppLocation.{.id = node.identity.id, .sha256 = node.entry.sha256}
        if !VecPush(candidate.chain, location) { AppLocatorClear(*candidate); return false }
        node = AppTreeNode(tree, node.parent)
    }
    // The root-to-leaf chain is data. Deep paths do not consume UI scope or
    // Session slots, and no array encodes a maximum nesting level.
    index: s64 = 0
    while index < candidate.chain.count / 2 {
        other := candidate.chain.count - 1 - index
        temporary := candidate.chain[index]
        candidate.chain[index] = candidate.chain[other]
        candidate.chain[other] = temporary
        index += 1
    }
    AppLocatorClear(locator)
    locator.identity = candidate.identity
    VecSwap(locator.chain, candidate.chain)
    VecFree(candidate.chain)
    return true
}

AppTreeCycle :: (tree: *AppTree, parent: AppHandle, identity: *AppIdentity) -> bool {
    node := AppTreeNode(tree, parent)
    while node != null {
        if AppIdentityEqual(*node.identity, identity) { return true }
        node = AppTreeNode(tree, node.parent)
    }
    return false
}

AppTreeDiscard :: (tree: *AppTree, node: *AppNode) {
    tree.provider.close(tree.provider.context, node)
    AppCatalogClear(*node.catalog)
    free(node)
}

AppTreeDrop :: (tree: *AppTree, handle: AppHandle) {
    node := AppTreeNode(tree, handle)
    if node == null { return }
    // Leaving a consent/add-on route also releases its dormant game. Back
    // clears this context first because it is returning to that same game.
    returning := AppTreeReturn(tree, node)
    abandoned := node.return_to
    AppTreeClearReturn(node)
    if returning != null && !AppHandleEqual(tree.active, abandoned) { AppTreeDrop(tree, abandoned) }
    tree.bytes -= node.bytes
    tree.nodes[handle.slot].node = null
    AppTreeDiscard(tree, node)
    while tree.nodes.count > 0 && tree.nodes[tree.nodes.count - 1].node == null { unused VecPop(tree.nodes) }
}

AppTreeOpenChild :: (tree: *AppTree, parent: AppHandle, entry: *AppEntry) -> AppHandle {
    invalid := AppHandle.{-1, 0}
    owner := AppTreeNode(tree, parent)
    if owner == null { return invalid }
    candidate := New(AppNode)
    if candidate == null { return invalid }
    if !tree.provider.open(tree.provider.context, owner, entry, candidate) {
        AppTreeDiscard(tree, candidate)
        return invalid
    }
    if candidate.runtime == null || candidate.bytes < 0 || candidate.bytes > tree.byte_limit - tree.bytes ||
    TextUntilNul(candidate.identity.authority[:]) != TextUntilNul(owner.identity.authority[:]) ||
    TextUntilNul(candidate.identity.id[:]) != TextUntilNul(entry.id[:]) ||
    TextUntilNul(candidate.entry.sha256[:]) != TextUntilNul(entry.sha256[:]) ||
    TextUntilNul(candidate.entry.expected_id[:]) != TextUntilNul(entry.expected_id[:]) ||
    TextUntilNul(candidate.entry.package_id[:]) != TextUntilNul(entry.package_id[:]) ||
    candidate.entry.protocol != entry.protocol || AppTreeCycle(tree, parent, *candidate.identity) {
        AppTreeDiscard(tree, candidate)
        return invalid
    }
    if candidate.collection && TextUntilNul(candidate.catalog.id[:]) != TextUntilNul(candidate.identity.id[:]) {
        AppTreeDiscard(tree, candidate)
        return invalid
    }
    candidate.parent = parent
    candidate.account = tree.account
    candidate.account_epoch = tree.account_epoch
    tree.generation += 1
    candidate.generation = tree.generation
    slot := tree.nodes.count
    for index: cast(s64)0..tree.nodes.count - 1 {
        if tree.nodes[index].node == null { slot = index; break }
    }
    handle := AppHandle.{slot, candidate.generation}
    if slot < tree.nodes.count { tree.nodes[slot].node = candidate }
    else if !VecPush(tree.nodes, AppSlot.{candidate}) { AppTreeDiscard(tree, candidate); return invalid }
    tree.bytes += candidate.bytes
    return handle
}

// Only call after every guest entry has returned. A failed save/load/effect
// retains the old page and provider state. The provider owns atomic disk/sync
// writes; this module never deletes application records or package caches.
AppTreeDrain :: (tree: *AppTree) -> bool {
    if tree.busy || tree.draining { return false }
    tree.draining = true
    for index: cast(s64)0..tree.pending.count - 1 {
        pending := *tree.pending[index]
        if pending.complete { continue }
        sequence := pending.reply.request
        caller := pending.caller
        node := AppTreeNode(tree, caller)
        if node == null || pending.account_epoch != tree.account_epoch || !AppHandleEqual(caller, tree.active) ||
        (pending.consent && !AppTreeConsentCurrent(tree, pending)) {
            pending.complete = true
            pending.reply = AppRejected("stale caller")
            pending.reply.request = sequence
            continue
        }
        owner := caller
        container := node
        if pending.addon {
            if !AppTreeAddonCurrent(tree, pending) {
                pending.complete = true
                pending.reply = AppRejected("stale add-on")
                pending.reply.request = sequence
                continue
            }
            owner = pending.owner
            container = AppTreeNode(tree, owner)
            entry := AppTreeAddon(tree, caller, TextUntilNul(pending.request.id[:]))
            if tree.provider.addon_missing != null && tree.provider.addon_missing(tree.provider.context, container, entry, sequence) {
                pending.complete = true
                if !AppTreeAddonCurrent(tree, pending) || !tree.provider.save(tree.provider.context, node) ||
                !AppTreeAddonCurrent(tree, pending) || tree.provider.addon_present == null ||
                !tree.provider.addon_present(tree.provider.context, container, entry, sequence) ||
                !AppTreeAddonCurrent(tree, pending) { pending.reply = AppRejected("add-on save failed or stale") }
                else {
                    container.return_to = caller
                    container.return_epoch = tree.account_epoch
                    container.return_account = tree.account
                    container.return_target = entry.id
                    container.return_digest = entry.sha256
                    tree.active = owner
                    pending.reply.status = APPS_APPLIED
                }
                pending.reply.request = sequence
                continue
            }
            if !AppTreeAddonCurrent(tree, pending) {
                pending.complete = true
                pending.reply = AppRejected("stale add-on")
                pending.reply.request = sequence
                continue
            }
        }
        // A child that is not on the device has nothing to prepare or open.
        if pending.request.operation != APPS_OPEN && pending.request.operation != APPS_BACK &&
        tree.provider.fetch != null {
            at := AppCatalogFind(*container.catalog, TextUntilNul(pending.request.id[:]))
            if at >= 0 && tree.provider.fetch(tree.provider.context, TextUntilNul(tree.account[:]), node,
                AppCatalogAt(*node.catalog, at), pending.request.operation, *pending.reply) {
                pending.complete = true
                if pending.consent && !AppTreeConsentCurrent(tree, pending) { pending.reply = AppRejected("stale add-on consent") }
                if pending.reply.status != APPS_QUEUED && pending.reply.status != APPS_APPLIED { pending.reply = AppRejected("effect rejected") }
                pending.reply.request = sequence
                continue
            }
        }
        if tree.provider.prepare != null && pending.request.operation != APPS_BACK {
            at := AppCatalogFind(*container.catalog, TextUntilNul(pending.request.id[:]))
            if at < 0 {
                pending.complete = true
                pending.reply = AppRejected("child unavailable")
                pending.reply.request = sequence
                continue
            }
            entry := AppCatalogAt(*container.catalog, at).*
            prepared := tree.provider.prepare(tree.provider.context, container, *entry, sequence)
            if prepared == 0 {
                continue
            }
            if prepared != 1 {
                pending.complete = true
                pending.reply = AppRejected("child verification failed")
                pending.reply.request = sequence
                continue
            }
        }
        pending.complete = true
        if !tree.provider.save(tree.provider.context, node) ||
        (pending.addon && !AppTreeAddonCurrent(tree, pending)) ||
        (pending.consent && !AppTreeConsentCurrent(tree, pending)) {
            pending.reply = AppRejected("save failed")
            pending.reply.request = sequence
            continue
        }
        request := pending.request
        if request.operation == APPS_BACK {
            returning := AppTreeReturn(tree, node)
            if returning != null {
                tree.active = node.return_to
                AppTreeClearReturn(node)
                pending.reply.status = APPS_APPLIED
                if !node.collection { AppTreeDrop(tree, caller) }
            } else if AppTreeNode(tree, node.parent) == null { pending.reply = AppRejected("parent unavailable") }
            else {
                tree.active = node.parent
                pending.reply.status = APPS_APPLIED
                AppTreeDrop(tree, caller)
            }
            pending.reply.request = sequence
            continue
        }
        entry_index := AppCatalogFind(*container.catalog, TextUntilNul(request.id[:]))
        if entry_index < 0 {
            pending.reply = AppRejected("child unavailable")
            pending.reply.request = sequence
            continue
        }
        // Copy the manifest entry before growing the node vector.
        entry := AppCatalogAt(*container.catalog, entry_index).*
        child := AppTreeOpenChild(tree, owner, *entry)
        candidate := AppTreeNode(tree, child)
        if candidate == null {
            pending.reply = AppRejected("child verification failed")
            pending.reply.request = sequence
            continue
        }
        if (pending.addon && !AppTreeAddonCurrent(tree, pending)) ||
        (pending.consent && !AppTreeConsentCurrent(tree, pending)) {
            AppTreeDrop(tree, child)
            pending.reply = AppRejected("stale add-on")
            pending.reply.request = sequence
            continue
        }
        if request.operation == APPS_OPEN {
            returning := AppTreeReturn(tree, container)
            consent := pending.consent
            decision: s32 = APP_OPEN_DECLARED
            // Add-ons always use this exact verified sibling. Platform
            // callbacks cannot replace them with an alternate runtime/route.
            if !pending.addon && !consent && tree.provider.open_effect != null {
                locator: AppLocator
                decision = APP_OPEN_REJECTED
                if AppTreeLocate(tree, child, *locator) {
                    decision = tree.provider.open_effect(tree.provider.context,
                        TextUntilNul(tree.account[:]), *locator, *request, *pending.reply)
                }
                AppLocatorClear(*locator)
            }
            if decision == APP_OPEN_DECLARED {
                if pending.addon || consent {
                    candidate.return_to = ifx pending.addon then caller else container.return_to
                    candidate.return_epoch = tree.account_epoch
                    candidate.return_account = tree.account
                }
                if returning != null {
                    abandoned := container.return_to
                    AppTreeClearReturn(container)
                    if !consent { AppTreeDrop(tree, abandoned) }
                }
                tree.active = child
                pending.reply.status = APPS_APPLIED
            } else {
                if decision == APP_OPEN_HANDLED { pending.reply.status = APPS_QUEUED }
                else { pending.reply = AppRejected("open rejected") }
                AppTreeDrop(tree, child)
            }
        } else {
            locator: AppLocator
            applied := AppTreeLocate(tree, child, *locator)
            if applied {
                if AppsVersionOperation(request.operation) {
                    applied = tree.provider.version_effect != null && tree.provider.version_effect(tree.provider.context,
                        TextUntilNul(tree.account[:]), *locator, *request, *pending.reply)
                } else { applied = tree.provider.effect(tree.provider.context, TextUntilNul(tree.account[:]), *locator, request.operation, *pending.reply) }
            }
            if !applied { pending.reply = AppRejected("effect failed") }
            AppLocatorClear(*locator)
            // Effects verify a temporary instance without navigating to it.
            if pending.reply.status != APPS_QUEUED && pending.reply.status != APPS_APPLIED { pending.reply = AppRejected("effect rejected") }
            AppTreeDrop(tree, child)
        }
        pending.reply.request = sequence
    }
    tree.draining = false
    return true
}

// Native favorites/OS launches resolve a stable verified locator. New guests
// are staged beside the working route; any failure disposes only candidates.
AppTreeOpenLocator :: (tree: *AppTree, locator: *AppLocator) -> bool {
    if tree.busy || tree.draining || locator.chain.count == 0 { return false }
    current := AppTreeNode(tree, tree.active)
    root := AppTreeNode(tree, AppHandle.{0, 1})
    if current == null || root == null || TextUntilNul(locator.identity.authority[:]) != TextUntilNul(root.identity.authority[:]) ||
    TextUntilNul(locator.chain[0].id[:]) != TextUntilNul(root.identity.id[:]) ||
    TextUntilNul(locator.chain[0].sha256[:]) != TextUntilNul(root.entry.sha256[:]) ||
    !tree.provider.save(tree.provider.context, current) { return false }
    tree.draining = true
    staged: Vec(AppHandle)
    parent := AppHandle.{0, 1}
    success := true
    for index: cast(s64)1..locator.chain.count - 1 {
        node := AppTreeNode(tree, parent)
        location := locator.chain[index]
        at := AppCatalogFind(*node.catalog, TextUntilNul(location.id[:]))
        if at < 0 { success = false; break }
        entry := AppCatalogAt(*node.catalog, at).*
        if TextUntilNul(entry.sha256[:]) != TextUntilNul(location.sha256[:]) { success = false; break }
        child := AppTreeOpenChild(tree, parent, *entry)
        if AppTreeNode(tree, child) == null { success = false; break }
        if !VecPush(staged, child) { AppTreeDrop(tree, child); success = false; break }
        parent = child
    }
    leaf := AppTreeNode(tree, parent)
    if leaf == null || !AppIdentityEqual(*leaf.identity, *locator.identity) { success = false }
    if success {
        previous := tree.active
        tree.active = parent
        while previous.slot != 0 {
            node := AppTreeNode(tree, previous)
            if node == null { break }
            next := node.parent
            AppTreeDrop(tree, previous)
            previous = next
        }
    } else {
        index := staged.count
        while index > 0 { index -= 1; AppTreeDrop(tree, staged[index]) }
    }
    VecFree(staged)
    tree.draining = false
    return success
}

// Account switches must save first. If that fails the caller retains this
// whole tree/account; it must not point its provider at another account yet.
AppTreeClose :: (tree: *AppTree) -> bool {
    if tree.busy || tree.draining { return false }
    node := AppTreeNode(tree, tree.active)
    if node != null && !tree.provider.save(tree.provider.context, node) { return false }
    // Reverse insertion order always disposes descendants before ancestors.
    index := tree.nodes.count
    while index > 0 {
        index -= 1
        if tree.nodes[index].node != null { AppTreeDiscard(tree, tree.nodes[index].node) }
    }
    VecFree(tree.nodes)
    VecFree(tree.pending)
    tree.active = AppHandle.{}
    tree.running = AppHandle.{}
    tree.provider = AppProvider.{}
    tree.account[0] = cast(u8)0
    tree.account_epoch = 0; tree.sequence = 0; tree.generation = 0
    tree.bytes = 0; tree.byte_limit = 0; tree.pending_limit = 0
    tree.busy = false; tree.draining = false
    return true
}
