// Shared native bundle ownership. Root hosts inject platform/account effects;
// all child lookup, hash checking, expected identity and VM lifecycle live here.
#import "std/vec"
#import "std/byte_text_linux"
#import "std/bundle_host"
#import "std/c_string"
#import "std/text_buffer"
#import "crypto/sha256"
#import "kryon/hosted_app"
#import "kryon/hosted_values"
#import "kryon/app_context_host"
#import "kryon/app_protocol"
#import "kryon/app_files"
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/tree"
#import "kryon/widget_host"
#import "kryon/widget_kind"
Rules :: #import "protocol";
Node :: #import "node_types";
#import, file "node_host.zi";
#import, file "protocol.zi";
#import, file "catalog.zi";
#import, file "tree.zi";
#import, file "preparation.zi";

using HostValueKind;
using WidgetKind;

APP_NODE_ROUTE :: 6
APP_HOST_BYTE_LIMIT :: 67108864
APP_HOST_PREVIOUS_CONTROLLERS :: 5

AppPlatformAllows :: #type (context: *void, node: *AppNode, function: string) -> bool;
AppPlatformCall :: #type (context: *void, node: *AppNode, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32;
AppPlatformSave :: #type (context: *void, node: *AppNode) -> bool;
AppPlatformState :: #type (context: *void, account: string, identity: *AppIdentity, state: *AppState) -> bool;

AppPlatform :: struct {
    context: *void
    allows: AppPlatformAllows
    call: AppPlatformCall
    widgets: AppPlatformCall
    save: AppPlatformSave
    effect: AppProviderEffect
    version_effect: AppProviderVersionEffect
    presentation: AppPresentation
    state: AppPlatformState
    open_effect: AppProviderOpenEffect
}

// A favorite is prepared beside the working route and replaces it only after
// every child verifies and the current app saves successfully.
AppNavigation :: struct {
    locator: AppLocator
    staged: Vec(AppHandle)
    source: AppHandle
    account_epoch: s64
    next_child: s64
    // Retain a canceled request until its next poll receives rejection.
    // Collection must not turn that poll into a fresh navigation request.
    canceled: bool
}

AppHost :: struct {
    tree: AppTree
    platform: AppPlatform
    reply: string
    last_reply: string
    harness_sha256: [65]u8
    // Earlier shared controllers the platform still trusts, so collections
    // published with one keep opening after the controller changes.
    harness_previous: [APP_HOST_PREVIOUS_CONTROLLERS][65]u8
    locale: [16]u8
    retired: *AppRuntime
    retired_bytes: s64
    // One child borrows its parent's immutable packed bytes. A
    // canceled job keeps that runtime alive until its worker is finished.
    preparation: *AppPreparation
    preparation_owner: *AppRuntime
    preparation_parent: AppHandle
    preparation_sequence: s64
    preparation_epoch: s64
    preparation_canceled: bool
    navigation: AppNavigation
}

AppRuntime :: struct {
    app: AppContext
    legacy: NodeContext
    protocol: s32
    node: *AppNode
    host: *AppHost
    // A collection's controller is trusted shared Apps UI; collection bootstrap
    // and its children retain their own verified logical/save identities.
    controller: bool
    frontend: *AppRuntime
    next_retired: *AppRuntime
    retired: bool
    byte_charge: s64
    busy: bool
    // The catalog this controller last received and its revision. A
    // controller that already holds it is told so instead of parsing it
    // again in the VM on every frame.
    catalog: string
    catalog_revision: s64
}

AppHostBytesMatch :: (bytes: string, digest: string) -> bool {
    actual: [65]u8
    descriptor := cast(*TextDescriptor)(*bytes)
    Sha256Hex(descriptor.data, bytes.count, *actual[0])
    return TextUntilNul(actual[:]) == digest
}

// Digests of the bundles found inside bundles already verified. A bundle's
// assets are fixed by its digest, so a child or controller checked once
// under it is not hashed again when it reopens: on a phone, hashing every
// child of a large collection on each open took seconds.
AppVerifiedAsset :: struct {
    container: [65]u8
    path: [512]u8
    digest: [65]u8
}
app_verified_assets: Vec(AppVerifiedAsset);

AppHostAssetMatches :: (container: *AppNode, path: string, bytes: string, digest: string) -> bool {
    owner := TextUntilNul(container.entry.sha256[:])
    for index: cast(s64)0..app_verified_assets.count - 1 {
        known := *app_verified_assets[index]
        if TextUntilNul(known.container[:]) == owner && TextUntilNul(known.path[:]) == path {
            return TextUntilNul(known.digest[:]) == digest
        }
    }
    actual: [65]u8
    descriptor := cast(*TextDescriptor)(*bytes)
    Sha256Hex(descriptor.data, bytes.count, *actual[0])
    entry: AppVerifiedAsset
    if AppDigestValid(owner) && app_verified_assets.count < 256 &&
    CopyCString(owner, entry.container[:]) && CopyCString(path, entry.path[:]) {
        entry.digest = actual
        unused VecPush(app_verified_assets, entry)
    }
    return TextUntilNul(actual[:]) == digest
}

AppHostAllows :: (context: *void, function: string) -> bool {
    runtime := cast(*AppRuntime)context
    if runtime.retired { return false }
    if function == APPS_SERVICE { return runtime.controller && runtime.node.collection }
    platform := runtime.host.platform
    return platform.allows != null && platform.allows(platform.context, runtime.node, function)
}

AppHostText :: (text: string) -> HostValue {
    return HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
        .data = HostTextData(text), .length = cast(usize)text.count}
}

AppHostWriteQuoted :: (bytes: *Vec(u8), text: string) {
    AppsWriteQuoted(bytes, text)
}

AppHostReply :: (host: *AppHost, reply: AppsReply) -> HostValue {
    bytes: Vec(u8)
    status := ifx reply.status == APPS_APPLIED then "applied" else ifx reply.status == APPS_QUEUED then "queued" else "rejected"
    BuilderPrint(*bytes, "{\"v\":1,\"status\":\"%\",\"request\":%,\"receipt\":", status, reply.request)
    AppHostWriteQuoted(*bytes, TextUntilNul(reply.receipt[:]))
    BuilderPrint(*bytes, ",\"reason\":")
    AppHostWriteQuoted(*bytes, TextUntilNul(reply.reason[:]))
    BuilderPrint(*bytes, "}")
    AppFileFree(host.reply)
    host.reply = BuilderFinish(bytes)
    return AppHostText(host.reply)
}

AppHostCatalog :: (runtime: *AppRuntime, revision: s64 = 0) -> HostValue {
    host := runtime.host
    node := runtime.node
    bytes: Vec(u8)
    BuilderPrint(*bytes, "{\"v\":1,\"status\":\"applied\",\"id\":")
    AppHostWriteQuoted(*bytes, TextUntilNul(node.identity.id[:]))
    BuilderPrint(*bytes, ",\"title\":")
    AppHostWriteQuoted(*bytes, TextUntilNul(node.catalog.title[:]))
    BuilderPrint(*bytes, ",\"locale\":")
    AppHostWriteQuoted(*bytes, TextUntilNul(host.locale[:]))
    presentation := host.platform.presentation
    BuilderPrint(*bytes, ",\"presentation\":{\"mode\":\"%\",\"tile_class\":%,\"action_class\":%,\"muted_class\":%}",
        ifx presentation.icon then "icon" else "preview", presentation.tile_class, presentation.action_class, presentation.muted_class)
    BuilderPrint(*bytes, ",\"can_back\":%,\"children\":[", AppTreeNode(*host.tree, node.parent) != null)
    item := node.catalog.children
    while item != null {
        if item != node.catalog.children { BuilderPrint(*bytes, ",") }
        BuilderPrint(*bytes, "{\"id\":")
        AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.id[:]))
        BuilderPrint(*bytes, ",\"title\":")
        AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.title[:]))
        BuilderPrint(*bytes, ",\"version\":")
        AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.version[:]))
        BuilderPrint(*bytes, ",\"preview\":")
        AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.preview[:]))
        BuilderPrint(*bytes, ",\"icon\":")
        AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.icon[:]))
        BuilderPrint(*bytes, ",\"icon_shape\":")
        AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.icon_shape[:]))
        if item.entry.cover.portrait[0] != 0 {
            BuilderPrint(*bytes, ",\"cover\":{\"portrait\":")
            AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.cover.portrait[:]))
            BuilderPrint(*bytes, ",\"landscape\":")
            AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.cover.landscape[:]))
            BuilderPrint(*bytes, ",\"logo\":")
            AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.cover.logo[:]))
            BuilderPrint(*bytes, ",\"caption\":")
            AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.cover.caption[:]))
            BuilderPrint(*bytes, ",\"action\":")
            AppHostWriteQuoted(*bytes, TextUntilNul(item.entry.cover.action[:]))
            BuilderPrint(*bytes, "}")
        }
        identity := AppIdentity.{.authority = node.identity.authority, .id = item.entry.id}
        state: AppState
        if host.platform.state != null && !host.platform.state(host.platform.context, TextUntilNul(host.tree.account[:]), *identity, *state) {
            VecFree(bytes)
            return AppHostReply(host, AppRejected("app state unavailable"))
        }
        BuilderPrint(*bytes, ",\"installed\":%,\"favorite\":%,\"launcher\":%,\"selected\":%,\"disabled\":%,\"bytes\":%",
            state.installed, state.favorite, state.launcher, state.selected, state.disabled, state.bytes)
        AppHostVersions(*bytes, *state, host.platform.version_effect != null)
        BuilderPrint(*bytes, "}")
        item = item.next
    }
    BuilderPrint(*bytes, "]")
    body := BuilderFinish(bytes)
    if body == runtime.catalog {
        AppFileFree(body)
        if revision > 0 && revision == runtime.catalog_revision {
            unchanged: Vec(u8)
            BuilderPrint(*unchanged, "{\"v\":1,\"unchanged\":true}")
            AppFileFree(host.reply)
            host.reply = BuilderFinish(unchanged)
            return AppHostText(host.reply)
        }
    } else {
        AppFileFree(runtime.catalog)
        runtime.catalog = body
        runtime.catalog_revision += 1
    }
    reply: Vec(u8)
    BuilderPrint(*reply, "%,\"revision\":%}", runtime.catalog, runtime.catalog_revision)
    AppFileFree(host.reply)
    host.reply = BuilderFinish(reply)
    return AppHostText(host.reply)
}

AppHostCall :: (context: *void, module: *u8, function: *u8, arguments: *HostValue,
    count: s32, result: *HostValue) -> s32 {
    runtime := cast(*AppRuntime)context
    if runtime.retired { return 0 }
    name := TextFromCString(function)
    if name == "AppServiceHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostString) && AppArgumentText(arguments[0]) == APPS_SERVICE {
        if !runtime.controller || !runtime.node.collection { return 0 }
        request: AppsRequest
        if !AppsReadRequest(AppArgumentText(arguments[1]), *request) {
            result.* = AppHostReply(runtime.host, AppRejected("invalid request"))
            return 1
        }
        if request.operation == APPS_CATALOG { result.* = AppHostCatalog(runtime, request.revision); return 1 }
        reply := AppTreeQueue(*runtime.host.tree, runtime.host.tree.running, request)
        result.* = AppHostReply(runtime.host, reply)
        return 1
    }
    platform := runtime.host.platform
    if platform.call == null { return 0 }
    return platform.call(platform.context, runtime.node, module, function, arguments, count, result)
}

AppHostWidgets :: (context: *void, module: *u8, function: *u8, arguments: *HostValue,
    count: s32, result: *HostValue) -> s32 {
    runtime := cast(*AppRuntime)context
    if runtime.retired { return 0 }
    platform := runtime.host.platform
    if platform.widgets == null { return 0 }
    return platform.widgets(platform.context, runtime.node, module, function, arguments, count, result)
}

AppHostRuntime :: (host: *AppHost, node: *AppNode, bytes: string, expected_id: string,
    controller: bool = false, protocol: s32 = APPS_CONTEXT_PROTOCOL,
    preparation: *AppPreparation = null) -> *AppRuntime {
    runtime := New(AppRuntime)
    if runtime == null { return null }
    runtime.host = host
    runtime.node = node
    runtime.protocol = protocol
    runtime.controller = controller
    runtime.app.context = cast(*void)runtime
    runtime.app.allows = AppHostAllows
    runtime.app.services = AppHostCall
    runtime.app.widgets = AppHostWidgets
    runtime.app.expected_id = expected_id
    opened := AppContextRuntime(*runtime.app)
    if preparation != null {
        if controller {
            owner := cast(*AppRuntime)node.runtime
            if owner == null {
                free(runtime)
                return null
            }
            opened.bundle = AppPreparationTakeController(preparation, AppContextRuntime(*owner.app).bundle,
                TextUntilNul(node.catalog.harness[:]), bytes.count)
        } else {
            opened.bundle = AppPreparationTakeRoot(preparation)
        }
        if opened.bundle == null {
            free(runtime)
            return null
        }
    }
    ready: bool
    if protocol == APPS_NODE_PROTOCOL {
        runtime.legacy.app = AppContextRuntime(*runtime.app)
        runtime.legacy.context = cast(*void)runtime
        runtime.legacy.allows = AppHostAllows
        runtime.legacy.services = AppHostCall
        runtime.legacy.widgets = AppHostWidgets
        if preparation != null {
            ready = NodeStart(*runtime.legacy, TextUntilNul(node.identity.id[:]), expected_id)
        } else {
            ready = NodeOpen(*runtime.legacy, bytes, TextUntilNul(node.identity.id[:]), expected_id)
        }
    } else if preparation != null {
        ready = AppContextRestart(*runtime.app)
    } else {
        ready = AppContextOpen(*runtime.app, bytes)
    }
    if !ready {
        HostedAppClose(AppContextRuntime(*runtime.app))
        free(runtime)
        return null
    }
    return runtime
}

AppHostController :: (host: *AppHost, node: *AppNode, runtime: *AppRuntime,
    preparation: *AppPreparation = null) -> bool {
    if !node.collection { return true }
    item := node.catalog.children
    while item != null {
        preview := TextUntilNul(item.entry.preview[:])
        if preview != "" && !AppHostAsset(node, preview).found { return false }
        icon := TextUntilNul(item.entry.icon[:])
        if icon != "" && !AppHostAsset(node, icon).found { return false }
        covers: [3]string = .[TextUntilNul(item.entry.cover.portrait[:]),
        TextUntilNul(item.entry.cover.landscape[:]), TextUntilNul(item.entry.cover.logo[:])]
        for path: covers { if path != "" && !AppHostAsset(node, path).found { return false } }
        item = item.next
    }
    harness := TextUntilNul(node.catalog.harness[:])
    resource := HostedAppAsset(AppContextRuntime(*runtime.app), harness)
    if !resource.found { return false }
    digest := TextUntilNul(host.harness_sha256[:])
    trusted: bool
    if preparation != null {
        if preparation.taken_bundle != AppContextRuntime(*runtime.app).bundle ||
        TextUntilNul(preparation.controller_path[:]) != harness ||
        preparation.controller_bytes != resource.data.count {
            return false
        }
        digest = TextUntilNul(preparation.controller_digest[:])
        trusted = digest == TextUntilNul(host.harness_sha256[:])
    } else {
        trusted = AppHostAssetMatches(node, harness, resource.data, digest)
    }
    for index: 0..APP_HOST_PREVIOUS_CONTROLLERS - 1 {
        previous := TextUntilNul(host.harness_previous[index][:])
        if preparation != null {
            trusted = trusted || (previous != "" && digest == previous)
        } else {
            trusted = trusted || (previous != "" && AppHostAssetMatches(node, harness, resource.data, previous))
        }
    }
    if !trusted { return false }
    limit := ifx host.tree.byte_limit > 0 then host.tree.byte_limit else APP_HOST_BYTE_LIMIT
    if resource.data.count + 65536 > limit - host.tree.bytes - host.retired_bytes - node.bytes { return false }
    runtime.frontend = AppHostRuntime(host, node, resource.data, "apps", true,
        APPS_CONTEXT_PROTOCOL, preparation)
    if runtime.frontend == null { return false }
    node.bytes += resource.data.count + 65536
    return true
}

// Call with the verified node supplied to the platform callback. Bytes are
// borrowed until AppHostCollect, so queued rendering must finish before then.
// A renderer's cache key includes node.entry.sha256 as well as the packed path.
AppHostAsset :: (node: *AppNode, path: string) -> HostedAsset {
    if node == null || node.runtime == null || !AppAssetPathValid(path) { return HostedAsset.{} }
    runtime := cast(*AppRuntime)node.runtime
    if runtime.retired { return HostedAsset.{} }
    return HostedAppAsset(AppContextRuntime(*runtime.app), path)
}

AppHostPreparationCurrent :: (host: *AppHost) -> bool {
    if host.preparation == null || host.preparation_canceled ||
    host.preparation_epoch != host.tree.account_epoch {
        return false
    }
    parent := AppTreeNode(*host.tree, host.preparation_parent)
    if parent == null || host.preparation_owner == null ||
    parent.runtime != cast(*void)host.preparation_owner ||
    host.preparation_owner.retired {
        return false
    }
    // Sequence zero belongs to native discovery, which never navigates.
    if host.preparation_sequence == 0 {
        return true
    }
    if !AppHandleEqual(host.preparation_parent, host.tree.active) {
        return false
    }
    for index: cast(s64)0..host.tree.pending.count - 1 {
        pending := host.tree.pending[index]
        if pending.reply.request == host.preparation_sequence {
            return !pending.complete && pending.account_epoch == host.tree.account_epoch &&
            AppHandleEqual(pending.caller, host.preparation_parent)
        }
    }
    return false
}

AppHostClearPreparation :: (host: *AppHost) -> bool {
    if !AppPreparationClose(host.preparation) {
        return false
    }
    host.preparation = null
    host.preparation_owner = null
    host.preparation_parent = AppHandle.{}
    host.preparation_sequence = 0
    host.preparation_epoch = 0
    host.preparation_canceled = false
    return true
}

AppHostCollectPreparation :: (host: *AppHost) {
    if host.preparation != null && !AppHostPreparationCurrent(host) {
        host.preparation_canceled = true
        unused AppHostClearPreparation(host)
    }
}

// One child at a time owns a worker. Its parent runtime stays alive
// until that worker has stopped borrowing the packed bytes, even after Back
// retires the parent. Only this boundary touches the shared asset index.
AppHostPrepareChild :: (context: *void, parent: *AppNode, entry: *AppEntry, sequence: s64) -> s32 {
    host := cast(*AppHost)context
    AppHostCollectPreparation(host)
    owner := cast(*AppRuntime)parent.runtime
    if owner == null || owner.retired {
        return -1
    }
    parent_handle := AppHandle.{-1, 0}
    for index: cast(s64)0..host.tree.nodes.count - 1 {
        if host.tree.nodes[index].node == parent {
            parent_handle = AppHandle.{index, parent.generation}
            break
        }
    }
    if parent_handle.slot < 0 {
        return -1
    }
    if host.preparation != null {
        // Interactive navigation takes priority over native discovery. An
        // unfinished worker is canceled without waiting for its parser.
        // Discovery and later queued requests never displace a queued one.
        if host.preparation_sequence != 0 && host.preparation_sequence != sequence {
            return 0
        }
        same := host.preparation_sequence == sequence &&
        AppHandleEqual(host.preparation_parent, parent_handle) &&
        TextUntilNul(host.preparation.id[:]) == TextUntilNul(entry.id[:]) &&
        TextUntilNul(host.preparation.digest[:]) == TextUntilNul(entry.sha256[:])
        if !same || host.preparation_canceled {
            host.preparation_canceled = true
            if !AppHostClearPreparation(host) {
                return 0
            }
        }
    }
    if host.preparation != null {
        if !AppPreparationReady(host.preparation) {
            return 0
        }
        if !host.preparation.valid {
            unused AppHostClearPreparation(host)
            return -1
        }
        return 1
    }
    resource := HostedAppAsset(AppContextRuntime(*owner.app), TextUntilNul(entry.bundle[:]))
    charge := resource.data.count + 65536 + cast(s64)size_of(AppNode)
    if !resource.found || charge > host.tree.byte_limit - host.tree.bytes - host.retired_bytes {
        return -1
    }
    preparation := AppPrepare(resource.data, TextUntilNul(entry.sha256[:]), TextUntilNul(entry.id[:]),
        host.tree.byte_limit - host.tree.bytes - host.retired_bytes)
    if preparation == null {
        return -1
    }
    host.preparation = preparation
    host.preparation_owner = owner
    host.preparation_parent = parent_handle
    host.preparation_sequence = sequence
    host.preparation_epoch = host.tree.account_epoch
    return 0
}

// Poll native discovery at frame boundaries: zero is pending, one returns
// a verified child, and minus one rejects it. This never saves, navigates or
// applies effects. The child is scan-owned; drop it when finished. Looking
// up the declared entry here prevents callers from substituting its trust
// inputs. Interactive queued requests have priority over this single worker.
AppHostPollChild :: (host: *AppHost, parent: AppHandle, id: string, output: *AppHandle) -> s32 {
    output.* = AppHandle.{-1, 0}
    if host.tree.busy || host.tree.draining {
        return 0
    }
    owner := AppTreeNode(*host.tree, parent)
    if owner == null || !owner.collection {
        return -1
    }
    at := AppCatalogFind(*owner.catalog, id)
    if at < 0 {
        return -1
    }
    // Once discovery borrows this host, queued navigation must use the
    // same preparation boundary so user input can preempt that work.
    host.tree.provider.prepare = AppHostPrepareChild
    entry := AppCatalogAt(*owner.catalog, at).*
    prepared := AppHostPrepareChild(cast(*void)host, owner, *entry, 0)
    if prepared != 1 {
        return prepared
    }
    defer {
        unused AppHostClearPreparation(host)
    }
    child := AppTreeOpenChild(*host.tree, parent, *entry)
    if AppTreeNode(*host.tree, child) == null {
        return -1
    }
    output.* = child
    return 1
}

AppHostOpenChild :: (host: *AppHost, parent: AppHandle, id: string, output: *AppHandle) -> s32 {
    if host.navigation.next_child > 0 && !host.navigation.canceled {
        output.* = AppHandle.{-1, 0}
        return 0
    }
    return AppHostPollChild(host, parent, id, output)
}

// Abandon native discovery without canceling a user's queued navigation.
// Collection retains borrowed parent bytes until the canceled worker exits.
AppHostCancelChild :: (host: *AppHost) {
    if host.preparation != null && host.preparation_sequence == 0 {
        host.preparation_canceled = true
        unused AppHostClearPreparation(host)
    }
}

AppHostDiscardNavigation :: (host: *AppHost) {
    navigation := *host.navigation
    index := navigation.staged.count
    while index > 0 {
        index -= 1
        AppTreeDrop(*host.tree, navigation.staged[index])
    }
    VecFree(navigation.staged)
}

AppHostClearNavigation :: (host: *AppHost, discard: bool) {
    navigation := *host.navigation
    if discard {
        AppHostDiscardNavigation(host)
    } else {
        VecFree(navigation.staged)
    }
    AppLocatorClear(*navigation.locator)
    navigation.source = AppHandle.{}
    navigation.account_epoch = 0
    navigation.next_child = 0
    navigation.canceled = false
}

// Cancellation never joins a parser or saves a partly staged route.
AppHostCancelLocator :: (host: *AppHost) {
    if host.navigation.next_child > 0 && !host.navigation.canceled {
        AppHostCancelChild(host)
        AppHostDiscardNavigation(host)
        host.navigation.canceled = true
    }
}

AppHostCollectNavigation :: (host: *AppHost) {
    navigation := *host.navigation
    if navigation.next_child > 0 && !navigation.canceled && (navigation.account_epoch != host.tree.account_epoch ||
        !AppHandleEqual(navigation.source, host.tree.active) ||
        AppTreeNode(*host.tree, navigation.source) == null) {
        AppHostCancelLocator(host)
    }
}

AppHostNavigationMatches :: (host: *AppHost, locator: *AppLocator) -> bool {
    saved := *host.navigation.locator
    if saved.chain.count != locator.chain.count || !AppIdentityEqual(*saved.identity, *locator.identity) {
        return false
    }
    for index: cast(s64)0..saved.chain.count - 1 {
        if TextUntilNul(saved.chain[index].id[:]) != TextUntilNul(locator.chain[index].id[:]) ||
        TextUntilNul(saved.chain[index].sha256[:]) != TextUntilNul(locator.chain[index].sha256[:]) {
            return false
        }
    }
    return true
}

AppHostRejectLocator :: (host: *AppHost) -> s32 {
    AppHostCancelLocator(host)
    AppHostClearNavigation(host, false)
    return -1
}

// Selecting the page already shown preserves its live state and avoids
// saving, opening or validating the same immutable programs again.
AppHostAtLocator :: (host: *AppHost, locator: *AppLocator) -> bool {
    node := AppTreeNode(*host.tree, host.tree.active)
    if node == null || !AppIdentityEqual(*node.identity, *locator.identity) {
        return false
    }
    index := locator.chain.count
    while node != null && index > 0 {
        index -= 1
        if TextUntilNul(node.identity.id[:]) != TextUntilNul(locator.chain[index].id[:]) ||
        TextUntilNul(node.entry.sha256[:]) != TextUntilNul(locator.chain[index].sha256[:]) {
            return false
        }
        if node.parent.slot < 0 {
            return index == 0
        }
        node = AppTreeNode(*host.tree, node.parent)
    }
    return false
}

// Poll a stable verified locator at frame boundaries: zero is pending, one
// has navigated, and minus one rejects it. Every call stages at most one
// child. A changed request cancels only the previous staged candidates. A
// canceled request returns rejection once, even after frame collection.
AppHostOpenLocator :: (host: *AppHost, locator: *AppLocator) -> s32 {
    if host.tree.busy || host.tree.draining {
        return 0
    }
    navigation := *host.navigation
    if navigation.canceled {
        same := AppHostNavigationMatches(host, locator)
        AppHostClearNavigation(host, false)
        if same {
            return -1
        }
    }
    if navigation.next_child > 0 {
        if navigation.account_epoch != host.tree.account_epoch ||
        !AppHandleEqual(navigation.source, host.tree.active) ||
        AppTreeNode(*host.tree, navigation.source) == null {
            return AppHostRejectLocator(host)
        }
        if !AppHostNavigationMatches(host, locator) {
            AppHostCancelLocator(host)
            AppHostClearNavigation(host, false)
        }
    }
    if navigation.next_child == 0 {
        if AppHostAtLocator(host, locator) {
            return 1
        }
        root := AppTreeNode(*host.tree, AppHandle.{0, 1})
        if root == null || AppTreeNode(*host.tree, host.tree.active) == null ||
        locator.chain.count == 0 ||
        TextUntilNul(locator.identity.authority[:]) != TextUntilNul(root.identity.authority[:]) ||
        TextUntilNul(locator.chain[0].id[:]) != TextUntilNul(root.identity.id[:]) ||
        TextUntilNul(locator.chain[0].sha256[:]) != TextUntilNul(root.entry.sha256[:]) {
            return -1
        }
        navigation.locator.identity = locator.identity
        for index: cast(s64)0..locator.chain.count - 1 {
            if !VecPush(navigation.locator.chain, locator.chain[index]) {
                AppHostClearNavigation(host, true)
                return -1
            }
        }
        navigation.source = host.tree.active
        navigation.account_epoch = host.tree.account_epoch
        navigation.next_child = 1
        AppHostCancelChild(host)
    }
    parent := AppHandle.{0, 1}
    if navigation.staged.count > 0 {
        parent = navigation.staged[navigation.staged.count - 1]
    }
    if navigation.next_child < navigation.locator.chain.count {
        node := AppTreeNode(*host.tree, parent)
        if node == null || !node.collection {
            return AppHostRejectLocator(host)
        }
        location := navigation.locator.chain[navigation.next_child]
        at := AppCatalogFind(*node.catalog, TextUntilNul(location.id[:]))
        if at < 0 {
            return AppHostRejectLocator(host)
        }
        declared := AppCatalogAt(*node.catalog, at).*
        if TextUntilNul(declared.sha256[:]) != TextUntilNul(location.sha256[:]) {
            return AppHostRejectLocator(host)
        }
        child: AppHandle
        ready := AppHostPollChild(host, parent, TextUntilNul(location.id[:]), *child)
        if ready == 0 {
            return 0
        }
        if ready != 1 {
            return AppHostRejectLocator(host)
        }
        if !VecPush(navigation.staged, child) {
            AppTreeDrop(*host.tree, child)
            return AppHostRejectLocator(host)
        }
        navigation.next_child += 1
        parent = child
        if navigation.next_child < navigation.locator.chain.count {
            return 0
        }
    }
    leaf := AppTreeNode(*host.tree, parent)
    current := AppTreeNode(*host.tree, navigation.source)
    if leaf == null || current == null || !AppIdentityEqual(*leaf.identity, *navigation.locator.identity) {
        return AppHostRejectLocator(host)
    }
    host.tree.draining = true
    saved := host.tree.provider.save(host.tree.provider.context, current)
    host.tree.draining = false
    if !saved {
        return AppHostRejectLocator(host)
    }
    previous := navigation.source
    AppHostClearNavigation(host, false)
    host.tree.active = parent
    while previous.slot != 0 {
        node := AppTreeNode(*host.tree, previous)
        if node == null {
            break
        }
        next := node.parent
        AppTreeDrop(*host.tree, previous)
        previous = next
    }
    return 1
}

AppHostOpen :: (context: *void, parent: *AppNode, entry: *AppEntry, candidate: *AppNode) -> bool {
    host := cast(*AppHost)context
    parent_runtime := cast(*AppRuntime)parent.runtime
    bundle := TextUntilNul(entry.bundle[:])
    resource := HostedAppAsset(AppContextRuntime(*parent_runtime.app), bundle)
    preparation: *AppPreparation
    if host.preparation != null && host.preparation_owner == parent_runtime &&
    host.preparation_epoch == host.tree.account_epoch &&
    AppPreparationReady(host.preparation) && host.preparation.valid && !host.preparation_canceled {
        expected := cast(*TextDescriptor)(*host.preparation.bytes)
        actual := cast(*TextDescriptor)(*resource.data)
        if expected.data == actual.data && host.preparation.bytes.count == resource.data.count &&
        TextUntilNul(host.preparation.digest[:]) == TextUntilNul(entry.sha256[:]) &&
        TextUntilNul(host.preparation.id[:]) == TextUntilNul(entry.id[:]) {
            preparation = host.preparation
        }
    }
    if host.preparation != null && preparation == null {
        return false
    }
    defer {
        if preparation != null {
            unused AppHostClearPreparation(host)
        }
    }
    if !resource.found || (preparation == null &&
        !AppHostAssetMatches(parent, bundle, resource.data, TextUntilNul(entry.sha256[:]))) { return false }
    if resource.data.count + 65536 + cast(s64)size_of(AppNode) > host.tree.byte_limit - host.tree.bytes - host.retired_bytes { return false }
    if entry.protocol != APPS_CONTEXT_PROTOCOL && entry.protocol != APPS_COLLECTION_PROTOCOL &&
    entry.protocol != APPS_NODE_PROTOCOL { return false }
    candidate.identity.authority = parent.identity.authority
    candidate.identity.id = entry.id
    candidate.entry = entry.*
    runtime := AppHostRuntime(host, candidate, resource.data, TextUntilNul(candidate.entry.expected_id[:]), false, entry.protocol, preparation)
    if runtime == null { return false }
    candidate.runtime = cast(*void)runtime
    // Charge a conservative fixed amount for the native context as well as
    // packed bytes. This is separate from the VM's own allocation policy.
    candidate.bytes = resource.data.count + 65536 + cast(s64)size_of(AppNode)
    candidate.collection = entry.protocol == APPS_COLLECTION_PROTOCOL
    if candidate.collection {
        manifest := HostedAppAsset(AppContextRuntime(*runtime.app), APPS_CATALOG_ASSET)
        if !manifest.found || !AppCatalogRead(manifest.data, TextUntilNul(candidate.identity.id[:]), *candidate.catalog) { return false }
    }
    return AppHostController(host, candidate, runtime, preparation)
}

AppHostActiveRuntime :: (host: *AppHost) -> *AppRuntime {
    node := AppTreeNode(*host.tree, host.tree.active)
    return ifx node == null then null else cast(*AppRuntime)node.runtime
}

AppHostRun :: (host: *AppHost, mode: s32) -> bool {
    node := AppTreeNode(*host.tree, host.tree.active)
    if node == null { return false }
    runtime := cast(*AppRuntime)node.runtime
    if node.collection && runtime.frontend != null {
        frontend := runtime.frontend
        frontend.app.session = runtime.app.session
        frontend.app.bounds = runtime.app.bounds
        frontend.app.dark = runtime.app.dark
        frontend.app.scale = runtime.app.scale
        frontend.app.font = runtime.app.font
        frontend.app.key = runtime.app.key
        frontend.app.modifiers = runtime.app.modifiers
        frontend.app.input = runtime.app.input
        frontend.app.area_input = runtime.app.area_input
        frontend.app.command = runtime.app.command
        runtime = frontend
    }
    if runtime.busy || !AppTreeBegin(*host.tree, host.tree.active) { return false }
    runtime.busy = true
    handle := host.tree.active
    frame_session := runtime.app.session
    if runtime.protocol == APPS_NODE_PROTOCOL { frame_session = runtime.legacy.frame.session }
    mounted: bool
    if mode == APP_FRAME {
        bounds := runtime.app.bounds
        if runtime.protocol == APPS_NODE_PROTOCOL && (bounds.width <= 0.0 || bounds.height <= 0.0) {
            frame := runtime.legacy.frame
            bounds = Rectangle.{0.0, cast(float32)frame.top, cast(float32)frame.width,
                cast(float32)(frame.height - frame.top - frame.bottom)}
        }
        if SessionValid(frame_session) {
            mount := TreeSubmitCurrent(frame_session, cast(u64)1099511627776 + cast(u64)node.generation,
                cast(s32)WidgetKindCustom, bounds)
            if mount >= 0 { mounted = TreePushScope(frame_session, mount) }
        }
        if !mounted {
            runtime.busy = false
            unused AppTreeEnd(*host.tree, handle)
            return false
        }
    }
    result: bool
    if runtime.protocol == APPS_NODE_PROTOCOL {
        runtime.legacy.key = runtime.app.key
        runtime.legacy.input = runtime.app.input
        if runtime.legacy.message.locale == "" { runtime.legacy.message.locale = TextUntilNul(host.locale[:]) }
        action: s32 = ifx mode == APP_BACK then Node.APP_BACK else ifx mode == APP_NODE_ROUTE then Node.APP_ROUTE else Node.APP_FRAME
        if mode == APP_FRAME || mode == APP_BACK || mode == APP_NODE_ROUTE {
            result = NodeRun(*runtime.legacy, action)
            if mode != APP_BACK { result = result && runtime.legacy.succeeded }
        }
    } else { result = AppContextRun(*runtime.app, mode) }
    AppFileFree(host.last_reply)
    host.last_reply = ""
    if runtime.app.reply.count <= APP_MANIFEST_BYTE_LIMIT {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "%", runtime.app.reply)
        host.last_reply = BuilderFinish(bytes)
    }
    else { result = false }
    if mounted {
        // The guest cannot End this mount. Close any scopes it left open
        // before restoring the native host's parent, then drain navigation.
        WidgetHostEnd()
        if !TreePopScope(frame_session) { result = false }
    }
    runtime.busy = false
    unused AppTreeEnd(*host.tree, handle)
    // Child open/close and platform effects happen only after Run returns.
    unused AppTreeDrain(*host.tree)
    return result
}

// Route requests use the same non-reentrant VM boundary as frames. Generic
// app/1 collections need no legacy route message.
AppHostRoute :: (host: *AppHost) -> bool {
    runtime := AppHostActiveRuntime(host)
    if runtime == null { return false }
    return runtime.protocol != APPS_NODE_PROTOCOL || AppHostRun(host, APP_NODE_ROUTE)
}

// -1: failure, keep the working page; 0: root did not consume Back;
// 1: the guest consumed it or navigation moved exactly one parent.
AppHostBack :: (host: *AppHost) -> s32 {
    runtime := AppHostActiveRuntime(host)
    if runtime == null || host.tree.busy || host.tree.draining { return -1 }
    AppHostCancelLocator(host)
    active := host.tree.active
    if !AppHostRun(host, APP_BACK) { return -1 }
    if !AppHandleEqual(host.tree.active, active) { return 1 }
    if (runtime.protocol == APPS_NODE_PROTOCOL && runtime.legacy.succeeded) ||
    (runtime.protocol != APPS_NODE_PROTOCOL && host.last_reply == "consumed") { return 1 }
    node := AppTreeNode(*host.tree, active)
    if node == null { return -1 }
    if AppTreeNode(*host.tree, node.parent) == null { return 0 }
    queued := AppTreeQueue(*host.tree, active, AppsRequest.{.operation = APPS_BACK})
    if queued.status != APPS_QUEUED || !AppTreeDrain(*host.tree) { return -1 }
    return ifx !AppHandleEqual(host.tree.active, active) then 1 else -1
}

AppHostSave :: (context: *void, node: *AppNode) -> bool {
    host := cast(*AppHost)context
    runtime := cast(*AppRuntime)node.runtime
    if runtime == null || runtime.busy { return false }
    runtime.busy = true
    // node/2 writes during the frame; its published ABI has no save action.
    saved := true
    if runtime.protocol != APPS_NODE_PROTOCOL {
        if runtime.frontend != null && !AppContextRun(*runtime.frontend.app, APP_SAVE) { runtime.busy = false; return false }
        saved = AppContextRun(*runtime.app, APP_SAVE)
    }
    runtime.busy = false
    if !saved { return false }
    return host.platform.save == null || host.platform.save(host.platform.context, node)
}

AppHostClose :: (context: *void, node: *AppNode) {
    runtime := cast(*AppRuntime)node.runtime
    if runtime == null { return }
    host := cast(*AppHost)context
    runtime.retired = true
    runtime.byte_charge = node.bytes
    host.retired_bytes += runtime.byte_charge
    runtime.node = null
    if runtime.frontend != null { runtime.frontend.retired = true; runtime.frontend.node = null }
    runtime.next_retired = host.retired
    host.retired = runtime
    node.runtime = null
}

// Call only after the root renderer has consumed its frame. Closing a routed
// VM does not prove that submitted images/text stopped borrowing its storage.
AppHostCollect :: (host: *AppHost) {
    AppHostCollectNavigation(host)
    AppHostCollectPreparation(host)
    runtime := host.retired
    host.retired = null
    retained: *AppRuntime
    while runtime != null {
        next := runtime.next_retired
        if host.preparation != null && host.preparation_owner == runtime {
            runtime.next_retired = retained
            retained = runtime
            runtime = next
            continue
        }
        host.retired_bytes -= runtime.byte_charge
        if runtime.frontend != null {
            HostedAppClose(AppContextRuntime(*runtime.frontend.app))
            AppFileFree(runtime.frontend.catalog)
            free(runtime.frontend)
        }
        HostedAppClose(AppContextRuntime(*runtime.app))
        AppFileFree(runtime.catalog)
        free(runtime)
        runtime = next
    }
    host.retired = retained
}

AppHostVersionEffect :: (context: *void, account: string, locator: *AppLocator, request: *AppsRequest, reply: *AppsReply) -> bool {
    host := cast(*AppHost)context
    return host.platform.version_effect != null && host.platform.version_effect(host.platform.context, account, locator, request, reply)
}

AppHostEffect :: (context: *void, account: string, locator: *AppLocator, operation: s32, reply: *AppsReply) -> bool {
    host := cast(*AppHost)context
    return host.platform.effect != null && host.platform.effect(host.platform.context, account, locator, operation, reply)
}

// The temporary child of a HANDLED/REJECTED open retires like any closed
// guest; AppHostCollect frees it after the frame.
AppHostOpenEffect :: (context: *void, account: string, locator: *AppLocator, request: *AppsRequest, reply: *AppsReply) -> s32 {
    host := cast(*AppHost)context
    if host.platform.open_effect == null { return APP_OPEN_DECLARED }
    return host.platform.open_effect(host.platform.context, account, locator, request, reply)
}

// Trusts an earlier shared controller as well as the current one, for
// collections published before the controller changed. Call before
// AppHostStart; only explicitly reviewed controller digests are accepted.
AppHostTrustHarness :: (host: *AppHost, digest: string) -> bool {
    if !AppDigestValid(digest) { return false }
    for index: 0..APP_HOST_PREVIOUS_CONTROLLERS - 1 {
        if TextUntilNul(host.harness_previous[index][:]) == digest { return true }
        if host.harness_previous[index][0] == 0 {
            return CopyCString(digest, host.harness_previous[index][:])
        }
    }
    return false
}

// authority/expected root identity/digest are verified installation inputs.
// This function never derives authority from a container manifest or a guest.
// A platform that has just hashed bytes itself passes verified and spares
// the second pass over the whole bundle.
AppHostStart :: (host: *AppHost, bytes: string, authority: string, id: string,
    expected_id: string, digest: string, account: string, platform: AppPlatform,
    harness_digest: string = "", locale: string = "en", protocol: s32 = APPS_CONTEXT_PROTOCOL,
    verified: bool = false, preparation: *AppPreparation = null) -> bool {
    if preparation != null {
        if !AppPreparationReady(preparation) || !preparation.valid ||
        preparation.bundle == null || TextUntilNul(preparation.digest[:]) != digest ||
        TextUntilNul(preparation.id[:]) != id || preparation.bytes.count != bytes.count {
            return false
        }
        source := cast(*TextDescriptor)(*bytes)
        prepared_source := cast(*TextDescriptor)(*preparation.bytes)
        if source.data != prepared_source.data {
            return false
        }
        verified = true
    }
    if host.tree.nodes.count != 0 || host.preparation != null || authority == "" || authority.count >= 256 || !Rules.AppIdValid(id) || !Rules.AppIdValid(expected_id) ||
    bytes.count + 65536 + cast(s64)size_of(AppNode) > APP_HOST_BYTE_LIMIT ||
    !AppDigestValid(digest) || (!verified && !AppHostBytesMatch(bytes, digest)) { return false }
    root := New(AppNode)
    if root == null { return false }
    unused CopyCString(authority, root.identity.authority[:])
    unused CopyCString(id, root.identity.id[:])
    unused CopyCString(digest, root.entry.sha256[:])
    unused CopyCString(expected_id, root.entry.expected_id[:])
    host.platform = platform
    if !CopyCString(harness_digest, host.harness_sha256[:]) || !CopyCString(locale, host.locale[:]) { free(root); return false }
    if protocol != APPS_CONTEXT_PROTOCOL && protocol != APPS_COLLECTION_PROTOCOL && protocol != APPS_NODE_PROTOCOL {
        free(root); return false
    }
    root.entry.protocol = protocol
    runtime := AppHostRuntime(host, root, bytes, TextUntilNul(root.entry.expected_id[:]), false, protocol, preparation)
    if runtime == null { free(root); return false }
    root.runtime = cast(*void)runtime
    root.bytes = bytes.count + 65536 + cast(s64)size_of(AppNode)
    manifest := HostedAppAsset(AppContextRuntime(*runtime.app), APPS_CATALOG_ASSET)
    root.collection = manifest.found
    provider := AppProvider.{.context = cast(*void)host, .open = AppHostOpen,
        .save = AppHostSave, .close = AppHostClose, .effect = AppHostEffect}
    if platform.version_effect != null { provider.version_effect = AppHostVersionEffect }
    if platform.open_effect != null { provider.open_effect = AppHostOpenEffect }
    if preparation != null { provider.prepare = AppHostPrepareChild }
    if (manifest.found && (!AppCatalogRead(manifest.data, id, *root.catalog) || !AppHostController(host, root, runtime, preparation))) ||
    !AppTreeStart(*host.tree, root, account, provider) {
        AppHostClose(cast(*void)host, root)
        AppCatalogClear(*root.catalog)
        free(root)
        AppHostCollect(host)
        return false
    }
    return true
}

// Preparation performs IO-independent hashing and portable verification only.
// This frame-boundary call still enforces the host's authority, controller
// trust, byte limit, capabilities and identity handshake. A successful start
// owns the opened programs; close the ready preparation record afterwards.
// Queued child requests then prepare on workers too. Native discovery uses
// AppHostOpenChild; favorites use AppHostOpenLocator. Direct tree calls remain synchronous.
AppHostStartPrepared :: (host: *AppHost, preparation: *AppPreparation,
    authority: string, id: string, expected_id: string, account: string,
    platform: AppPlatform, harness_digest: string = "", locale: string = "en",
    protocol: s32 = APPS_CONTEXT_PROTOCOL) -> bool {
    if preparation == null {
        return false
    }
    return AppHostStart(host, preparation.bytes, authority, id, expected_id,
        TextUntilNul(preparation.digest[:]), account, platform, harness_digest,
        locale, protocol, false, preparation)
}

AppHostStop :: (host: *AppHost) -> bool {
    AppHostCancelLocator(host)
    AppHostClearNavigation(host, false)
    // Like a failed save, an unfinished preparation leaves the whole tree
    // alive. The owner retains this host and retries; no frame waits here.
    if host.preparation != null {
        host.preparation_canceled = true
        if !AppHostClearPreparation(host) {
            return false
        }
    }
    if !AppTreeClose(*host.tree) { return false }
    AppHostCollect(host)
    AppFileFree(host.reply)
    AppFileFree(host.last_reply)
    host.reply = ""; host.last_reply = ""
    host.platform = AppPlatform.{}
    return true
}

// These fields only come from the trusted native provider, never the manifest.
AppHostVersions :: (bytes: *Vec(u8), state: *AppState, enabled: bool) {
    if state.actions_known {
        BuilderPrint(bytes, ",\"actions\":[")
        first := true
        names: [11]string = .["catalog", "open", "back", "install", "uninstall", "pin", "unpin", "install_to_launcher", "status", "update", "rollback"]
        for operation: cast(s32)2..11 {
            if operation == APPS_BACK || operation == APPS_STATUS ||
            (state.actions & (cast(u64)1 << cast(u64)operation)) == cast(u64)0 ||
            (AppsVersionOperation(operation) && !enabled) { continue }
            if !first { BuilderPrint(bytes, ",") }
            first = false
            AppsWriteQuoted(bytes, names[operation - 1])
        }
        BuilderPrint(bytes, "]")
    }
    BuilderPrint(bytes, ",\"current_version\":")
    AppsWriteQuoted(bytes, TextUntilNul(state.current_version[:]))
    available := enabled && state.update_available && AppVersionValid(TextUntilNul(state.available_version[:])) &&
    AppDigestValid(TextUntilNul(state.available_sha256[:]))
    BuilderPrint(bytes, ",\"update_available\":%", available)
    if available {
        BuilderPrint(bytes, ",\"available_version\":")
        AppsWriteQuoted(bytes, TextUntilNul(state.available_version[:]))
        BuilderPrint(bytes, ",\"available_sha256\":")
        AppsWriteQuoted(bytes, TextUntilNul(state.available_sha256[:]))
    }
    BuilderPrint(bytes, ",\"version_history\":[")
    first := true
    index: s32 = 0
    while enabled && index < state.history_count && index < 3 {
        version := *state.history[index]
        index += 1
        if !AppVersionValid(TextUntilNul(version.version[:])) || !AppDigestValid(TextUntilNul(version.sha256[:])) { continue }
        if !first { BuilderPrint(bytes, ",") }
        first = false
        BuilderPrint(bytes, "{\"version\":")
        AppsWriteQuoted(bytes, TextUntilNul(version.version[:]))
        BuilderPrint(bytes, ",\"sha256\":")
        AppsWriteQuoted(bytes, TextUntilNul(version.sha256[:]))
        BuilderPrint(bytes, "}")
    }
    BuilderPrint(bytes, "]")
}
