// Adapter for published node/2 bundles. The verified payload descriptor binds
// its legacy name to the stable app identity; callers cannot choose an owner.
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "std/c_string"
#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"
#import "kryon/hosted_app"
#import "kryon/hosted_values"
#import "kryon/app_context_host"
#import "kryon/app_files"
#import "kryon/widget_host"
#import "kryon/widget_codec"
#import "kryon/text_input_props"
#import, file "protocol.zi";
#import, file "node_types.zi";
#import, file "node_codec.zi";

using HostValueKind;

// The newest host interface a game may declare. Built with Ziran's compact
// saved IR (format 59), this host runs games that need Inner Breeze 2.1.61's
// host interface 41.
NODE_HOST_API :: 41

NodeContext :: struct {
    app: *HostedApp
    id: [128]u8
    name: [128]u8
    message: AppMessage
    frame: AppUiFrame
    message_codec: WidgetAppMessageCodec
    frame_codec: WidgetAppUiFrameCodec
    context: *void
    allows: AppServiceAllows
    services: HostCall
    widgets: HostCall
    translations: string
    identifying: bool
    received: bool
    succeeded: bool
    key: s32
    // Typing for the text field that has focus, as app/1 apps receive it.
    input: TextFieldInput
    input_codec: WidgetTextFieldInputCodec
}

NodeAllows :: (context: *void, module: string, name: string) -> bool {
    node := cast(*NodeContext)context
    return name == "ReadAppHost" || name == "WriteAppHost" || name == "ReadAppUiHost" ||
    name == "AppLocaleHost" || name == "AppKeyHost" || name == "AppSoundHost" ||
    name == "AppSupportsHost" || name == "AppServiceHost" || name == "AppFieldInputHost" ||
    WidgetHostSupports(module, name) ||
    (node.allows != null && node.allows(node.context, name))
}

// Apps ask for their labels every frame, and scanning the translations for
// each one cost a phone part of every frame. Each text is indexed once: the
// value of every "[key]" line is the lines after it up to the next "---"
// line, and the first entry of a key wins, as a scan would find it.
NodeLocaleEntry :: struct {
    hash: u64
    key_start: s64
    key_count: s64
    value_start: s64
    value_count: s64
}

NodeLocaleIndex :: struct {
    text: *u8
    count: s64
    fingerprint: u64
    entries: Vec(NodeLocaleEntry)
}

// The few translation texts in use at a time: an app's and its controller's.
node_locale_indexes: [4]NodeLocaleIndex;
node_locale_next: s32;

NodeLocaleHash :: (text: string) -> u64 {
    hash: u64 = cast(u64)2166136261
    for byte: text { hash = (hash ^ cast(u64)byte) * cast(u64)16777619 }
    return hash
}

// Translations are bundle assets that never change while open; the ends of
// the text also tell a later text at the same address apart.
NodeLocaleFingerprint :: (text: string) -> u64 {
    if text.count <= 128 { return NodeLocaleHash(text) }
    return NodeLocaleHash(text[0:64]) ^ (NodeLocaleHash(text[text.count - 64:text.count]) * cast(u64)31)
}

NodeLocaleBuild :: (index: *NodeLocaleIndex, text: string) {
    VecClear(index.entries)
    at: s64 = 0
    while at < text.count {
        end := at
        while end < text.count && text[end] != #char "\n" { end += 1 }
        if end - at >= 2 && text[at] == #char "[" && text[end - 1] == #char "]" {
            start := end + 1
            last := start
            while last < text.count {
                next := last
                while next < text.count && text[next] != #char "\n" { next += 1 }
                if text[last:next] == "---" {
                    finish := ifx last > start then last - 1 else last
                    entry := NodeLocaleEntry.{.hash = NodeLocaleHash(text[at + 1:end - 1]),
                        .key_start = at + 1, .key_count = end - at - 2,
                        .value_start = start, .value_count = finish - start}
                    unused VecPush(index.entries, entry)
                    break
                }
                last = next + 1
            }
        }
        at = end + 1
    }
}

NodeLocale :: (text: string, key: string) -> string {
    if text.count == 0 { return "" }
    descriptor := cast(*TextDescriptor)(*text)
    data := descriptor.data
    fingerprint := NodeLocaleFingerprint(text)
    index: *NodeLocaleIndex = null
    for slot: cast(s32)0..3 {
        cached := *node_locale_indexes[slot]
        if cached.text == data && cached.count == text.count && cached.fingerprint == fingerprint { index = cached }
    }
    if index == null {
        index = *node_locale_indexes[node_locale_next]
        node_locale_next = (node_locale_next + 1) % 4
        index.text = data
        index.count = text.count
        index.fingerprint = fingerprint
        NodeLocaleBuild(index, text)
    }
    hash := NodeLocaleHash(key)
    for at: cast(s64)0..index.entries.count - 1 {
        entry := index.entries[at]
        if entry.hash == hash && entry.key_count == key.count &&
        text[entry.key_start:entry.key_start + entry.key_count] == key {
            return text[entry.value_start:entry.value_start + entry.value_count]
        }
    }
    return ""
}

NodeCall :: (context: *void, module: *u8, function: *u8, arguments: *HostValue,
    count: s32, result: *HostValue) -> s32 {
    node := cast(*NodeContext)context
    name := TextFromCString(function)
    result.* = HostValue.{.kind = cast(s32)HostVoid, .type_name = HostTextData("void")}
    if name == "ReadAppHost" && count == 0 {
        message := ifx node.identifying then AppMessage.{.abi = MODULE_ABI} else node.message
        result.* = WidgetEncodeAppMessage(message, *node.message_codec)
        return 1
    }
    // Identification cannot read records, draw, or cause platform effects.
    if node.identifying { return 0 }
    if name == "WriteAppHost" && count == 1 && WidgetValidAppMessage(arguments[0]) {
        message := WidgetDecodeAppMessage(arguments[0], *node.message_codec)
        if message.abi != MODULE_ABI || node.received { return 0 }
        node.received = true
        node.succeeded = message.succeeded
        // Every other field remains a host input, including name/account.
        return 1
    }
    if name == "ReadAppUiHost" && count == 0 && node.message.action == APP_FRAME {
        result.* = WidgetEncodeAppUiFrame(node.frame, *node.frame_codec)
        return 1
    }
    if name == "AppLocaleHost" && count == 1 && HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := AppArgumentText(arguments[0])
        text := NodeLocale(node.translations, key)
        if text != "" {
            result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
                .data = HostTextData(text), .length = cast(usize)text.count}
            return 1
        }
        if node.services != null && node.allows != null && node.allows(node.context, name) {
            return node.services(node.context, module, function, arguments, count, result)
        }
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(key), .length = cast(usize)key.count}
        return 1
    }
    if name == "AppFieldInputHost" && count == 0 {
        input := ifx node.message.action == APP_FRAME then node.input else TextFieldInput.{}
        result.* = WidgetEncodeTextFieldInput(input, *node.input_codec)
        return 1
    }
    if name == "AppKeyHost" && count == 0 && node.message.action == APP_FRAME {
        result.* = HostScalar("s32", node.key)
        node.key = 0
        return 1
    }
    // An optional sound from the app's own packed assets. A host without
    // audio answers false, so no app fails to load or run over it.
    if name == "AppSoundHost" && count == 1 && HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        if node.message.action == APP_FRAME && node.services != null && node.allows != null &&
        node.allows(node.context, name) && node.services(node.context, module, function, arguments, count, result) == 1 {
            return 1
        }
        result.* = HostScalar("bool", 0)
        return 1
    }
    // Optional services, as for app/1: a host without the named service
    // answers that it is unavailable, so importing one never fails a start.
    if name == "AppSupportsHost" && count == 1 && HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        available := node.allows != null && node.allows(node.context, AppArgumentText(arguments[0]))
        result.* = HostScalar("bool", ifx available then 1 else 0)
        return 1
    }
    if name == "AppServiceHost" && count == 2 && HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostString) {
        if node.services != null && node.allows != null && node.allows(node.context, AppArgumentText(arguments[0])) {
            return node.services(node.context, module, function, arguments, count, result)
        }
        unavailable := "{\"status\":\"unavailable\"}"
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(unavailable), .length = cast(usize)unavailable.count}
        return 1
    }
    if WidgetHostSupports(TextFromCString(module), name) {
        if node.message.action != APP_FRAME || node.widgets == null { return 0 }
        return node.widgets(node.context, module, function, arguments, count, result)
    }
    if node.services != null && node.allows != null && node.allows(node.context, name) {
        return node.services(node.context, module, function, arguments, count, result)
    }
    return 0
}

NodeAssetsValid :: (node: *NodeContext, id: string, expected_id: string) -> bool {
    prefix_bytes: Vec(u8)
    BuilderPrint(*prefix_bytes, "assets/%/", expected_id)
    prefix := BuilderFinish(prefix_bytes)
    defer { AppFileFree(prefix) }
    // Inherited code libraries carry their own separately verified assets.
    // Only this package's own table is subject to its namespace here; reads
    // from other packages still require the catalog's explicit resource links.
    count := BundleOwnAssets(node.app.bundle)
    if count == cast(u64)0 || count > cast(u64)2048 { return false }
    total: u64 = 0
    for index: cast(u64)0..count - 1 {
        path := TextFromCString(BundleAssetPath(node.app.bundle, index))
        length := BundleAssetLength(node.app.bundle, index)
        if !AppAssetPathValid(path) || path.count <= prefix.count || path[:prefix.count] != prefix ||
        length > cast(u64)16777216 { return false }
        total += length
        if total > cast(u64)67108864 { return false }
    }
    path_bytes: Vec(u8)
    BuilderPrint(*path_bytes, "%catalog.json", prefix)
    path := BuilderFinish(path_bytes)
    manifest := HostedAppAsset(node.app, path)
    AppFileFree(path)
    if !manifest.found || manifest.data.count > 1048576 { return false }
    keys: [15]string = .["id", "name", "title", "kind", "contract_version", "module_api", "host_api", "save_schema",
    "harnesses", "entry", "source", "assets", "locales", "locale_prefix", "preview"]
    if Space(manifest.data, ValueEnd(manifest.data, 0, 0)) != manifest.data.count ||
    !AppsObjectValid(manifest.data, 0, keys[:]) { return false }
    actual_id: [128]u8
    actual_name: [128]u8
    if !AppsReadText(manifest.data, 0, "id", actual_id[:]) || TextUntilNul(actual_id[:]) != id ||
    !AppsReadText(manifest.data, 0, "name", actual_name[:]) || TextUntilNul(actual_name[:]) != expected_id { return false }
    contract := ReadNumber(manifest.data, FieldAt(manifest.data, 0, "contract_version"))
    module_api := ReadNumber(manifest.data, FieldAt(manifest.data, 0, "module_api"))
    host_api := ReadNumber(manifest.data, FieldAt(manifest.data, 0, "host_api"))
    save_schema := ReadNumber(manifest.data, FieldAt(manifest.data, 0, "save_schema"))
    if !contract.valid || contract.value != 1.0 || !module_api.valid || module_api.value != 2.0 ||
    !host_api.valid || host_api.value < 1.0 || host_api.value > cast(float64)NODE_HOST_API ||
    cast(float64)cast(s32)host_api.value != host_api.value ||
    !save_schema.valid || save_schema.value < 1.0 || save_schema.value > 2147483647.0 ||
    cast(float64)cast(s32)save_schema.value != save_schema.value { return false }
    read: bool
    write: bool
    frame: bool
    for index: cast(u64)0..BundleCapabilities(node.app.bundle) - cast(u64)1 {
        name := TextFromCString(BundleCapabilityFunctionName(node.app.bundle, index))
        read = read || name == "ReadAppHost"
        write = write || name == "WriteAppHost"
        frame = frame || name == "ReadAppUiHost"
    }
    return read && write && frame
}

NodeOpen :: (node: *NodeContext, bytes: string, id: string, expected_id: string) -> bool {
    if node.app == null || !CopyCString(id, node.id[:]) || !CopyCString(expected_id, node.name[:]) {
        return false
    }
    return HostedAppOpen(node.app, bytes) && NodeStart(node, id, expected_id)
}

// Bind and identify a program already opened by the portable verifier.
NodeStart :: (node: *NodeContext, id: string, expected_id: string) -> bool {
    if node.app == null || node.app.bundle == null || !CopyCString(id, node.id[:]) ||
    !CopyCString(expected_id, node.name[:]) || !NodeAssetsValid(node, id, expected_id) ||
    !HostedAppStart(node.app, NodeAllows, NodeCall, cast(*void)node) {
        return false
    }
    node.identifying = true
    answer: s64
    identified := HostedAppRun(node.app, *answer) && answer == MODULE_NODE_APP
    node.identifying = false
    return identified
}

NodeRun :: (node: *NodeContext, action: s32) -> bool {
    node.message.abi = MODULE_ABI
    node.message.name = TextUntilNul(node.name[:])
    node.message.action = action
    node.message.succeeded = false
    if node.message.locale == "" { node.message.locale = "en" }
    path_bytes: Vec(u8)
    BuilderPrint(*path_bytes, "assets/%/locales/%.txt", node.message.name, node.message.locale)
    path := BuilderFinish(path_bytes)
    translations := HostedAppAsset(node.app, path)
    AppFileFree(path)
    if !translations.found {
        fallback: Vec(u8)
        BuilderPrint(*fallback, "assets/%/locales/en.txt", node.message.name)
        path = BuilderFinish(fallback)
        translations = HostedAppAsset(node.app, path)
        AppFileFree(path)
    }
    node.translations = translations.data
    node.received = false
    node.succeeded = false
    answer: s64
    return HostedAppRun(node.app, *answer) && answer == 0 && node.received
}
